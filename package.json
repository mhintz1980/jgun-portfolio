{
  "name": "jgun-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D interactive mechanical-to-AI portfolio — JGun pneumatic torque wrench hero, R3F scroll rig, CAD dissolve shader, technical HUD.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:station2": "node scripts/check-station2-contract.mjs",
    "sync-assets": "powershell -ExecutionPolicy Bypass -File scripts/sync-assets.ps1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
