# Cloudflare Pages header policy (JG-019). Other hosts ignore this file.
# Hashed Vite output is immutable; named CAD assets and the OG image are
# stable-URL payloads, so they get a 24 h cache instead.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=86400

/draco/*
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
