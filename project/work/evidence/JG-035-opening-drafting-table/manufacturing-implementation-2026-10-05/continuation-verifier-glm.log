+// Wait until the live camera matrix is frame-stable, so baseline and post-restore
+// snapshots are compared settled-to-settled instead of mid-damping.
+async function settleCamera(page, stableFrames = 30) {
+  await page.evaluate(stableFrames => new Promise((resolve, reject) => {
+    const v = window.__shaftVerify
+    let stable = 0, prev = null, n = 0
+    function tick() {
+      const f = v.last
+      if (f) {
+        if (!prev) prev = f
+        else if (prev.frames !== f.frames) {
+          const delta = Math.max(...f.matrix.map((x, i) => Math.abs(x - prev.matrix[i])))
+          stable = delta <= 1e-12 ? stable + 1 : 0
+          prev = f
+        }
+        if (stable >= stableFrames) return resolve({ frames: f.frames })
+      }
+      if (++n > 3600) return reject(new Error('camera never settled'))
+      requestAnimationFrame(tick)
+    }
+    requestAnimationFrame(tick)
+  }), stableFrames)
