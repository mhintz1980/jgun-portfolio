          if (model.engaged >= 0) assertion(r, 'S2', uni.previousDepth >= 0 && uni.previousDepth <= uni.depth[model.engaged] + 1e-7, `shader mask depth ahead of leading face at ${t}: previous ${uni.previousDepth} vs stored ${uni.depth[model.engaged]}`, { file: 'src/scene/inspection/shaft/progression.ts', line: 133 })
          assertion(r, 'S2', s.teethPartial === partial && s.teethFormed === formed, `telemetry stock counts at ${t}: formed ${s.teethFormed}/${formed} partial ${s.teethPartial}/${partial}`, runtimeAnchor)
        }
        assertion(r, 'S2', s.teethFormed >= last, `teeth regression at ${t}: ${last} -> ${s.teethFormed}`, runtimeAnchor); last = s.teethFormed
