  { t: 14,   az: 24,                          el: 5,   dist: 0.26,   fovDesktop: 14.5, fovNarrow: 20,   tgt: [0, 6.5, 2.5] },
  { t: 15,   az: 20 - FOLLOW_AZIMUTH_MOD / DEG, el: 0.5, dist: 0.2,  fovDesktop: 7.2,  fovNarrow: 9.5,  tgt: [0, 19.2, 0], tgtNarrow: [0, 8.5, -2.8] },
  { t: 22.6, az: 20 - FOLLOW_AZIMUTH_MOD / DEG, el: 0.5, dist: 0.2,  fovDesktop: 7.2,  fovNarrow: 9.5,  tgt: [0, 19.2, 0], tgtNarrow: [0, 8.5, -2.8] },
