y). */\r\n  56| const GROOVE_WALL_Y_MM = 10.94\r\n  57| /** Certified stroke/edge relation: max centre + half thickness = last tooth material 9.8749 + overtravel 0.5. */\r\n  58| const MAX_EDGE_Y_MM = SHAPER_STROKE_CENTRE_Y_MAX_MM + SHAPER_THICKNESS_MM / 2\r\n  59| \r\n  60| const frame = createShaftKinematicsFrame()\r\n  61| const sample = (t: number) => sampleShaftKinematics(t, frame)\r\n  62| \r\n  63| describe('K1 machining-time map m(t)', () => {\r\n  64|   it('is monotonic and C1 across a dense 1/240 sweep', () => {\r\n  65|     const step = 1 / 240\r\n  66|     let prevM = machiningTimeAt(0)\r\n  67|     let maxJump = 0\r\n  68|     let maxSecondDiff = 0\r\n  69|     for (let t = step; t <= SHAFT_KINEMATICS_DURATION + step; t += step) {\r\n  70|       const m = machiningTimeAt(t)\r\n  71|       expect(m).toBeGreaterThanOrEqual(prevM - 1e-12)\r\n  72|       const d1 = m - prevM\r\n  73|       const rate = machiningRateAt(t - step / 2)\r\n  74|       maxSecondDiff = Math.max(maxSecondDiff, Math.abs(d1 - rate * step))\r\n  75|       maxJump = Math.max(maxJump, d1)\r\n  76|       prevM = m\r\n  77|     }\r\n  78|     expect(maxJump).toBeLessThanOrEqual(4 * step + 1e-12)\r\n  79|     // Rate is C0: the forward difference matches dm/dt to O(h^2).\r\n  80|     expect(maxSecondDiff).toBeLessThan(2e-4)\r\n  81|   })\r\n  82|   it('holds the authored speed structure: normal, slow, compressed recap, frozen gaps', () => {\r\n  83|     expect(machiningTimeAt(2)).toBe(0)\r\n  84|     // Eased startup 2..3 s (rate 0 -> 1, C1 at both ends): half a machining second is banked.\r\n  85|     expect(machiningTimeAt(3)).toBeCloseTo(0.5, 12)\r\n  86|     expect(machiningTimeAt(6)).toBeCloseTo(3.5, 12)\r\n  87|     expect(machiningRateAt(2)).toBe(0)\r\n  88|     expect(machiningRateAt(3)).toBe(1)\r\n  89|     expect(machiningRateAt(5)).toBe(1)\r\n  90|     expect(machiningRateAt(8.4)).toBeCloseTo(0.22, 12)\r\n  91|     expect(machiningRateAt(12)).toBe(4)\r\n  92|     // Stable slow action inside 6..11: the whole 7.2..9.6 window runs at the slow rate.\r\n  93|     for (let t = 7.2; t <= 9.6; t += 1 / 240) expect(machiningRateAt(t)).toBeCloseTo(0.22, 10)\r\n  94|     expect(9.6 - 7.2).toBeGreaterThanOrEqual(1.2)\r\n  95|     // Machining freezes outside its beats.\r\n  96|     expect(machiningTimeAt(20)).toBe(MACHINING_AT_SHAPING_END)\r\n  97|     expect(machiningTimeAt(24.6)).toBe(MACHINING_AT_SHAPING_END)\r\n  98|   })\r\n  99|   it('is C1 at every rate-segment boundary (one-sided straddling finite differences)', () => {\r\n 100|     // Catches the Sol review's 2.0 s kink: with a 0 -> 1 rate step there, the offset\r\n 101|     // one-sided derivatives differ by ~1.0 and the straddling central difference misses\r\n 102|     // dm/dt by ~0.5. Intervals sit a half-step off each side (never aligned to the boundary)\r\n 103|     // plus one interval straddling it. Tolerance 0.02; observed worst case 5.6e-3 at h = 1/48.\r\n 104|     expect(MACHINING_RATE_BOUNDARIES).toContain(2)\r\n 105|     for (const boundary of MACHINING_RATE_BOUNDARIES) {\r\n 106|       for (const h of [1 / 48, 1 / 96, 1 / 161]) {\r\n 107|         const left = (machiningTimeAt(boundary - 0.5 * h) - machiningTimeAt(boundary - 1.5 * h)) / h\r\n 108|         const right = (machiningTimeAt(boundary + 1.5 * h) - machiningTimeAt(boundary + 0.5 * h)) / h\r\n 109|         expect(Math.abs(right - left)).toBeLessThanOrEqual(0.02)\r\n 110|         const central = (machiningTimeAt(boundary + 0.5 * h) - machiningTimeAt(boundary - 0.5 * h)) / h\r\n 111|         expect(Math.abs(central - machiningRateAt(boundary))).toBeLessThanOrEqual(0.02)\r\n 112|       }\r\n 113|     }\r\n 114|   })\r\n 115|   it('places the exit stroke peak at the centre of the slow window', () => {\r\n 116|     expect(MACHINING_AT_SLOW_MID).toBeCloseTo(machiningTimeAt(7.2) + 0.22 * 1.2, 12)\r\n 117|     expect(strokePhaseAt(MACHINING_AT_SLOW_MID)).toBeCloseTo(0.5, 12)\r\n 118|     const atPeak = sample(8.4)\r\n 119|     expect(atPeak.strokeCentreY).toBeCloseTo(SHAPER_STROKE_CENTRE_Y_MAX_MM, 9)\r\n 120|     expect(atPeak.edgeY).toBeCloseTo(MAX_EDGE_Y_MM, 9)\r\n 121|     expect(STROKE_PHASE_OFFSET).toBeGreaterThan(0)\r\n 122|     expect(STROKE_PERIOD_M).toBe(0.8)\r\n 123|   })\r\n 124| })\r\n 125| \r\n 126| describe('K8 follow azimuth integral', () => {\r\n 127|   const law = (t: number) => FOLLOW_GAIN * followWeightAt(t) * machiningRateAt(t)\r\n 128| \r\n 129|   it('integrates the eased startup exactly instead of the retired linear ramp', () => {\r\n 130|     // Sol re-review regression: the retired followMfAt banked a full machining second by\r\n 131|     // 3 s (psi rate pi/8 at 2.5 s vs the documented law pi/16), overshooting the follow\r\n 132|     // azimuth by 11.25 deg from 3 s onward. The eased segment integrates to 0.5 exactly.\r\n 133|     expect(followMfAt(2)).toBe(0)\r\n 134|     expect(followMfAt(3)).toBeCloseTo(0.5, 12)\r\n 135|     expect(followMfAt(6)).toBeCloseTo(3.5, 12)\r\n 136|     // Weight is 1 across the whole 2..6 s window: mf is exactly the machining time there.\r\n 137|     for (let t = 2; t <= 6; t += 1 / 48) expect(followMfAt(t)).toBeCloseTo(machiningTimeAt(t), 12)\r\n 138|     expect(FOLLOW_GAIN * (followMfAt(6) - followMfAt(2))).toBeCloseTo((7 * Math.PI) / 16, 12)\r\n 139|   })\r\n 140| \r\n 141|   it('has d(psi)/dt = FOLLOW_GAIN * followWeight * machiningRate across 2..15 s', () => {\r\n 142|     // Central finite differences of the follow azimuth vs the documented law on a 1/240\r\n 143|     // grid with half-step h = 1/480. psi is C2 (weight and rate are both C1), so the error\r\n 144|     // stays O(h^2) even across joints: observed worst 6.8e-6 rad/s, tolerance 0.005. The\r\n 145|     // retired linear startup fails this by ~0.196 rad/s throughout 2..3 s.\r\n 146|     const h = 1 / 480\r\n 147|     for (let i = 0; i <= 13 * 240; i++) {\r\n 148|       const t = 2 + i / 240\r\n 149|       const central = (FOLLOW_GAIN * followMfAt(t + h) - FOLLOW_GAIN * followMfAt(t - h)) / (2 * h)\r\n 150|       expect(Math.abs(central - law(t))).toBeLessThanOrEqual(0.005)\r\n 151|     }\r\n 152|   })\r\n 153| \r\n 154|   it('matches the law through straddling intervals at every rate/weight boundary in 2..15 s', () => {\r\n 155|     const boundaries = [...new Set([...MACHINING_RATE_BOUNDARIES.filter((b) => b >= 2 && b <= 15), 12])].sort((a, b) => a - b)\r\n 156|     expect(boundaries).toEqual([2, 3, 6, 7.2, 9.6, 11, 12, 14, 15])\r\n 157|     // Half-step-offset one-sided intervals (never crossing the boundary) plus one interval\r\n 158|     // straddling it; observed worst 1.7e-4 rad/s, tolerance 0.005. 12 is the follow-weight\r\n 159|     // C1 joint that the rate-boundary list does not contain.\r\n 160|     for (const b of boundaries) {\r\n 161|       for (const h of [1 / 48, 1 / 96, 1 / 161]) {\r\n 162|         const left = (FOLLOW_GAIN * followMfAt(b - 0.5 * h) - FOLLOW_GAIN * followMfAt(b - 1.5 * h)) / h\r\n 163|         const right = (FOLLOW_GAIN * followMfAt(b + 1.5 * h) - FOLLOW_GAIN * followMfAt(b + 0.5 * h)) / h\r\n 164|         expect(Math.abs(left - law(b - h))).toBeLessThanOrEqual(0.005)\r\n 165|         expect(Math.abs(right - law(b + h))).toBeLessThanOrEqual(0.005)\r\n 166|         const central = (FOLLOW_GAIN * followMfAt(b + 0.5 * h) - FOLLOW_GAIN * followMfAt(b - 0.5 * h)) / h\r\n 167|         expect(Math.abs(central - law(b))).toBeLessThanOrEqual(0.005)\r\n 168|       }\r\n 169|     }\r\n 170|   })\r\n 171| \r\n 172|   it('keeps FOLLOW_MF_TOTAL equal to the law integral over the timeline', () => {\r\n 173|     // Trapezoid at 1/960 over [2, 15] (the law is identically 0 outside); the C2 integrand\r\n 174|     // puts the quadrature error near 1e-14. New total = 3.5 + 0.479657... + 2 + 8 + 2.\r\n 175|     const step = 1 / 960\r\n 176|     const n = 13 * 960\r\n 177|     let sum = 0\r\n 178|     for (let i = 0; i <= n; i++) {\r\n 179|       const t = 2 + i * step\r\n 180|       sum += (i === 0 || i === n ? 0.5 : 1) * followWeightAt(t) * machiningRateAt(t) * step\r\n 181|     }\r\n 182|     expect(sum).toBeCloseTo(FOLLOW_MF_TOTAL, 6)\r\n 183|     expect(FOLLOW_MF_TOTAL).toBeCloseTo(15.979657142857143, 12)\r\n 184|     // G * total now stays below 2 pi, so FOLLOW_AZIMUTH_MOD (camera.ts) no longer wraps.\r\n 185|     expect(FOLLOW_GAIN * FOLLOW_MF_TOTAL).toBeLessThan(2 * Math.PI)\r\n 186|   })\r\n 187| })\r\n 188| \r\n 189| describe('K2 shaper kinematics', () => {\r\n 190|   it('drives the work at the certified signed ratio work/cutter = -2', () => {\r\n 191|     for (const t of [2.5, 4, 6.5, 8.4, 10, 12.5, 14.9]) {\r\n 192|       const f = sample(t)\r\n 193|       expect(f.workPhi).toBeCloseTo(SHAPER_SIGNED_RATIO * f.cutterPhi, 12)\r\n 194|     }\r\n 195|   })\r\n 196|   it('has ~0 signed pitch-point relative velocity (recorded tolerance)', () => {\r\n 197|     // tool-conventions pitch circles: work r = 5 mm, cutter r = 10 mm, contact at work +Z.\r\n 198|     const vRel = 5 * WORK_RATE + 10 * CUTTER_RATE\r\n 199|     expect(Math.abs(vRel)).toBeLessThanOrEqual(1e-12)\r\n 200|   })\r\n 201|   it('keeps the stroke between the certified centre limits and the edge inside the groove', () => {\r\n 202|     let maxEdge = 0\r\n 203|     for (let t = 2; t <= 15; t += 1 / 240) {\r\n 204|       const f = sample(t)\r\n 205|       expect(f.strokeCentreY).toBeGreaterThanOrEqual(SHAPER_STROKE_CENTRE_Y_MIN_MM - 1e-9)\r\n 206|       expect(f.strokeCentreY).toBeLessThanOrEqual(SHAPER_STROKE_CENTRE_Y_MAX_MM + 1e-9)\r\n 207|       expect(f.edgeY).toBeCloseTo(f.strokeCentreY + SHAPER_THICKNESS_MM / 2, 12)\r\n 208|       maxEdge = Math.max(maxEdge, f.edgeY)\r\n 209|     }\r\n 210|     expect(maxEdge).toBeCloseTo(MAX_EDGE_Y_MM, 9)\r\n 211|     // Certified axial room to the groove wall: 0.565 mm.\r\n 212|     expect(GROOVE_WALL_Y_MM - maxEdge).toBeGreaterThanOrEqual(0.565 - 1e-9)\r\n 213|   })\r\n 214|   it('feeds radially to full depth during the first quarter orbit, then holds', () => {\r\n 215|     expect(infeedRhoAt(0)).toBe(SHAFT_OD_MM)\r\n 216|     expect(infeedRhoAt(0.5)).toBeGreaterThan(SHAFT_ROOT_MM)\r\n 217|     expect(infeedRhoAt(1)).toBeCloseTo(SHAFT_ROOT_MM + 0.005, 12)\r\n 218|     expect(infeedRhoAt(5)).toBeCloseTo(SHAFT_ROOT_MM + 0.005, 12)\r\n 219|     expect(infeedRhoAt(12)).toBeCloseTo(SHAFT_ROOT_MM + 0.005, 12)\r\n 220|   })\r\n 221|   it('relieves the return by the full 2.0 mm with an unmistakable >= 0.4 s clear hold', () => {\r\n 222|     // m = 0.1 sits in the cutting half (phase 0.38): no backoff while cutting.\r\n 223|     expect(backoffAt(0.1)).toBe(0)\r\n 224|     let clearStart = -1\r\n 225|     let clearSpan = 0\r\n 226|     for (let t = 7.2; t <= 9.6; t += 1 / 240) {\r\n 227|       const f = sample(t)\r\n 228|       if (f.strokePhase < 0.5) expect(f.backoff).toBe(0)\r\n 229|       if (f.backoff >= 2 * 0.999) {\r\n 230|         if (clearStart < 0) clearStart = t\r\n 231|         clearSpan = t - clearStart\r\n 232|       }\r\n 233|     }\r\n 234|     expect(clearSpan).toBeGreaterThanOrEqual(0.4)\r\n 235|   })\r\n 236|   it('derives every space depth from cutting contact events (independent numerical oracle)', () => {\r\n 237|     const crossings: number[][] = []\r\n 238|     for (let i = 0; i < SHAFT_SPACES; i++) {\r\n 239|       let c = (SPACE_CLOCK_RAD + i * SPACE_PITCH_RAD - Math.PI / 2) / -WORK_RATE\r\n 240|       c -= Math.floor(c / 2) * 2\r\n 241|       const list: number[] = []\r\n 242|       for (let k = 0; k < 16; k++) {\r\n 243|         const m = c + 2 * k\r\n 244|         if (strokePhaseAt(m) >= 0.5) continue\r\n 245|         // Independent contact solve: retain the nearest-space interval, find where the\r\n 246|         // certified cosine stroke first enters the material face, not the old angular\r\n 247|         // centre alone. No producer event table or stock-phase constant is imported.\r\n 248|         const edge = (x: number) => SHAPER_STROKE_CENTRE_Y_MIN_MM\r\n 249|           + (SHAPER_STROKE_CENTRE_Y_MAX_MM - SHAPER_STROKE_CENTRE_Y_MIN_MM)\r\n 250|           * (1 - Math.cos(2 * Math.PI * (x / STROKE_PERIOD_M + STROKE_PHASE_OFFSET))) / 2\r\n 251|           + SHAPER_THICKNESS_MM / 2\r\n 252|         let event = m\r\n 253|         if (edge(m) < FACE_START_MM) {\r\n 254|           let lo = m, hi = m + 0.1\r\n 255|           for (let j = 0; j < 60; j++) {\r\n 256|             const mid = (lo + hi) / 2\r\n 257|             if (edge(mid) < FACE_START_MM) lo = mid; else hi = mid\r\n 258|           }\r\n 259|           event = (lo + hi) / 2\r\n 260|         } else if (edge(m) > SHAPING_FACE_END_MM) {\r\n 261|           let lo = m - 0.1, hi = m\r\n 262|           for (let j = 0; j < 60; j++) {\r\n 263|             const mid = (lo + hi) / 2\r\n 264|             if (edge(mid) < SHAPING_FACE_END_MM) lo = mid; else hi = mid\r\n 265|           }\r\n 266|           event = (lo + hi) / 2\r\n 267|         }\r\n 268|         expect(Math.abs(event - m)).toBeLessThan(0.1)\r\n 269|         list.push(event)\r\n 270|       }\r\n 271|       crossings.push(list)\r\n 272|     }\r\n 273|     for (let t = 2; t <= 15; t += 1 / 24) {\r\n 274|       const m = machiningTimeAt(t)\r\n 275|       const f = sample(t)\r\n 276|       for (let i = 0; i < SHAFT_SPACES; i++) {\r\n 277|         let counted = 0\r\n 278|         for (const mK of crossings[i]) if (mK <= m) counted++\r\n 279|         expect(countedPasses(m, i)).toBe(counted)\r\n 280|         expect(f.spaceDepth[i]).toBeCloseTo(Math.min(1, counted / SPACE_PASSES_REQUIRED), 9)\r\n 281|       }\r\n 282|     }\r\n 283|   })\r\n 284|   it('does not advance stock before face contact or during wholly disengaged intervals (dense causal sweep)', () => {\r\n 285|     for (const t of [2.5, 2.512274, 2.52, 2.55]) {\r\n 286|       const f = sample(t)\r\n 287|       expect(f.edgeY).toBeLessThan(FACE_START_MM)\r\n 288|       expect(f.engagedSpace).toBe(-1)\r\n 289|       expect([...f.spaceDepth]).toEqual(Array(SHAFT_SPACES).fill(0))\r\n 290|     }\r\n 291|     const priorDepth = new Float32Array(SHAFT_SPACES)\r\n 292|     const state = createProgressionState()\r\n 293|     let gains = 0, whollyDisengaged = 0, returnPartial = 0, completion = 0\r\n 294|     let contactFailures = 0, nearestFailures = 0, retainedFailures = 0, previousDepthFailures = 0, aheadMaskFailures = 0\r\n 295|     let priorDisengaged = true\r\n 296|     const firstCompletion = Array(SHAFT_SPACES).fill(-1) as number[]\r\n 297|     const step = 1 / 4800\r\n 298|     for (let tick = 0; tick <= 13 * 4800; tick++) {\r\n 299|       const t = 2 + tick * step, f = sample(t)\r\n 300|       const cutting = f.strokePhase < 0.5\r\n 301|       const contact = cutting && f.edgeY >= FACE_START_MM && f.edgeY <= SHAPING_FACE_END_MM\r\n 302|         && f.cutterRho < SHAFT_OD_MM - 1e-3\r\n 303|       if ((f.engagedSpace >= 0) !== (contact && t < 15)) contactFailures++\r\n 304|       const disengaged = f.engagedSpace < 0\r\n 305|       for (let space = 0; space < SHAFT_SPACES; space++) {\r\n 306|         const depth = f.spaceDepth[space]\r\n 307|         if (depth > priorDepth[space]) {\r\n 308|           gains++\r\n 309|           if (!contact) contactFailures++\r\n 310|           const raw = Math.round((Math.PI / 2 - SPACE_CLOCK_RAD - SHAPER_SIGNED_RATIO * f.cutterPhi) / SPACE_PITCH_RAD)\r\n 311|           const nearest = ((raw % SHAFT_SPACES) + SHAFT_SPACES) % SHAFT_SPACES\r\n 312|           if (nearest !== space || f.engagedSpace !== space) nearestFailures++\r\n 313|         }\r\n 314|         if (disengaged && priorDisengaged && depth !== priorDepth[space]) retainedFailures++\r\n 315|         if (depth === 1 && firstCompletion[space] < 0) firstCompletion[space] = t\r\n 316|         priorDepth[space] = depth\r\n 317|       }\r\n 318|       if (disengaged && priorDisengaged) whollyDisengaged++\r\n 319|       if (!cutting && f.spaceDepth.some(d => d > 0 && d < 1)) returnPartial++\r\n 320|       if (f.spaceDepth.every(d => d === 1) && completion === 0) completion = t\r\n 321|       writeShaftProgression(f, state)\r\n 322|       if (contact && t < 15) {\r\n 323|         // Ahead of the leading face, the CPU/shader writer keeps prior event depth;\r\n 324|         // it never drops farther back than one pass or fabricates a new ahead-edge cut.\r\n 325|         const space = f.engagedSpace\r\n 326|         if ((state.engagedPreviousDepth ?? 0) > f.spaceDepth[space]\r\n 327|           || f.spaceDepth[space] - (state.engagedPreviousDepth ?? 0) > 1 / SPACE_PASSES_REQUIRED) previousDepthFailures++\r\n 328|         const y = (f.edgeY + SHAPING_FACE_END_MM) / 2\r\n 329|         const radius = progressedRadius(SHAFT_ROOT_MM, y, SPACE_CLOCK_RAD + space * SPACE_PITCH_RAD, state, 'legacy')\r\n 330|         if (Math.abs((SHAFT_OD_MM - radius) / (SHAFT_OD_MM - SHAFT_ROOT_MM) - (state.engagedPreviousDepth ?? 0)) >= 0.5e-12) aheadMaskFailures++\r\n 331|       }\r\n 332|       priorDisengaged = disengaged\r\n 333|     }\r\n 334|     expect(gains).toBe(SHAFT_SPACES * SPACE_PASSES_REQUIRED)\r\n 335|     expect({ contactFailures, nearestFailures, retainedFailures, previousDepthFailures, aheadMaskFailures })\r\n 336|       .toEqual({ contactFailures: 0, nearestFailures: 0, retainedFailures: 0, previousDepthFailures: 0, aheadMaskFailures: 0 })\r\n 337|     expect(whollyDisengaged).toBeGreaterThan(10000)\r\n 338|     expect(returnPartial).toBeGreaterThan(0)\r\n 339|     expect(completion).toBeGreaterThan(11)\r\n 340|     expect(completion).toBeLessThan(15)\r\n 341|     expect(firstCompletion.every(t => t > 11 && t < 15)).toBe(true)\r\n 342|   })\r\n 343|   it('completes all ten spaces inside the recap and none before engagement', () => {\r\n 344|     let firstComplete = -1\r\n 345|     const prev = new Float32Array(SHAFT_SPACES)\r\n 346|     for (let t = 2; t <= 15; t += 1 / 240) {\r\n 347|       const f = sample(t)\r\n 348|       let all = true\r\n 349|       for (let i = 0; i < SHAFT_SPACES; i++) {\r\n 350|         expect(f.spaceDepth[i]).toBeGreaterThanOrEqual(prev[i] - 1e-12)\r\n 351|         expect(f.spaceDepth[i]).toBeLessThanOrEqual(1)\r\n 352|         prev[i] = f.spaceDepth[i]\r\n 353|         if (f.spaceDepth[i] < 1 - 1e-12) all = false\r\n 354|       }\r\n 355|       if (all && firstComplete < 0) firstComplete = t\r\n 356|     }\r\n 357|     expect(firstComplete).toBeGreaterThan(11)\r\n 358|     expect(firstComplete).toBeLessThan(15)\r\n 359|     const atRecapStart = sample(11)\r\n 360|     let remaining = 0\r\n 361|     for (let i = 0; i < SHAFT_SPACES; i++) if (atRecapStart.spaceDepth[i] < 1 - 1e-12) remaining++\r\n 362|     expect(remaining).toBe(SHAFT_SPACES)\r\n 363|   })\r\n 364|   it('exposes engagedSpace/edgeY consistent with progression.ts semantics', () => {\r\n 365|     const state = createProgressionState()\r\n 366|     for (const t of [3.5, 8.4, 13.2]) {\r\n 367|       const f = sample(t)\r\n 368|       if (f.engagedSpace >= 0) {\r\n 369|         expect(f.mode).toBe('shaping')\r\n 370|         expect(f.cutting).toBe(true)\r\n 371|         expect(f.edgeY).toBeGreaterThanOrEqual(FACE_START_MM)\r\n 372|       }\r\n 373|       writeShaftProgression(f, state)\r\n 374|       expect(state.mode).toBe(f.mode)\r\n 375|       expect(state.engagedSpace).toBe(f.engagedSpace)\r\n 376|       expect(state.edgeY).toBe(f.edgeY)\r\n 377|       expect(state.hobYc).toBe(f.hobYc)\r\n 378|       expect(state.hobA).toBe(f.hobA)\r\n 379|       expect(state.hobR).toBe(f.hobR)\r\n 380|       for (let i = 0; i < SHAFT_SPACES; i++) expect(state.spaceDepth[i]).toBe(f.spaceDepth[i])\r\n 381|     }\r\n 382|   })\r\n 383| })\r\n 384| \r\n 385| describe('K3 hob kinematics', () => {\r\n 386|   it('follows the certified path: infeed yc, feed to stop, retract 2.5 mm, withdraw', () => {\r\n 387|     expect(sample(24.9).hobYc).toBe(HOB_INFEED_YC_MM)\r\n 388|     expect(sample(25).hobYc).toBe(HOB_INFEED_YC_MM)\r\n 389|     expect(sample(30.2).hobYc).toBeCloseTo(HOB_STOP_YC_MM, 12)\r\n 390|     let prevYc = -Infinity\r\n 391|     for (let t = 25.7; t <= 30.2; t += 1 / 240) {\r\n 392|       const f = sample(t)\r\n 393|       expect(f.hobYc).toBeGreaterThan(prevYc)\r\n 394|       expect(f.hobToolA).toBeCloseTo(10.1618, 9)\r\n 395|       prevYc = f.hobYc\r\n 396|     }\r\n 397|     expect(sample(31).hobToolA).toBeCloseTo(10.1618 + 2.5, 9)\r\n 398|   })\r\n 399|   it('is clear and out of the runout view by 32.0 s', () => {\r\n 400|     const f = sample(32)\r\n 401|     const radialClearance = f.hobToolA - HOB_RADIUS_MM - SHAFT_OD_MM\r\n 402|     expect(radialClearance).toBeGreaterThanOrEqual(0.5)\r\n 403|     expect(hobEnvelopeTopY(f.hobYc)).toBeLessThanOrEqual(FACE_START_MM - 0.5)\r\n 404|     expect(f.hobYc).toBeLessThan(HOB_INFEED_YC_MM)\r\n 405|   })\r\n 406|   it('couples the work at -phi_h / 10 (single start, ten teeth) and never reverses', () => {\r\n 407|     let prevPhi = 0\r\n 408|     let prevWork = 0\r\n 409|     for (let t = 25; t <= 32; t += 1 / 30) {\r\n 410|       const f = sample(t)\r\n 411|       expect(f.hobWorkPhi).toBeCloseTo(-f.hobPhi / 10, 12)\r\n 412|       expect(f.hobPhi).toBeGreaterThanOrEqual(prevPhi - 1e-12)\r\n 413|       expect(f.hobWorkPhi).toBeLessThanOrEqual(prevWork + 1e-12)\r\n 414|       prevPhi = f.hobPhi\r\n 415|       prevWork = f.hobWorkPhi\r\n 416|     }\r\n 417|   })\r\n 418| })\r\n 419| \r\n 420| describe('K4 chip and display-rate guard', () => {\r\n 421|   it('shows one restrained chip only while stock is removed, none during return', () => {\r\n 422|     for (let t = 2; t <= 15; t += 1 / 240) {\r\n 423|       const f = sample(t)\r\n 424|       if (!f.cutting || f.mode !== 'shaping' || f.edgeY > SHAPING_FACE_END_MM + SHAPER_OVERTRAVEL_MM) {\r\n 425|         expect(f.chipOpacity).toBe(0)\r\n 426|       }\r\n 427|       if (f.chipOpacity > 0) {\r\n 428|         expect(f.cutting).toBe(true)\r\n 429|         expect(Math.abs(f.chipX)).toBeLessThanOrEqual(CHIP_SEED * 0.4 + 0.6)\r\n 430|         expect(f.chipZ).toBeLessThanOrEqual(SHAFT_OD_MM + 1)\r\n 431|         expect(f.chipY).toBeCloseTo(f.edgeY, 12)\r\n 432|       }\r\n 433|     }\r\n 434|   })\r\n 435|   it('keeps stroke/gash display rates at or below 7.5 Hz unless softened', () => {\r\n 436|     let softenedInRecap = false\r\n 437|     for (let t = 0; t <= SHAFT_KINEMATICS_DURATION; t += 1 / 240) {\r\n 438|       const f = sample(t)\r\n 439|       const exceeds = f.strokeHz > SHAFT_MAX_FEATURE_HZ || f.gashHz > SHAFT_MAX_FEATURE_HZ\r\n 440|       expect(f.softened).toBe(exceeds)\r\n 441|       if (!f.softened) {\r\n 442|         expect(f.strokeHz).toBeLessThanOrEqual(SHAFT_MAX_FEATURE_HZ)\r\n 443|         expect(f.gashHz).toBeLessThanOrEqual(SHAFT_MAX_FEATURE_HZ)\r\n 444|       }\r\n 445|       if (t > 11.5 && t < 14.5 && f.softened) softenedInRecap = true\r\n 446|     }\r\n 447|     expect(softenedInRecap).toBe(true)\r\n 448|   })\r\n 449|   it('never reverses displayed rotation at the 30 fps lite floor', () => {\r\n 450|     let prevCutter = 0\r\n 451|     let prevWork = 0\r\n 452|     for (let t = 2; t <= 32; t += 1 / 30) {\r\n 453|       const f = sample(t)\r\n 454|       expect(f.cutterPhi).toBeGreaterThanOrEqual(prevCutter - 1e-12)\r\n 455|       expect(f.workPhi).toBeLessThanOrEqual(prevWork + 1e-12)\r\n 456|       prevCutter = f.cutterPhi\r\n 457|       prevWork = f.workPhi\r\n 458|     }\r\n 459|   })\r\n 460| })\r\n 461| \r\n 462| describe('determinism and purity', () => {\r\n 463|   it('is bit-identical under shuffled seeks and returns the caller-owned frame', () => {\r\n 464|     const a = createShaftKinematicsFrame()\r\n 465|     const b = createShaftKinematicsFrame()\r\n 466|     const times: number[] = []\r\n 467|     for (let i = 0; i < 600; i++) times.push(((i * 7919) % 10320) / 240)\r\n 468|     for (const t of times) sampleShaftKinematics(t, a)\r\n 469|     for (let i = times.length - 1; i >= 0; i--) sampleShaftKinematics(times[i], b)\r\n 470|     for (const t of times) {\r\n 471|       const fa = sampleShaftKinematics(t, a)\r\n 472|       const fb = sampleShaftKinematics(t, b)\r\n 473|       expect(fa).toBe(a)\r\n 474|       expect(fb).toBe(b)\r\n 475|       for (const key of Object.keys(fa) as (keyof typeof fa)[]) {\r\n 476|         if (key === 'spaceDepth' || key === 'mode' || key === 'cutting' || key === 'returning' || key === 'softened') continue\r\n 477|         expect(fa[key]).toBe(fb[key])\r\n 478|       }\r\n 479|       for (let i = 0; i < SHAFT_SPACES; i++) expect(fa.spaceDepth[i]).toBe(fb.spaceDepth[i])\r\n 480|     }\r\n 481|   })\r\n 482|   it('keeps every numeric field finite across the timeline', () => {\r\n 483|     for (let t = 0; t <= SHAFT_KINEMATICS_DURATION; t += 1 / 24) {\r\n 484|       const f = sample(t)\r\n 485|       expect(Number.isFinite(f.machining)).toBe(true)\r\n 486|       expect(Number.isFinite(f.followAzimuth)).toBe(true)\r\n 487|       expect(Number.isFinite(f.cutterPhi)).toBe(true)\r\n 488|       expect(Number.isFinite(f.hobYc)).toBe(true)\r\n 489|       expect(Number.isFinite(f.chipX)).toBe(true)\r\n 490|       expect(Number.isFinite(f.strokeHz)).toBe(true)\r\n 491|       for (let i = 0; i < SHAFT_SPACES; i++) expect(Number.isFinite(f.spaceDepth[i])).toBe(true)\r\n 492|     }\r\n 493|   })\r\n 494| })\r\n 495| \r\n 496| describe('R8 progression review regressions', () => {\r\n 497|   it('retains prior depth ahead of the edge on passes 2-4 across all ten spaces and both sides of crossings', () => {\r\n 498|     const f = createShaftKinematicsFrame(), state = createProgressionState(), uniforms = createProgressionUniforms()\r\n 499|     const covered = new Set<string>()\r\n 500|     const sides = new Set<number>()\r\n 501|     for (let space = 0; space < SHAFT_SPACES; space++) {\r\n 502|       let first = (SPACE_CLOCK_RAD + space * SPACE_PITCH_RAD - Math.PI / 2) / -WORK_RATE\r\n 503|       first -= Math.floor(first / 2) * 2\r\n 504|       let pass = 0\r\n 505|       for (let crossing = first; crossing <= MACHINING_AT_SHAPING_END; crossing += 2) {\r\n 506|         if (strokePhaseAt(