e completed swept hob envelope in the shared writer while the tool retracts and withdraws', () => {\r\n 541|     const f = createShaftKinematicsFrame(), state = createProgressionState()\r\n 542|     writeShaftProgression(sampleShaftKinematics(30.2, f), state)\r\n 543|     const radii = Array.from({ length: 101 }, (_, i) => progressedRadius(SHAFT_ROOT_MM,\r\n 544|       FACE_START_MM + (HOBBING_FACE_END_MM - FACE_START_MM) * i / 100, 0, state, 'approved'))\r\n 545|     for (const t of [31.999, 30.2, 31.2, 30.8, 31.8, 31, 30.2]) {\r\n 546|       writeShaftProgression(sampleShaftKinematics(t, f), state)\r\n 547|       expect(state.hobYc).toBe(HOB_STOP_YC_MM)\r\n","exit_code":0,"status":"completed"}}
