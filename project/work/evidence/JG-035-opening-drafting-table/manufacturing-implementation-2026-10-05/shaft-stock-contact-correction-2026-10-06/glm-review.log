{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath '\"'src/scene/inspection/shaft/progression.ts' | ForEach-Object { \"'$i++; '\"'{0,4}| {1}' -f \"'$i, $_ }'","aggregated_output":"   1| /**\r\n   2|  * JG-035 shaft tooling leaf: closed-form machining progression.\r\n   3|  *\r\n   4|  * Turns the finished CAD shaft meshes into blank / partial / finished states without CSG.\r\n   5|  * Everything is a pure function of the state passed in: no accumulators, no clocks, no\r\n   6|  * randomness, and no allocation in per-frame paths. The same law runs on the CPU\r\n   7|  * (progressedRadius) and on the GPU (applyProgression -> onBeforeCompile), so seek order\r\n   8|  * cannot diverge.\r\n   9|  *\r\n  10|  * Frame: shaft-local millimetres, +Y is the shaft axis (CAD). The runtime loader performs\r\n  11|  * exactly one conversion (shaft-local +Y -> glTF -Z); the object-to-shaft matrix handed to\r\n  12|  * applyProgression maps render-object space back to shaft-local mm, once.\r\n  13|  */\r\n  14| import { Matrix3, Matrix4 } from 'three'\r\n  15| import type { IUniform, Material, MeshPhysicalMaterial, MeshStandardMaterial } from 'three'\r\n  16| \r\n  17| export type ProgressionMode = 'none' | 'shaping' | 'hobbing'\r\n  18| export type ProgressionShaft = 'legacy' | 'approved'\r\n  19| \r\n  20| export interface ProgressionState {\r\n  21|   mode: ProgressionMode\r\n  22|   /** Per tooth-space depth in [0, 1]; 0 = uncut blank stock, 1 = finished tooth space. */\r\n  23|   spaceDepth: Float32Array\r\n  24|   /** Tooth-space index currently engaged by the cutter, or -1. */\r\n  25|   engagedSpace: number\r\n  26|   /** Depth before the engaged stroke; omitted means a first pass from the uncut blank. */\r\n  27|   engagedPreviousDepth?: number\r\n  28|   /** Cutter leading-face y (mm) during the current stroke; material behind it carries the new depth. */\r\n  29|   edgeY: number\r\n  30|   /** Hob axial centre y (mm). */\r\n  31|   hobYc: number\r\n  32|   /** Hob centre distance (mm). */\r\n  33|   hobA: number\r\n  34|   /** Hob envelope radius (mm). */\r\n  35|   hobR: number\r\n  36| }\r\n  37| \r\n  38| export interface StressOverlay {\r\n  39|   kind: 'none' | 'warm' | 'cool'\r\n  40|   mix: number\r\n  41|   scanProgress: number\r\n  42|   yMin: number\r\n  43|   yMax: number\r\n  44|   rMax: number\r\n  45| }\r\n  46| \r\n  47| // ---- measured shaft geometry (camera/clearance-v4/report.json facts) ----\r\n  48| export const SHAFT_SPACES = 10\r\n  49| export const SPACE_PITCH_RAD = (Math.PI * 2) / SHAFT_SPACES\r\n  50| /**\r\n  51|  * Azimuth (rad, shaft-local) of the centre of tooth space 0. Recovered by\r\n  52|  * progression.test.ts from profile-study.json legacy 6.0 polar data: the 10 tooth-tip\r\n  53|  * centroids sit at 18 deg + 36 deg k, so the space centres sit at 0 + 36 deg k.\r\n  54|  */\r\n  55| export const SPACE_CLOCK_RAD = 0\r\n  56| /** Tooth tip radius = measured OD of the legacy face band. */\r\n  57| export const SHAFT_OD_MM = 6.083507443359969\r\n  58| /** Tooth-space floor radius = measured root of the approved face band. */\r\n  59| export const SHAFT_ROOT_MM = 4.29182859636582\r\n  60| /** First tooth-space material y (legacy pilot end). */\r\n  61| export const FACE_START_MM = 3.1749\r\n  62| /** Legacy last tooth material y: the shaping band ends here. */\r\n  63| export const SHAPING_FACE_END_MM = 9.875\r\n  64| /** Approved ramp end y: the hobbing band ends here. */\r\n  65| export const HOBBING_FACE_END_MM = 13.78\r\n  66| \r\n  67| // ---- certified hob tool (report.hob) vs the equivalent meridian floor ----\r\n  68| export const HOB_CERTIFIED_R_MM = 5.87\r\n  69| export const HOB_CERTIFIED_LEAD_ANGLE_DEG = 5.5587\r\n  70| /**\r\n  71|  * Visual floor: the authored untilted circle R = 6.0 with centre at root + 6.0.\r\n  72|  * The certified tool is R 5.87 tilted to its lead angle; its equivalent meridian floor\r\n  73|  * (clearance-v4 ramp fit, max deviation 0.0049 mm) is this untilted circle, so the final\r\n  74|  * hobbing state equals the approved mesh.\r\n  75|  */\r\n  76| export const HOB_VISUAL_R_MM = 6.0\r\n  77| export const HOB_VISUAL_A_MM = SHAFT_ROOT_MM + HOB_VISUAL_R_MM\r\n  78| export const HOB_FINAL_YC_MM = 9.5249\r\n  79| export const HOB_INFEED_YC_MM = -4.195\r\n  80| export const HOB_RETRACT_MM = 2.5\r\n  81| \r\n  82| export function createProgressionState(): ProgressionState {\r\n  83|   return {\r\n  84|     mode: 'none',\r\n  85|     spaceDepth: new Float32Array(SHAFT_SPACES),\r\n  86|     engagedSpace: -1,\r\n  87|     edgeY: 0,\r\n  88|     hobYc: HOB_INFEED_YC_MM,\r\n  89|     hobA: HOB_VISUAL_A_MM,\r\n  90|     hobR: HOB_VISUAL_R_MM,\r\n  91|   }\r\n  92| }\r\n  93| \r\n  94| /** Nearest tooth-space index for a shaft-local azimuth (rad). Allocation-free. */\r\n  95| export function spaceIndexAt(azimuth: number): number {\r\n  96|   const raw = Math.round((azimuth - SPACE_CLOCK_RAD) / SPACE_PITCH_RAD) % SHAFT_SPACES\r\n  97|   const index = raw < 0 ? raw + SHAFT_SPACES : raw\r\n  98|   return index === 0 ? 0 : index\r\n  99| }\r\n 100| \r\n 101| /** Hobbing meridian floor radius (mm). Allocation-free. */\r\n 102| export function hobFloorRadius(y: number, hobYc: number, hobA: number, hobR: number): number {\r\n 103|   if (y <= hobYc) return SHAFT_ROOT_MM\r\n 104|   if (y < hobYc + hobR) {\r\n 105|     const dy = y - hobYc\r\n 106|     const r2 = hobR * hobR - dy * dy\r\n 107|     return hobA - Math.sqrt(r2 > 0 ? r2 : 0)\r\n 108|   }\r\n 109|   return SHAFT_OD_MM\r\n 110| }\r\n 111| \r\n 112| /**\r\n 113|  * CPU mirror of the vertex-shader law. Returns the progressed radius (mm) for a shaft-local\r\n 114|  * sample. Pure: depends only on its arguments and never writes to state.\r\n 115|  *\r\n 116|  * legacy shaping: only FACE_START <= y <= 9.875 with r < OD; r' = min(OD, r + (1 - depth_i)*(OD - ROOT)).\r\n 117|  * approved hobbing: only FACE_START <= y <= 13.78; r' = max(r, min(OD, floor(y))).\r\n 118|  */\r\n 119| export function progressedRadius(\r\n 120|   r: number,\r\n 121|   y: number,\r\n 122|   azimuth: number,\r\n 123|   state: ProgressionState,\r\n 124|   shaft: ProgressionShaft,\r\n 125| ): number {\r\n 126|   if (state.mode === 'none') return r\r\n 127|   if (state.mode === 'shaping') {\r\n 128|     if (shaft !== 'legacy') return r\r\n 129|     if (y < FACE_START_MM || y > SHAPING_FACE_END_MM || r >= SHAFT_OD_MM) return r\r\n 130|     const space = spaceIndexAt(azimuth)\r\n 131|     let depth = state.spaceDepth[space]\r\n 132|     // The engaged space carries the new depth only behind the cutter's leading face.\r\n 133|     if (space === state.engagedSpace && y > state.edgeY) depth = state.engagedPreviousDepth ?? 0\r\n 134|     const value = r + (1 - depth) * (SHAFT_OD_MM - SHAFT_ROOT_MM)\r\n 135|     return value > SHAFT_OD_MM ? SHAFT_OD_MM : value\r\n 136|   }\r\n 137|   if (shaft !== 'approved') return r\r\n 138|   if (y < FACE_START_MM || y > HOBBING_FACE_END_MM) return r\r\n 139|   const floor = hobFloorRadius(y, state.hobYc, state.hobA, state.hobR)\r\n 140|   const clamped = floor > SHAFT_OD_MM ? SHAFT_OD_MM : floor\r\n 141|   return r > clamped ? r : clamped\r\n 142| }\r\n 143| \r\n 144| // ---- shader patch -------------------------------------------------------------------------\r\n 145| \r\n 146| export const PROGRESSION_LAW_MARKER = 'JG-PROGRESSION-LAW-BEGIN'\r\n 147| export const PROGRESSION_NORMAL_MARKER = 'JG-PROGRESSION-NORMAL-BEGIN'\r\n 148| export const PROGRESSION_VERTEX_MARKER = 'JG-PROGRESSION-VERTEX-BEGIN'\r\n 149| export const STRESS_MARKER = 'JG-STRESS-BEGIN'\r\n 150| \r\n 151| export interface ProgressionUniforms {\r\n 152|   uShaftMatrix: IUniform<Matrix4>\r\n 153|   uShaftInverse: IUniform<Matrix4>\r\n 154|   uShaftNormalMatrix: IUniform<Matrix3>\r\n 155|   uProgressionMode: IUniform<number>\r\n 156|   uShaftKind: IUniform<number>\r\n 157|   uSpaceDepth: IUniform<Float32Array>\r\n 158|   uSpacePitch: IUniform<number>\r\n 159|   uSpaceClock: IUniform<number>\r\n 160|   uEngagedSpace: IUniform<number>\r\n 161|   uEngagedPreviousDepth: IUniform<number>\r\n 162|   uEdgeY: IUniform<number>\r\n 163|   uHobYc: IUniform<number>\r\n 164|   uHobA: IUniform<number>\r\n 165|   uHobR: IUniform<number>\r\n 166|   uFaceStart: IUniform<number>\r\n 167|   uFaceEnd: IUniform<number>\r\n 168|   uShaftOD: IUniform<number>\r\n 169|   uShaftRoot: IUniform<number>\r\n 170|   uStressKind: IUniform<number>\r\n 171|   uStressMix: IUniform<number>\r\n 172|   uStressScanProgress: IUniform<number>\r\n 173|   uStressYMin: IUniform<number>\r\n 174|   uStressYMax: IUniform<number>\r\n 175|   uStressRMax: IUniform<number>\r\n 176| }\r\n 177| \r\n 178| export function createProgressionUniforms(): ProgressionUniforms {\r\n 179|   return {\r\n 180|     uShaftMatrix: { value: new Matrix4() },\r\n 181|     uShaftInverse: { value: new Matrix4() },\r\n 182|     uShaftNormalMatrix: { value: new Matrix3() },\r\n 183|     uProgressionMode: { value: 0 },\r\n 184|     uShaftKind: { value: 0 },\r\n 185|     uSpaceDepth: { value: new Float32Array(SHAFT_SPACES) },\r\n 186|     uSpacePitch: { value: SPACE_PITCH_RAD },\r\n 187|     uSpaceClock: { value: SPACE_CLOCK_RAD },\r\n 188|     uEngagedSpace: { value: -1 },\r\n 189|     uEngagedPreviousDepth: { value: 0 },\r\n 190|     uEdgeY: { value: 0 },\r\n 191|     uHobYc: { value: HOB_INFEED_YC_MM },\r\n 192|     uHobA: { value: HOB_VISUAL_A_MM },\r\n 193|     uHobR: { value: HOB_VISUAL_R_MM },\r\n 194|     uFaceStart: { value: FACE_START_MM },\r\n 195|     uFaceEnd: { value: SHAPING_FACE_END_MM },\r\n 196|     uShaftOD: { value: SHAFT_OD_MM },\r\n 197|     uShaftRoot: { value: SHAFT_ROOT_MM },\r\n 198|     uStressKind: { value: 0 },\r\n 199|     uStressMix: { value: 0 },\r\n 200|     uStressScanProgress: { value: 0 },\r\n 201|     uStressYMin: { value: 0 },\r\n 202|     uStressYMax: { value: 0 },\r\n 203|     uStressRMax: { value: SHAFT_OD_MM },\r\n 204|   }\r\n 205| }\r\n 206| \r\n 207| /** Set the object-to-shaft-local matrix once per mesh (or per frame if the object moves). */\r\n 208| export function setShaftTransform(uniforms: ProgressionUniforms, objectToShaft: Matrix4): void {\r\n 209|   uniforms.uShaftMatrix.value.copy(objectToShaft)\r\n 210|   uniforms.uShaftInverse.value.copy(objectToShaft).invert()\r\n 211|   uniforms.uShaftNormalMatrix.value.getNormalMatrix(uniforms.uShaftInverse.value)\r\n 212| }\r\n 213| \r\n 214| const MODE_VALUE: Readonly<Record<ProgressionMode, number>> = { none: 0, shaping: 1, hobbing: 2 }\r\n 215| const STRESS_VALUE: Readonly<Record<StressOverlay['kind'], number>> = { none: 0, warm: 1, cool: 2 }\r\n 216| \r\n 217| /** Write the per-frame progression uniforms in place (no allocation). */\r\n 218| export function writeProgressionUniforms(\r\n 219|   uniforms: ProgressionUniforms,\r\n 220|   state: ProgressionState,\r\n 221|   shaft?: ProgressionShaft,\r\n 222| ): void {\r\n 223|   const resolved: ProgressionShaft = shaft ?? (state.mode === 'hobbing' ? 'approved' : 'legacy')\r\n 224|   uniforms.uProgressionMode.value = MODE_VALUE[state.mode]\r\n 225|   uniforms.uShaftKind.value = resolved === 'approved' ? 1 : 0\r\n 226|   uniforms.uFaceEnd.value = resolved === 'approved' ? HOBBING_FACE_END_MM : SHAPING_FACE_END_MM\r\n 227|   const depth = uniforms.uSpaceDepth.value\r\n 228|   const source = state.spaceDepth\r\n 229|   for (let i = 0; i < SHAFT_SPACES; i++) depth[i] = source[i]\r\n 230|   uniforms.uEngagedSpace.value = state.engagedSpace\r\n 231|   uniforms.uEngagedPreviousDepth.value = state.engagedPreviousDepth ?? 0\r\n 232|   uniforms.uEdgeY.value = state.edgeY\r\n 233|   uniforms.uHobYc.value = state.hobYc\r\n 234|   uniforms.uHobA.value = state.hobA\r\n 235|   uniforms.uHobR.value = state.hobR\r\n 236| }\r\n 237| \r\n 238| /** Write the stress-overlay uniforms in place (no allocation). */\r\n 239| export function writeStressUniforms(uniforms: ProgressionUniforms, stress: StressOverlay): void {\r\n 240|   uniforms.uStressKind.value = STRESS_VALUE[stress.kind]\r\n 241|   uniforms.uStressMix.value = stress.mix\r\n 242|   uniforms.uStressScanProgress.value = stress.scanProgress\r\n 243|   uniforms.uStressYMin.value = stress.yMin\r\n 244|   uniforms.uStressYMax.value = stress.yMax\r\n 245|   uniforms.uStressRMax.value = stress.rMax\r\n 246| }\r\n 247| \r\n 248| const VERTEX_COMMON = /* glsl */ `\r\n 249| uniform mat4 uShaftMatrix;\r\n 250| uniform mat4 uShaftInverse;\r\n 251| uniform mat3 uShaftNormalMatrix;\r\n 252| uniform float uProgressionMode;\r\n 253| uniform float uShaftKind;\r\n 254| uniform float uSpaceDepth[10];\r\n 255| uniform float uSpacePitch;\r\n 256| uniform float uSpaceClock;\r\n 257| uniform float uEngagedSpace;\r\n 258| uniform float uEngagedPreviousDepth;\r\n 259| uniform float uEdgeY;\r\n 260| uniform float uHobYc;\r\n 261| uniform float uHobA;\r\n 262| uniform float uHobR;\r\n 263| uniform float uFaceStart;\r\n 264| uniform float uFaceEnd;\r\n 265| uniform float uShaftOD;\r\n 266| uniform float uShaftRoot;\r\n 267| varying vec3 vShaftLocal;\r\n 268| // ${PROGRESSION_LAW_MARKER}\r\n 269| float jgEffectiveMode() {\r\n 270|   if (uProgressionMode > 1.5) return uShaftKind > 0.5 ? 2.0 : 0.0;\r\n 271|   if (uProgressionMode > 0.5) return uShaftKind < 0.5 ? 1.0 : 0.0;\r\n 272|   return 0.0;\r\n 273| }\r\n 274| float jgProgressedRadius(vec3 jgLocal, out float jgClamped) {\r\n 275|   float jgRadius = length(jgLocal.xz);\r\n 276|   float jgNew = jgRadius;\r\n 277|   jgClamped = 0.0;\r\n 278|   float jgMode = jgEffectiveMode();\r\n 279|   if (jgMode > 0.5 && jgLocal.y >= uFaceStart && jgLocal.y <= uFaceEnd) {\r\n 280|     if (jgMode < 1.5) {\r\n 281|       if (jgRadius < uShaftOD) {\r\n 282|         // atan(0, 0) is undefined in GLSL; use the CPU atan2(0, 0) convention (+X).\r\n 283|         float jgAngle = jgRadius > 0.0 ? atan(jgLocal.z, jgLocal.x) : 0.0;\r\n 284|         float jgSpace = mod(floor((jgAngle - uSpaceClock) / uSpacePitch + 0.5), 10.0);\r\n 285|         float jgDepth = uSpaceDepth[int(jgSpace)];\r\n 286|         if (abs(uEngagedSpace - jgSpace) < 0.5 && jgLocal.y > uEdgeY) jgDepth = uEngagedPreviousDepth;\r\n 287|         jgNew = min(uShaftOD, jgRadius + (1.0 - jgDepth) * (uShaftOD - uShaftRoot));\r\n 288|       }\r\n 289|     } else {\r\n 290|       float jgFloor = uShaftOD;\r\n 291|       if (jgLocal.y <= uHobYc) {\r\n 292|         jgFloor = uShaftRoot;\r\n 293|       } else if (jgLocal.y < uHobYc + uHobR) {\r\n 294|         float jgDy = jgLocal.y - uHobYc;\r\n 295|         jgFloor = uHobA - sqrt(max(0.0, uHobR * uHobR - jgDy * jgDy));\r\n 296|       }\r\n 297|       jgNew = max(jgRadius, min(uShaftOD, jgFloor));\r\n 298|     }\r\n 299|     // Preserve original normals in the finished state and on untouched journal/tip vertices.\r\n 300|     if (jgNew > jgRadius + 0.000001 && jgNew > uShaftOD - 0.0001) jgClamped = 1.0;\r\n 301|   }\r\n 302|   return jgNew;\r\n 303| }\r\n 304| `\r\n 305| \r\n 306| const FRAGMENT_COMMON = /* glsl */ `\r\n 307| uniform float uStressKind;\r\n 308| uniform float uStressMix;\r\n 309| uniform float uStressScanProgress;\r\n 310| uniform float uStressYMin;\r\n 311| uniform float uStressYMax;\r\n 312| uniform float uStressRMax;\r\n 313| varying vec3 vShaftLocal;\r\n 314| `\r\n 315| \r\n 316| const NORMAL_CHUNK = /* glsl */ `\r\n 317| #include <beginnormal_vertex>\r\n 318| // ${PROGRESSION_NORMAL_MARKER}\r\n 319| {\r\n 320|   vec4 jgNormalLocal = uShaftMatrix * vec4(position, 1.0);\r\n 321|   float jgNormalClamp;\r\n 322|   jgProgressedRadius(jgNormalLocal.xyz, jgNormalClamp);\r\n 323|   if (jgNormalClamp > 0.5) {\r\n 324|     vec3 jgRadialLocal = length(jgNormalLocal.xz) > 0.0\r\n 325|       ? normalize(vec3(jgNormalLocal.x, 0.0, jgNormalLocal.z)) : vec3(1.0, 0.0, 0.0);\r\n 326|     vec3 jgRadialObject = normalize(uShaftNormalMatrix * jgRadialLocal);\r\n 327|     objectNormal = normalize(mix(objectNormal, jgRadialObject, jgNormalClamp));\r\n 328|   }\r\n 329| }\r\n 330| `\r\n 331| \r\n 332| const VERTEX_CHUNK = /* glsl */ `\r\n 333| // ${PROGRESSION_VERTEX_MARKER}\r\n 334| vec4 jgLocal4 = uShaftMatrix * vec4(position, 1.0);\r\n 335| float jgClamp;\r\n 336| float jgNewRadius = jgProgressedRadius(jgLocal4.xyz, jgClamp);\r\n 337| float jgOldRadius = length(jgLocal4.xz);\r\n 338| float jgScale = jgOldRadius > 0.0 ? jgNewRadius / jgOldRadius : 1.0;\r\n 339| vec3 jgLocalNew = jgOldRadius > 0.0\r\n 340|   ? vec3(jgLocal4.x * jgScale, jgLocal4.y, jgLocal4.z * jgScale)\r\n 341|   : vec3(jgNewRadius, jgLocal4.y, 0.0);\r\n 342| vShaftLocal = jgLocalNew;\r\n 343| vec3 transformed = (uShaftInverse * vec4(jgLocalNew, 1.0)).xyz;\r\n 344| `\r\n 345| \r\n 346| const STRESS_CHUNK = /* glsl */ `\r\n 347| #include <emissivemap_fragment>\r\n 348| // ${STRESS_MARKER}\r\n 349| if (uStressKind > 0.5 && uStressMix > 0.001) {\r\n 350|   float jgStressInBand = step(uStressYMin, vShaftLocal.y) * (1.0 - step(uStressYMax, vShaftLocal.y));\r\n 351|   float jgStressRadius = length(vShaftLocal.xz);\r\n 352|   float jgStressInR = (1.0 - step(uStressRMax, jgStressRadius)) * step(0.0001, jgStressRadius);\r\n 353|   float jgStressEdge = mix(uStressYMin, uStressYMax, clamp(uStressScanProgress, 0.0, 1.0));\r\n 354|   float jgStressScanned = 1.0 - smoothstep(jgStressEdge - 0.05, jgStressEdge + 0.05, vShaftLocal.y);\r\n 355|   float jgStressMask = jgStressInBand * jgStressInR * jgStressScanned * clamp(uStressMix, 0.0, 1.0);\r\n 356|   vec3 jgStressTint = uStressKind < 1.5 ? vec3(1.0, 0.42, 0.16) : vec3(0.18, 0.72, 0.95);\r\n 357|   totalEmissiveRadiance += jgStressTint * jgStressMask * 0.35;\r\n 358| }\r\n 359| `\r\n 360| \r\n 361| /**\r\n 362|  * Patch a standard/physical material with the progression law and stress overlay.\r\n 363|  *\r\n 364|  * The caller owns the `uniforms` object (createProgressionUniforms), updates it each frame\r\n 365|  * with writeProgressionUniforms/writeStressUniforms, and disposes the material. This takes\r\n 366|  * ownership of material.onBeforeCompile.\r\n 367|  */\r\n 368| export function applyProgression(\r\n 369|   material: MeshStandardMaterial | MeshPhysicalMaterial,\r\n 370|   uniforms: ProgressionUniforms,\r\n 371| ): Material {\r\n 372|   material.onBeforeCompile = (shader) => {\r\n 373|     for (const key of Object.keys(uniforms) as (keyof ProgressionUniforms)[]) {\r\n 374|       shader.uniforms[key] = uniforms[key]\r\n 375|     }\r\n 376|     shader.vertexShader = shader.vertexShader\r\n 377|       .replace('#include <common>', '#include <common>\\n' + VERTEX_COMMON)\r\n 378|       .replace('#include <beginnormal_vertex>', NORMAL_CHUNK)\r\n 379|       .replace('#include <begin_vertex>', VERTEX_CHUNK)\r\n 380|     shader.fragmentShader = shader.fragmentShader\r\n 381|       .replace('#include <common>', '#include <common>\\n' + FRAGMENT_COMMON)\r\n 382|       .replace('#include <emissivemap_fragment>', STRESS_CHUNK)\r\n 383|   }\r\n 384|   material.customProgramCacheKey = () => 'jgun-shaft-progression-v2'\r\n 385|   material.needsUpdate = true\r\n 386|   return material\r\n 387| }\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath '\"'src/scene/inspection/shaft/kinematics.ts' | ForEach-Object { \"'$i++; '\"'{0,4}| {1}' -f \"'$i, $_ }'","aggregated_output":"   1| /**\r\n   2|  * JG-035 shaft machining kinematics (leaf spec: shaft-kinematics-camera-spec, 2026-10-05).\r\n   3|  *\r\n   4|  * Closed-form machining kinematics for the 43 s Input Shaft story, sampled from one master\r\n   5|  * playhead. Everything is a pure function of time: no accumulators, no clocks, no randomness,\r\n   6|  * no allocation in per-frame paths, deterministic under any seek order.\r\n   7|  *\r\n   8|  * Frame: shaft-local millimetres, +Y is the shaft axis (CAD datum). The runtime loader performs\r\n   9|  * exactly one conversion (shaft-local +Y -> glTF -Z); nothing here converts.\r\n  10|  *\r\n  11|  * Certified tool numbers (clearance-v4 report, mirrored in toolSpec.ts):\r\n  12|  *   shaper N=20 disc cutter, signed work/cutter ratio -2, centre distance 15.5 mm,\r\n  13|  *   tip radius 11.2032 mm (near edge at root + 5 um), thickness 1.2 mm,\r\n  14|  *   stroke centre limits y 2.17..9.7749, overtravel 0.5 mm past the last tooth material,\r\n  15|  *   return backed off 2.0 mm. Hob R 5.87 mm tilted 5.5587 deg, centre distance 10.1618 mm,\r\n  16|  *   stop yc 9.5249, path: radial infeed at yc -4.195 -> feed +Y -> retract 2.5 mm -> withdraw.\r\n  17|  *\r\n  18|  * Sign conventions (tool-conventions.md, independently checked there to 1e-12 m/s):\r\n  19|  *   Shaper: tool and work axes +Y, cutter centre on +Z. Positive angles right-hand about +Y.\r\n  20|  *   External rolling at the pitch point (work z=+5, cutter z=-10 in the 5/10 mm pitch circles)\r\n  21|  *   gives phi_w = -2 * phi_c (toolSpec SHAPER_SIGNED_RATIO).\r\n  22|  *   Hob: RH one-start, axis a = [cos g, sin g, 0], shaft contact at shaft +Z = tool -Z side,\r\n  23|  *   so phi_w = -(starts / teeth) * phi_h = -phi_h / 10.\r\n  24|  */\r\n  25| import type { ProgressionState } from './progression'\r\n  26| import {\r\n  27|   FACE_START_MM,\r\n  28|   HOB_INFEED_YC_MM,\r\n  29|   HOB_RETRACT_MM,\r\n  30|   HOB_VISUAL_A_MM,\r\n  31|   HOB_VISUAL_R_MM,\r\n  32|   SHAFT_OD_MM,\r\n  33|   SHAFT_ROOT_MM,\r\n  34|   SHAFT_SPACES,\r\n  35|   SHAPING_FACE_END_MM,\r\n  36|   SPACE_CLOCK_RAD,\r\n  37|   SPACE_PITCH_RAD,\r\n  38| } from './progression'\r\n  39| import {\r\n  40|   HOB_CENTRE_DISTANCE_AT_DEPTH_MM,\r\n  41|   HOB_LENGTH_MM,\r\n  42|   HOB_LEAD_ANGLE_DEG,\r\n  43|   HOB_RADIUS_MM,\r\n  44|   HOB_STARTS,\r\n  45|   HOB_STOP_YC_MM,\r\n  46|   SHAPER_BACKOFF_MM,\r\n  47|   SHAPER_SIGNED_RATIO,\r\n  48|   SHAPER_STROKE_CENTRE_Y_MAX_MM,\r\n  49|   SHAPER_STROKE_CENTRE_Y_MIN_MM,\r\n  50|   SHAPER_TEETH,\r\n  51|   SHAPER_THICKNESS_MM,\r\n  52| } from './toolSpec'\r\n  53| \r\n  54| // ---- master playhead -> machining time map -----------------------------------------------\r\n  55| \r\n  56| export const SHAFT_KINEMATICS_DURATION = 43\r\n  57| /** 30 fps lite floor; repeated features above a quarter of it must be softened. */\r\n  58| export const SHAFT_LITE_FPS = 30\r\n  59| export const SHAFT_MAX_FEATURE_HZ = SHAFT_LITE_FPS / 4\r\n  60| \r\n  61| const T_SHAPING_START = 2\r\n  62| /** End of the eased startup ramp; the full normal rate resumes here (C1 at 2.0 s and 3.0 s). */\r\n  63| const T_STARTUP_EASE_END = 3\r\n  64| const T_EASE_DOWN = 6\r\n  65| const T_SLOW_START = 7.2\r\n  66| const T_SLOW_END = 9.6\r\n  67| const T_EASE_UP_END = 11\r\n  68| const T_RECAP_END = 14\r\n  69| const T_SHAPING_END = 15\r\n  70| const T_HOB_RATE_IN = 24.6\r\n  71| const T_HOB_RATE_FULL = 25.6\r\n  72| const T_HOB_RATE_DOWN = 31.4\r\n  73| const T_HOB_END = 32\r\n  74| const RATE_NORMAL = 1\r\n  75| const RATE_SLOW = 0.22\r\n  76| const RATE_RECAP = 4\r\n  77| \r\n  78| const clamp01 = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x)\r\n  79| const ease = (x: number) => { const t = clamp01(x); return t * t * (3 - 2 * t) }\r\n  80| /** Integral of ease over [0, u]. */\r\n  81| const easeIntegral = (u: number) => { const t = clamp01(u); return t * t * t - t * t * t * t / 2 }\r\n  82| const mod1 = (x: number) => x - Math.floor(x)\r\n  83| \r\n  84| interface RateSegment { readonly t0: number; readonly t1: number; readonly r0: number; readonly r1: number; readonly m0: number }\r\n  85| \r\n  86| /**\r\n  87|  * Rate segments dm/dt: frozen before 2 s, eased onset 2..3 s (C1 out of the frozen pre-roll\r\n  88|  * and into the normal rate; the review's 2.0 s 0 -> 1 step is gone), normal 3..6 s, eased\r\n  89|  * slow window, compressed recap easing to 0 at 15 s, frozen until the hob window.\r\n  90|  */\r\n  91| const RATE_SPEC: ReadonlyArray<readonly [number, number, number, number]> = [\r\n  92|   [0, T_SHAPING_START, 0, 0],\r\n  93|   [T_SHAPING_START, T_STARTUP_EASE_END, 0, RATE_NORMAL],\r\n  94|   [T_STARTUP_EASE_END, T_EASE_DOWN, RATE_NORMAL, RATE_NORMAL],\r\n  95|   [T_EASE_DOWN, T_SLOW_START, RATE_NORMAL, RATE_SLOW],\r\n  96|   [T_SLOW_START, T_SLOW_END, RATE_SLOW, RATE_SLOW],\r\n  97|   [T_SLOW_END, T_EASE_UP_END, RATE_SLOW, RATE_RECAP],\r\n  98|   [T_EASE_UP_END, T_RECAP_END, RATE_RECAP, RATE_RECAP],\r\n  99|   [T_RECAP_END, T_SHAPING_END, RATE_RECAP, 0],\r\n 100|   [T_SHAPING_END, T_HOB_RATE_IN, 0, 0],\r\n 101|   [T_HOB_RATE_IN, T_HOB_RATE_FULL, 0, 1],\r\n 102|   [T_HOB_RATE_FULL, T_HOB_RATE_DOWN, 1, 1],\r\n 103|   [T_HOB_RATE_DOWN, T_HOB_END, 1, 0],\r\n 104|   [T_HOB_END, SHAFT_KINEMATICS_DURATION, 0, 0],\r\n 105| ]\r\n 106| \r\n 107| const RATE_SEGMENTS: readonly RateSegment[] = (() => {\r\n 108|   const segments: RateSegment[] = []\r\n 109|   let m = 0\r\n 110|   for (const [t0, t1, r0, r1] of RATE_SPEC) {\r\n 111|     segments.push({ t0, t1, r0, r1, m0: m })\r\n 112|     m += (t1 - t0) * (r0 + r1) * 0.5\r\n 113|   }\r\n 114|   return segments\r\n 115| })()\r\n 116| \r\n 117| /** Interior rate-segment boundary times (s); m(t) is tested for C1 across each of these. */\r\n 118| export const MACHINING_RATE_BOUNDARIES: readonly number[] = RATE_SPEC.slice(1, -1).map((segment) => segment[0])\r\n 119| \r\n 120| function rateSegmentAt(t: number): RateSegment {\r\n 121|   for (let i = RATE_SEGMENTS.length - 1; i >= 0; i--) {\r\n 122|     const segment = RATE_SEGMENTS[i]\r\n 123|     if (t >= segment.t0) return segment\r\n 124|   }\r\n 125|   return RATE_SEGMENTS[0]\r\n 126| }\r\n 127| \r\n 128| /** Machining time m(t): continuous, monotonic, C1 (rate is C0, piecewise smooth). */\r\n 129| export function machiningTimeAt(time: number): number {\r\n 130|   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time\r\n 131|   const s = rateSegmentAt(t)\r\n 132|   const u = (t - s.t0) / (s.t1 - s.t0)\r\n 133|   return s.m0 + (t - s.t0) * s.r0 + (s.r1 - s.r0) * (s.t1 - s.t0) * easeIntegral(u)\r\n 134| }\r\n 135| \r\n 136| /** dm/dt at the master playhead. */\r\n 137| export function machiningRateAt(time: number): number {\r\n 138|   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time\r\n 139|   const s = rateSegmentAt(t)\r\n 140|   if (s.r0 === s.r1) return s.r0\r\n 141|   return s.r0 + (s.r1 - s.r0) * ease((t - s.t0) / (s.t1 - s.t0))\r\n 142| }\r\n 143| \r\n 144| /** Midpoint of the stable slow window; the exit stroke peaks here (t = 8.4 s). */\r\n 145| export const T_SLOW_MID = (T_SLOW_START + T_SLOW_END) / 2\r\n 146| export const MACHINING_AT_SLOW_MID = machiningTimeAt(T_SLOW_MID)\r\n 147| export const MACHINING_AT_SHAPING_END = machiningTimeAt(T_SHAPING_END)\r\n 148| \r\n 149| // ---- shaper ------------------------------------------------------------------------------\r\n 150| \r\n 151| /** Work revolution period in machining seconds (ratio -2 with the cutter below). */\r\n 152| export const WORK_REV_M = 2\r\n 153| export const CUTTER_RATE = Math.PI / 2\r\n 154| export const WORK_RATE = SHAPER_SIGNED_RATIO * CUTTER_RATE\r\n 155| /** Mesh (pitch) point azimuth in the machine frame: cutter centre sits on +Z. */\r\n 156| export const MESH_AZ_RAD = Math.PI / 2\r\n 157| /** Stroke period in machining seconds; 2.5 strokes per work revolution. */\r\n 158| export const STROKE_PERIOD_M = 0.8\r\n 159| /**\r\n 160|  * Stroke phase offset, chosen so phase 0.5 (peak, yc = stroke max) lands exactly at\r\n 161|  * MACHINING_AT_SLOW_MID: the readable cutter exit sits at the centre of the slow window.\r\n 162|  */\r\n 163| export const STROKE_PHASE_OFFSET = mod1(0.5 - MACHINING_AT_SLOW_MID / STROKE_PERIOD_M)\r\n 164| /** Cutter orbit period; radial infeed completes within the first quarter orbit. */\r\n 165| export const CUTTER_ORBIT_M = (2 * Math.PI) / CUTTER_RATE\r\n 166| export const INFEED_END_M = CUTTER_ORBIT_M / 4\r\n 167| /** Cutter tip runs at work root + 5 um stock (clearance-v4 shaper fit). */\r\n 168| export const ROOT_TIP_STOCK_MM = 0.005\r\n 169| export const CUTTER_TIP_RHO_MM = SHAFT_ROOT_MM + ROOT_TIP_STOCK_MM\r\n 170| /**\r\n 171|  * Illustrative counted contact events each tooth space needs to reach depth 1. Selected\r\n 172|  * cutting revolutions recur every 2 * WORK_REV_M (the stroke/work ratio is 2.5). Each\r\n 173|  * event is placed within the nearest-space sector AND actual axial/radial stock contact;\r\n 174|  * four events put every space's completion inside the 11..15 s recap. This depicts\r\n 175|  * retained pass depths, not a continuous generating-surface simulation.\r\n 176|  */\r\n 177| export const SPACE_PASSES_REQUIRED = 4\r\n 178| /** Deterministic chip seed (golden-ratio conjugate); fixes the baked chip offsets. */\r\n 179| export const CHIP_SEED = 0.6180339887498949\r\n 180| \r\n 181| export function strokePhaseAt(m: number): number {\r\n 182|   return mod1(m / STROKE_PERIOD_M + STROKE_PHASE_OFFSET)\r\n 183| }\r\n 184| \r\n 185| export function strokeCentreYAt(m: number): number {\r\n 186|   const phase = strokePhaseAt(m)\r\n 187|   const bump = 0.5 * (1 - Math.cos(2 * Math.PI * phase))\r\n 188|   return SHAPER_STROKE_CENTRE_Y_MIN_MM + (SHAPER_STROKE_CENTRE_Y_MAX_MM - SHAPER_STROKE_CENTRE_Y_MIN_MM) * bump\r\n 189| }\r\n 190| \r\n 191| /** Relieved-return radial backoff (mm): eased in/out around a full 2.0 mm plateau. */\r\n 192| export function backoffAt(m: number): number {\r\n 193|   const phase = strokePhaseAt(m)\r\n 194|   if (phase < 0.5) return 0\r\n 195|   const u = (phase - 0.5) * 2\r\n 196|   const bump = u < 0.2 ? ease(u / 0.2) : u <= 0.84 ? 1 : 1 - ease((u - 0.84) / 0.16)\r\n 197|   return SHAPER_BACKOFF_MM * bump\r\n 198| }\r\n 199| \r\n 200| /** Radial infeed position of the cutter near edge (mm): OD -> root + 5 um in the first quarter orbit. */\r\n 201| export function infeedRhoAt(m: number): number {\r\n 202|   if (m <= 0) return SHAFT_OD_MM\r\n 203|   if (m >= INFEED_END_M) return CUTTER_TIP_RHO_MM\r\n 204|   return SHAFT_OD_MM + (CUTTER_TIP_RHO_MM - SHAFT_OD_MM) * ease(m / INFEED_END_M)\r\n 205| }\r\n 206| \r\n 207| /**\r\n 208|  * Tooth-space contact schedule. Space i centre crosses the mesh azimuth when\r\n 209|  * SPACE_CLOCK + i*pitch + WORK_RATE*m === MESH_AZ (mod 2*pi); crossings recur every\r\n 210|  * WORK_REV_M. Because WORK_REV_M / STROKE_PERIOD_M = 2.5, the stroke phase at a space's\r\n 211|  * crossings advances by exactly +0.5 per revolution. A cutting-half centre crossing can\r\n 212|  * still precede the stock face: counting it would remove material while engagedSpace=-1.\r\n 213|  * Move that event to the first actual face contact within the SAME nearest-space sector\r\n 214|  * (half a pitch either side of the centre). Precompute once, never allocate during sample.\r\n 215|  */\r\n 216| const STOCK_ENTRY_PHASE = Math.acos(1 - 2 * (FACE_START_MM - SHAPER_THICKNESS_MM / 2 - SHAPER_STROKE_CENTRE_Y_MIN_MM)\r\n 217|   / (SHAPER_STROKE_CENTRE_Y_MAX_MM - SHAPER_STROKE_CENTRE_Y_MIN_MM)) / (2 * Math.PI)\r\n 218| const STOCK_EXIT_PHASE = Math.acos(1 - 2 * (SHAPING_FACE_END_MM - SHAPER_THICKNESS_MM / 2 - SHAPER_STROKE_CENTRE_Y_MIN_MM)\r\n 219|   / (SHAPER_STROKE_CENTRE_Y_MAX_MM - SHAPER_STROKE_CENTRE_Y_MIN_MM)) / (2 * Math.PI)\r\n 220| const PASS_REPEAT_M = 2 * WORK_REV_M\r\n 221| const HALF_SPACE_WINDOW_M = SPACE_PITCH_RAD / (2 * Math.abs(WORK_RATE))\r\n 222| /** Tiny interior offset avoids an acos/cos roundoff putting the event outside the face. */\r\n 223| const CONTACT_INTERIOR_M = 1e-9\r\n 224| const FIRST_CONTACT_PASS_M: number[] = []\r\n 225| for (let i = 0; i < SHAFT_SPACES; i++) {\r\n 226|   const alpha = SPACE_CLOCK_RAD + i * SPACE_PITCH_RAD\r\n 227|   let c = (alpha - MESH_AZ_RAD) / -WORK_RATE\r\n 228|   c -= Math.floor(c / WORK_REV_M) * WORK_REV_M\r\n 229|   if (strokePhaseAt(c) >= 0.5) c += WORK_REV_M\r\n 230|   const strokeStart = c - strokePhaseAt(c) * STROKE_PERIOD_M\r\n 231|   const entry = strokeStart + STOCK_ENTRY_PHASE * STROKE_PERIOD_M\r\n 232|   const exit = strokeStart + STOCK_EXIT_PHASE * STROKE_PERIOD_M\r\n 233|   const event = Math.max(entry + CONTACT_INTERIOR_M, Math.min(c, exit - CONTACT_INTERIOR_M))\r\n 234|   const eventEdge = strokeCentreYAt(event) + SHAPER_THICKNESS_MM / 2\r\n 235|   const nearest = Math.round((MESH_AZ_RAD - SPACE_CLOCK_RAD - WORK_RATE * event) / SPACE_PITCH_RAD)\r\n 236|   if (event < c - HALF_SPACE_WINDOW_M || event >= c + HALF_SPACE_WINDOW_M\r\n 237|     || eventEdge < FACE_START_MM || eventEdge > SHAPING_FACE_END_MM\r\n 238|     || ((nearest % SHAFT_SPACES) + SHAFT_SPACES) % SHAFT_SPACES !== i\r\n 239|     || strokePhaseAt(event) >= 0.5 || infeedRhoAt(event) >= SHAFT_OD_MM - 1e-3) {\r\n 240|     throw new Error('Shaper contact event does not fit the certified nearest-space stock window')\r\n 241|   }\r\n 242|   FIRST_CONTACT_PASS_M.push(event)\r\n 243| }\r\n 244| \r\n 245| /** Counted stock-contact events of space i by machining time m; closed form, no history. */\r\n 246| export function countedPasses(m: number, space: number): number {\r\n 247|   const first = FIRST_CONTACT_PASS_M[space]\r\n 248|   return m < first ? 0 : Math.floor((m - first) / PASS_REPEAT_M) + 1\r\n 249| }\r\n 250| \r\n 251| // ---- hob ---------------------------------------------------------------------------------\r\n 252| \r\n 253| const T_HOB_INFEED_END = 25.7\r\n 254| const T_HOB_FEED_END = 30.2\r\n 255| const T_HOB_RETRACT_END = 31\r\n 256| const T_HOB_WITHDRAW_END = 31.8\r\n 257| const HOB_WITHDRAW_YC_MM = -8\r\n 258| const HOB_REV_RATE = 0.5\r\n 259| const HOB_FLUTES = 10\r\n 260| const HOB_FEED_SPAN_MM = HOB_STOP_YC_MM - HOB_INFEED_YC_MM\r\n 261| \r\n 262| /** Hob centre y (mm) along the certified path: infeed yc, feed +Y, hold, withdraw below the face. */\r\n 263| export function hobYcAt(t: number): number {\r\n 264|   if (t < T_HOB_INFEED_END) return HOB_INFEED_YC_MM\r\n 265|   if (t < T_HOB_FEED_END) return HOB_INFEED_YC_MM + HOB_FEED_SPAN_MM * ease((t - T_HOB_INFEED_END) / (T_HOB_FEED_END - T_HOB_INFEED_END))\r\n 266|   if (t < T_HOB_RETRACT_END) return HOB_STOP_YC_MM\r\n 267|   if (t < T_HOB_WITHDRAW_END) return HOB_STOP_YC_MM + (HOB_WITHDRAW_YC_MM - HOB_STOP_YC_MM) * ease((t - T_HOB_RETRACT_END) / (T_HOB_WITHDRAW_END - T_HOB_RETRACT_END))\r\n 268|   return HOB_WITHDRAW_YC_MM\r\n 269| }\r\n 270| \r\n 271| /** Radial offset from full depth (mm): 2.5 out before infeed and after retract. */\r\n 272| export function hobRadialOffsetAt(t: number): number {\r\n 273|   if (t < T_HOB_INFEED_END) return HOB_RETRACT_MM * (1 - ease((t - 25) / (T_HOB_INFEED_END - 25)))\r\n 274|   if (t < T_HOB_FEED_END) return 0\r\n 275|   if (t < T_HOB_RETRACT_END) return HOB_RETRACT_MM * ease((t - T_HOB_FEED_END) / (T_HOB_RETRACT_END - T_HOB_FEED_END))\r\n 276|   return HOB_RETRACT_MM\r\n 277| }\r\n 278| \r\n 279| /** Hob rotation rate (rev/s at the master playhead), eased up 25.2..26 and down 31..31.8. */\r\n 280| export function hobRevRateAt(t: number): number {\r\n 281|   if (t <= 25.2 || t >= 31.8) return 0\r\n 282|   if (t < 26) return HOB_REV_RATE * ease((t - 25.2) / 0.8)\r\n 283|   if (t < 31) return HOB_REV_RATE\r\n 284|   return HOB_REV_RATE * (1 - ease((t - 31) / 0.8))\r\n 285| }\r\n 286| \r\n 287| export function hobPhiAt(t: number): number {\r\n 288|   // Closed form: integral of hobRevRateAt with the same smoothstep segments.\r\n 289|   let revs = 0\r\n 290|   if (t > 25.2) {\r\n 291|     if (t < 26) revs = HOB_REV_RATE * 0.8 * easeIntegral((t - 25.2) / 0.8)\r\n 292|     else {\r\n 293|       revs = HOB_REV_RATE * 0.8 * 0.5\r\n 294|       if (t < 31) revs += HOB_REV_RATE * (t - 26)\r\n 295|       else {\r\n 296|         revs += HOB_REV_RATE * 5\r\n 297|         if (t < 31.8) {\r\n 298|           const u = (t - 31) / 0.8\r\n 299|           revs += HOB_REV_RATE * 0.8 * (u - easeIntegral(u))\r\n 300|         }\r\n 301|         else revs += HOB_REV_RATE * 0.8 * 0.5\r\n 302|       }\r\n 303|     }\r\n 304|   }\r\n 305|   return 2 * Math.PI * revs\r\n 306| }\r\n 307| \r\n 308| // ---- frame-follow azimuth ----------------------------------------------------------------\r\n 309| \r\n 310| /**\r\n 311|  * Frame-follow azimuth psi(t) = FOLLOW_GAIN * mf(t), mf = integral of followWeight * rate.\r\n 312|  * The eased startup is integrated exactly: dm/dt ramps 0 -> 1 across 2..3 s, so mf banks\r\n 313|  * only half a machining second there and psi spans 7*pi/16 over 2..6 s (a full quarter\r\n 314|  * orbit was the retired linear-startup figure). Follow weight: 1 on [2,6], eased to 0 by\r\n 315|  * 7.2 (before the cutter edge reaches the face end), re-engaged 11..12 for the recap,\r\n 316|  * frozen after 15 s because the rate is zero there.\r\n 317|  */\r\n 318| export const FOLLOW_GAIN = Math.PI / 8\r\n 319| \r\n 320| export function followWeightAt(t: number): number {\r\n 321|   if (t < T_SHAPING_START) return 0\r\n 322|   if (t < T_EASE_DOWN) return 1\r\n 323|   if (t < T_SLOW_START) return 1 - ease((t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN))\r\n 324|   if (t < T_EASE_UP_END) return 0\r\n 325|   if (t < 12) return ease((t - T_EASE_UP_END) / 1)\r\n 326|   if (t < T_SHAPING_END) return 1\r\n 327|   return 0\r\n 328| }\r\n 329| \r\n 330| const ease2Integral = (u: number) => (9 / 5) * u ** 5 - 2 * u ** 6 + (4 / 7) * u ** 7\r\n 331| /** mf at 3 s: the eased startup segment (length 1, rate 0 -> 1) banks easeIntegral(1) = 0.5. */\r\n 332| const MF_AT_STARTUP_END = (T_STARTUP_EASE_END - T_SHAPING_START) * RATE_NORMAL * easeIntegral(1)\r\n 333| /** mf at 6 s: half a machining second from the eased startup plus three at the normal rate. */\r\n 334| const MF_AT_EASE_DOWN = MF_AT_STARTUP_END + (T_EASE_DOWN - T_STARTUP_EASE_END)\r\n 335| const MF_AT_SLOW_START = MF_AT_EASE_DOWN + 1.2 * (1 - 1.78 * 0.5 + 0.78 * (9 / 5 - 2 + 4 / 7))\r\n 336| const MF_AT_RECAP_START = MF_AT_SLOW_START\r\n 337| const MF_AT_12 = MF_AT_SLOW_START + 4 * 0.5\r\n 338| const MF_AT_RECAP_END = MF_AT_12 + 8\r\n 339| export const FOLLOW_MF_TOTAL = MF_AT_RECAP_END + 4 * 0.5\r\n 340| \r\n 341| export function followMfAt(t: number): number {\r\n 342|   if (t < T_SHAPING_START) return 0\r\n 343|   if (t < T_STARTUP_EASE_END) {\r\n 344|     // Weight 1 through the eased startup: mf = m(t) on that segment (same closed form).\r\n 345|     return (T_STARTUP_EASE_END - T_SHAPING_START) * RATE_NORMAL * easeIntegral((t - T_SHAPING_START) / (T_STARTUP_EASE_END - T_SHAPING_START))\r\n 346|   }\r\n 347|   if (t < T_EASE_DOWN) return MF_AT_STARTUP_END + (t - T_STARTUP_EASE_END)\r\n 348|   if (t < T_SLOW_START) {\r\n 349|     const u = (t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN)\r\n 350|     // integral of (1 - S(u)) * (1 - 0.78 S(u)) over the shared ease window\r\n 351|     return MF_AT_EASE_DOWN + 1.2 * (u - 1.78 * easeIntegral(u) + 0.78 * ease2Integral(u))\r\n 352|   }\r\n 353|   if (t < T_EASE_UP_END) return MF_AT_SLOW_START\r\n 354|   if (t < 12) return MF_AT_RECAP_START + 4 * easeIntegral(t - T_EASE_UP_END)\r\n 355|   if (t < T_RECAP_END) return MF_AT_12 + 4 * (t - 12)\r\n 356|   if (t < T_SHAPING_END) return MF_AT_RECAP_END + 4 * ((t - T_RECAP_END) - easeIntegral(t - T_RECAP_END))\r\n 357|   return FOLLOW_MF_TOTAL\r\n 358| }\r\n 359| \r\n 360| // ---- sampler -----------------------------------------------------------------------------\r\n 361| \r\n 362| export type ShaftKinematicsMode = 'none' | 'shaping' | 'hobbing'\r\n 363| \r\n 364| export interface ShaftKinematicsFrame {\r\n 365|   /** Clamped master playhead (s). */\r\n 366|   time: number\r\n 367|   /** Machining time m(t) and rate dm/dt. */\r\n 368|   machining: number\r\n 369|   machiningRate: number\r\n 370|   mode: ShaftKinematicsMode\r\n 371|   /** Rotating-frame follow azimuth (rad) and weight; lighting follows the same weight. */\r\n 372|   followAzimuth: number\r\n 373|   followWeight: number\r\n 374|   // shaper (machine frame, shaft-local mm)\r\n 375|   cutterPhi: number\r\n 376|   workPhi: number\r\n 377|   strokeCentreY: number\r\n 378|   /** Cutter leading-face y (mm); progression.ts reveal edge. */\r\n 379|   edgeY: number\r\n 380|   strokePhase: number\r\n 381|   cutting: boolean\r\n 382|   returning: boolean\r\n 383|   backoff: number\r\n 384|   /** Cutter near-edge radius (mm), including infeed and backoff. */\r\n 385|   cutterRho: number\r\n 386|   engagedSpace: number\r\n 387|   /** Caller-owned per-space depth in [0,1]; 1 only behind counted cutting engagement. */\r\n 388|   spaceDepth: Float32Array\r\n 389|   // chip (one restrained chip at the rake face; none during return)\r\n 390|   chipOpacity: number\r\n 391|   chipX: number\r\n 392|   chipY: number\r\n 393|   chipZ: number\r\n 394|   chipCurl: number\r\n 395|   // hob (machine frame, shaft-local mm)\r\n 396|   hobPhi: number\r\n 397|   hobWorkPhi: number\r\n 398|   hobRevRate: number\r\n 399|   hobYc: number\r\n 400|   /** Visual floor centre distance for progression.ts (equivalent meridian circle). */\r\n 401|   hobA: number\r\n 402|   /** Certified tool centre distance (10.1618 mm at full depth) plus radial offset. */\r\n 403|   hobToolA: number\r\n 404|   hobR: number\r\n 405|   // display-rate guard (30 fps lite floor)\r\n 406|   strokeHz: number\r\n 407|   gashHz: number\r\n 408|   softened: boolean\r\n 409| }\r\n 410| \r\n 411| export function createShaftKinematicsFrame(): ShaftKinematicsFrame {\r\n 412|   return {\r\n 413|     time: 0,\r\n 414|     machining: 0,\r\n 415|     machiningRate: 0,\r\n 416|     mode: 'none',\r\n 417|     followAzimuth: 0,\r\n 418|     followWeight: 0,\r\n 419|     cutterPhi: 0,\r\n 420|     workPhi: 0,\r\n 421|     strokeCentreY: 0,\r\n 422|     edgeY: 0,\r\n 423|     strokePhase: 0,\r\n 424|     cutting: false,\r\n 425|     returning: false,\r\n 426|     backoff: 0,\r\n 427|     cutterRho: SHAFT_OD_MM,\r\n 428|     engagedSpace: -1,\r\n 429|     spaceDepth: new Float32Array(SHAFT_SPACES),\r\n 430|     chipOpacity: 0,\r\n 431|     chipX: 0,\r\n 432|     chipY: 0,\r\n 433|     chipZ: 0,\r\n 434|     chipCurl: 0,\r\n 435|     hobPhi: 0,\r\n 436|     hobWorkPhi: 0,\r\n 437|     hobRevRate: 0,\r\n 438|     hobYc: HOB_INFEED_YC_MM,\r\n 439|     hobA: HOB_VISUAL_A_MM + HOB_RETRACT_MM,\r\n 440|     hobToolA: HOB_CENTRE_DISTANCE_AT_DEPTH_MM + HOB_RETRACT_MM,\r\n 441|     hobR: HOB_VISUAL_R_MM,\r\n 442|     strokeHz: 0,\r\n 443|     gashHz: 0,\r\n 444|     softened: false,\r\n 445|   }\r\n 446| }\r\n 447| \r\n 448| /** Write the frame's progression-compatible fields into a caller-owned ProgressionState. */\r\n 449| export function writeShaftProgression(frame: ShaftKinematicsFrame, state: ProgressionState): ProgressionState {\r\n 450|   state.mode = frame.mode\r\n 451|   state.engagedSpace = frame.engagedSpace\r\n 452|   // Count only contact events preceding THIS cutting stroke's stock entry. This retains\r\n 453|   // previous-pass material ahead of the edge both before and after the current event,\r\n 454|   // including a delayed entry event; an old angular-centre crossing is not a cut history.\r\n 455|   if (frame.engagedSpace >= 0) {\r\n 456|     const stockEntry = frame.machining - frame.strokePhase * STROKE_PERIOD_M + STOCK_ENTRY_PHASE * STROKE_PERIOD_M\r\n 457|     state.engagedPreviousDepth = Math.min(1, countedPasses(stockEntry, frame.engagedSpace) / SPACE_PASSES_REQUIRED)\r\n 458|   } else state.engagedPreviousDepth = 0\r\n 459|   state.edgeY = frame.edgeY\r\n 460|   // Tool withdrawal must not restore machined stock. Hold the swept envelope\r\n 461|   // once the certified feed reaches its stop; tool pose stays in the frame.\r\n 462|   state.hobYc = frame.time >= T_HOB_FEED_END ? HOB_STOP_YC_MM : frame.hobYc\r\n 463|   state.hobA = frame.time >= T_HOB_FEED_END ? HOB_VISUAL_A_MM : frame.hobA\r\n 464|   state.hobR = frame.hobR\r\n 465|   const depth = state.spaceDepth\r\n 466|   for (let i = 0; i < SHAFT_SPACES; i++) depth[i] = frame.spaceDepth[i]\r\n 467|   return state\r\n 468| }\r\n 469| \r\n 470| /** Closed-form sample of the full machining state. Writes only into out and returns it. */\r\n 471| export function sampleShaftKinematics(time: number, out: ShaftKinematicsFrame): ShaftKinematicsFrame {\r\n 472|   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time\r\n 473|   const m = machiningTimeAt(t)\r\n 474|   const rate = machiningRateAt(t)\r\n 475|   const shaping = t >= T_SHAPING_START && t < T_SHAPING_END\r\n 476|   const hobbing = t >= 25 && t < T_HOB_END\r\n 477| \r\n 478|   out.time = t\r\n 479|   out.machining = m\r\n 480|   out.machiningRate = rate\r\n 481|   out.mode = shaping ? 'shaping' : hobbing ? 'hobbing' : 'none'\r\n 482|   out.followAzimuth = FOLLOW_GAIN * followMfAt(t)\r\n 483|   out.followWeight = followWeightAt(t)\r\n 484| \r\n 485|   // shaper\r\n 486|   const mShaping = shaping || t < T_SHAPING_START ? m : t >= T_SHAPING_END ? MACHINING_AT_SHAPING_END : m\r\n 487|   const cutterPhi = CUTTER_RATE * mShaping\r\n 488|   const workPhi = SHAPER_SIGNED_RATIO * cutterPhi\r\n 489|   const phase = strokePhaseAt(mShaping)\r\n 490|   const cuttingStroke = phase < 0.5\r\n 491|   const yc = strokeCentreYAt(mShaping)\r\n 492|   const edgeY = yc + SHAPER_THICKNESS_MM * 0.5\r\n 493|   const backoff = backoffAt(mShaping)\r\n 494|   const infeedRho = infeedRhoAt(mShaping)\r\n 495|   out.cutterPhi = cutterPhi\r\n 496|   out.workPhi = workPhi\r\n 497|   out.strokeCentreY = yc\r\n 498|   out.edgeY = edgeY\r\n 499|   out.strokePhase = phase\r\n 500|   out.cutting = cuttingStroke\r\n 501|   out.returning = !cuttingStroke\r\n 502|   out.backoff = backoff\r\n 503|   out.cutterRho = infeedRho + backoff\r\n 504| \r\n 505|   for (let i = 0; i < SHAFT_SPACES; i++) {\r\n 506|     const depth = countedPasses(mShaping, i) / SPACE_PASSES_REQUIRED\r\n 507|     out.spaceDepth[i] = depth > 1 ? 1 : depth\r\n 508|   }\r\n 509|   // Groove overtravel is tool motion, not tooth-stock contact.\r\n 510|   const inStock = shaping && cuttingStroke && edgeY >= FACE_START_MM && edgeY <= SHAPING_FACE_END_MM\r\n 511|     && infeedRho < SHAFT_OD_MM - 1e-3\r\n 512|   if (inStock) {\r\n 513|     const raw = (MESH_AZ_RAD - SPACE_CLOCK_RAD - workPhi) / SPACE_PITCH_RAD\r\n 514|     const index = ((Math.round(raw) % SHAFT_SPACES) + SHAFT_SPACES) % SHAFT_SPACES\r\n 515|     out.engagedSpace = index\r\n 516|   } else {\r\n 517|     out.engagedSpace = -1\r\n 518|   }\r\n 519| \r\n 520|   // chip: only while stock is removed at the rake face; curls toward -X (surface motion at mesh)\r\n 521|   const chipActive = inStock && infeedRho < SHAFT_OD_MM - 1e-3 && mShaping > 0.02\r\n 522|   if (chipActive) {\r\n 523|     const u = phase * 2\r\n 524|     out.chipOpacity = 0.9 * Math.sin(Math.PI * u)\r\n 525|     out.chipX = -(CHIP_SEED * 0.4 + 0.55 * u)\r\n 526|     out.chipY = edgeY\r\n 527|     out.chipZ = infeedRho + 0.2 + 0.6 * u\r\n 528|     out.chipCurl = 0.8 + 2.4 * u\r\n 529|   } else {\r\n 530|     out.chipOpacity = 0\r\n 531|     out.chipX = 0\r\n 532|     out.chipY = edgeY\r\n 533|     out.chipZ = out.cutterRho\r\n 534|     out.chipCurl = 0\r\n 535|   }\r\n 536| \r\n 537|   // hob\r\n 538|   const hobYc = hobYcAt(t)\r\n 539|   const offA = hobRadialOffsetAt(t)\r\n 540|   const hobPhi = hobPhiAt(t)\r\n 541|   out.hobPhi = hobPhi\r\n 542|   out.hobWorkPhi = -hobPhi * (HOB_STARTS / SHAFT_SPACES)\r\n 543|   out.hobRevRate = hobRevRateAt(t)\r\n 544|   out.hobYc = hobYc\r\n 545|   out.hobA = HOB_VISUAL_A_MM + offA\r\n 546|   out.hobToolA = HOB_CENTRE_DISTANCE_AT_DEPTH_MM + offA\r\n 547|   out.hobR = HOB_VISUAL_R_MM\r\n 548| \r\n 549|   // display-rate guard\r\n 550|   const strokeHz = shaping ? rate / STROKE_PERIOD_M : 0\r\n 551|   const gashHz = shaping\r\n 552|     ? (SHAPER_TEETH * CUTTER_RATE / (2 * Math.PI)) * rate\r\n 553|     : hobbing\r\n 554|       ? HOB_FLUTES * out.hobRevRate\r\n 555|       : 0\r\n 556|   out.strokeHz = strokeHz\r\n 557|   out.gashHz = gashHz\r\n 558|   out.softened = strokeHz > SHAFT_MAX_FEATURE_HZ || gashHz > SHAFT_MAX_FEATURE_HZ\r\n 559|   return out\r\n 560| }\r\n 561| \r\n 562| /** Hob envelope top y (mm) at full length along its tilted axis; used for clearance checks. */\r\n 563| export function hobEnvelopeTopY(hobYc: number): number {\r\n 564|   const gamma = (HOB_LEAD_ANGLE_DEG * Math.PI) / 180\r\n 565|   return hobYc + (HOB_LENGTH_MM / 2) * Math.cos(gamma) + HOB_RADIUS_MM * Math.sin(gamma)\r\n 566| }\r\n","exit_code":0,"status":"completed"}}
