), events = Array.from({ length: 10 }, () => []), state = P.createProgressionState()\r\n  24| const failures = { stock: 0, nearest: 0, radial: 0, retained: 0, priorEvent: 0, aheadMask: 0 }, firstCompletion = Array(10).fill(null)\r\n  25| let gains = 0, disengagedIntervals = 0, returnPartialSamples = 0, previousT = 2, allCompleteAt = null, maxAheadError = 0\r\n  26| function contact(t) {\r\n  27|   const m = K.machiningTimeAt(t), unwrapped = m / K.STROKE_PERIOD_M + K.STROKE_PHASE_OFFSET, phase = unwrapped - Math.floor(unwrapped)\r\n  28|   const edge = T.SHAPER_STROKE_CENTRE_Y_MIN_MM + (T.SHAPER_STROKE_CENTRE_Y_MAX_MM - T.SHAPER_STROKE_CENTRE_Y_MIN_MM) * (1 - Math.cos(2 * Math.PI * phase)) / 2 + T.SHAPER_THICKNESS_MM / 2\r\n  29|   const cutterPhi = K.CUTTER_RATE * m, raw = Math.round((Math.PI / 2 - P.SPACE_CLOCK_RAD - T.SHAPER_SIGNED_RATIO * cutterPhi) / P.SPACE_PITCH_RAD), nearest = ((raw % 10) + 10) % 10\r\n  30|   return { m, phase, edge, nearest, stock: t < 15 && phase < .5 && edge >= P.FACE_START_MM && edge <= P.SHAPING_FACE_END_MM }\r\n  31| }\r\n  32| const hz = 19200, ticks = 13 * hz\r\n  33| for (let tick = 0; tick <= ticks; tick++) {\r\n  34|   const t = 2 + tick / hz; K.sampleShaftKinematics(t, f); const c = contact(t)\r\n  35|   let whollyDisengaged = true\r\n  36|   // Full interval plus three interior samples, not just two endpoint flags.\r\n  37|   for (let j = 0; j <= 4; j++) if (contact(previousT + (t - previousT) * j / 4).stock) whollyDisengaged = false\r\n  38|   if (whollyDisengaged) disengagedIntervals++\r\n  39|   for (let space = 0; space < 10; space++) {\r\n  40|     const depth = f.spaceDepth[space]\r\n  41|     if (depth > prior[space]) {\r\n  42|       gains++; let lo = previousT, hi = t\r\n  43|       const tmp = K.createShaftKinematicsFrame()\r\n  44|       for (let j = 0; j < 55; j++) { const mid = (lo + hi) / 2; K.sampleShaftKinematics(mid, tmp); if (tmp.spaceDepth[space] <= prior[space]) lo = mid; else hi = mid }\r\n  45|       const at = hi; K.sampleShaftKinematics(at, tmp); const event = contact(at)\r\n  46|       if (!event.stock) failures.stock++\r\n  47|       if (event.nearest !== space || tmp.engagedSpace !== space) failures.nearest++\r\n  48|       if (!(tmp.cutterRho < P.SHAFT_OD_MM - 1e-3)) failures.radial++\r\n  49|       events[space].push({ t: at, m: event.m, edge_mm: event.edge, phase: event.phase, depth, cutter_rho_mm: tmp.cutterRho })\r\n  50|     }\r\n  51|     if (whollyDisengaged && depth !== prior[space]) failures.retained++\r\n  52|     if (depth === 1 && firstCompletion[space] === null) firstCompletion[space] = t\r\n  53|     prior[space] = depth\r\n  54|   }\r\n  55|   if (f.returning && f.spaceDepth.some(d => d > 0 && d < 1)) returnPartialSamples++\r\n  56|   if (f.spaceDepth.every(d => d === 1) && allCompleteAt === null) allCompleteAt = t\r\n  57|   K.writeShaftProgression(f, state)\r\n  58|   if (f.engagedSpace >= 0) {\r\n  59|     const space = f.engagedSpace, strokeStart = c.m - c.phase * K.STROKE_PERIOD_M\r\n  60|     // Independent observed event history: no producer countedPasses or event table used.\r\n  61|     const expected = Math.min(1, events[space].filter(e => e.m < strokeStart).length / 4)\r\n  62|     if (state.engagedPreviousDepth !== expected) failures.priorEvent++\r\n  63|     const y = (f.edgeY + P.SHAPING_FACE_END_MM) / 2, r = P.progressedRadius(P.SHAFT_ROOT_MM, y, P.SPACE_CLOCK_RAD + space * P.SPACE_PITCH_RAD, state, 'legacy')\r\n  64|     const error = Math.abs((P.SHAFT_OD_MM - r) / (P.SHAFT_OD_MM - P.SHAFT_ROOT_MM) - expected); maxAheadError = Math.max(maxAheadError, error)\r\n  65|     if (error >= 0.5e-12) failures.aheadMask++\r\n  66|   }\r\n  67|   previousT = t\r\n  68| }\r\n  69| const hashes = Object.fromEntries(['src/scene/inspection/shaft/kinematics.ts', 'src/scene/inspection/shaft/kinematics.test.ts', 'src/scene/inspection/shaft/progression.ts', 'src/scene/inspection/shaft/camera.ts', 'src/scene/inspection/shaft/toolSpec.ts'].map(p => [p, crypto.createHash('sha256').update(fs.readFileSync(path.join(root, p))).digest('hex')]))\r\n  70| hashes['check-causality.mjs'] = crypto.createHash('sha256').update(fs.readFileSync(fileURLToPath(import.meta.url))).digest('hex')\r\n  71| const pass = gains === 40 && Object.values(failures).every(n => n === 0) && firstCompletion.every(t => t > 11 && t < 15)\r\n  72| const result = { pass, method: 'Independent cosine-stroke/nearest-space contact oracle; 55-step bisection at every observed depth gain; independently retained event history for previous-depth and CPU ahead-mask checks.', hz, samples: ticks + 1, intervalSamples: 5, gains, failures, disengagedIntervals, returnPartialSamples, allCompleteAt, firstCompletion, maxAheadError, events, hashes, reportedEarlyCases: [2.5, 2.512274, 2.52, 2.55].map(t => { K.sampleShaftKinematics(t, f); return { t, edge: f.edgeY, engaged: f.engagedSpace, depths: [...f.spaceDepth] } }) }\r\n  73| fs.writeFileSync(path.join(out, 'causal-sweep.json'), JSON.stringify(result, null, 2) + '\\n')\r\n  74| console.log(JSON.stringify({ pass, samples: result.samples, gains, failures, disengagedIntervals, returnPartialSamples, allCompleteAt, maxAheadError, source_sha256: hashes['src/scene/inspection/shaft/kinematics.ts'] }, null, 2))\r\n  75| if (!pass) process.exitCode = 1\r\n","exit_code":0,"status":"completed"}}
