'narrow' : 'desktop'}-${kind}`, gates: {}, measures: {} }; report.cases.push(r)\r\n 647|   let session\r\n 648|   try {\r\n 649|     session = await fresh(r); const { page } = session\r\n 650|     await step(r, gate, async () => {\r\n 651|       const trigger = page.getByRole('button', { name: 'Inspect the input shaft' })\r\n 652|       if (kind === 'denied-fetch') {\r\n 653|         const denied = []\r\n 654|         const abort = route => { denied.push(route.request().url()); return route.abort('failed') }\r\n 655|         await page.route('**/models/manufacturing-core-*.glb', abort)\r\n 656|         await trigger.click(); await page.getByRole('dialog').waitFor()\r\n 657|         await page.waitForFunction(() => window.__inspection?.status === 'error', null, { timeout: 120000 })\r\n 658|         const failed = await read(page)\r\n 659|         assertion(r, gate, denied.length > 0 && !failed.probe.playing && failed.probe.suspend === 'error', `denied shaft error state ${JSON.stringify(failed.probe)}`)\r\n 660|         const visibleError = page.getByRole('dialog').locator('p[role=\"status\"]').filter({ hasText: 'The study could not load. Return or try again.' })\r\n 661|         const errorCount = await visibleError.count(), errorVisible = errorCount === 1 && await visibleError.isVisible(), errorText = errorCount === 1 ? await visibleError.textContent() : null\r\n 662|         assertion(r, gate, errorVisible && errorText === 'The study could not load. Return or try again.', `denied load has no visible exact error content: ${JSON.stringify({ errorVisible, errorText })}`, { file: 'src/components/RingInspection.tsx', line: 165 })\r\n 663|         await page.screenshot({ path: path.join(out, `${r.name}-visible-error.png`) })\r\n 664|         assertion(r, gate, await page.getByRole('button', { name: 'Try again', exact: true }).isEnabled(), 'retry unavailable after denied shaft load')\r\n 665|         await leave(page)\r\n 666|         assertion(r, gate, await trigger.evaluate(b => document.activeElement === b), 'denied shaft Return focus not restored')\r\n 667|         await trigger.click(); await page.getByRole('dialog').waitFor(); await page.waitForFunction(() => window.__inspection.status === 'error', null, { timeout: 120000 })\r\n 668|         await page.unroute('**/models/manufacturing-core-*.glb', abort)\r\n 669|         await page.getByRole('button', { name: 'Try again', exact: true }).click()\r\n 670|         await page.waitForFunction(() => window.__inspection.status === 'ready', null, { timeout: 120000 }); await settle(page, 0)\r\n 671|         const recovered = await read(page)\r\n 672|         assertion(r, gate, recovered.probe.loaded && recovered.probe.kind === 'shaft', 'retry did not recover the shaft runtime')\r\n 673|         await leave(page)\r\n 674|         // Only the network errors tied to deliberately denied URLs are expected.\r\n 675|         r.expectedErrors = r.errors.filter(e => e.type === 'console' && denied.includes(e.location?.url) && /Failed to load resource: net::ERR_FAILED/.test(e.text))\r\n 676|         r.errors = r.errors.filter(e => !r.expectedErrors.includes(e))\r\n 677|         r.measures = { denied, failed, recovered, visibleError: { visible: errorVisible, text: errorText, file: `${r.name}-visible-error.png` } }\r\n 678|       } else if (kind === 'late-successful-bytes') {\r\n 679|         await page.evaluate(() => { const original = Response.prototype.arrayBuffer; window.__shaftByteGate = { armed: true, pending: false, released: false }; Response.prototype.arrayBuffer = async function(...args) { const data = await original.apply(this, args); const gate = window.__shaftByteGate; if (gate.armed && this.url.includes('manufacturing-core')) { gate.armed = false; gate.pending = true; gate.bytes = data.byteLength; await new Promise(resolve => { gate.release = () => { gate.released = true; resolve() } }) } return data } })\r\n 680|         await trigger.click(); await page.getByRole('dialog').waitFor(); await page.waitForFunction(() => window.__shaftByteGate.pending, null, { timeout: 30000 })\r\n 681|         const epochA = await page.evaluate(() => window.__inspection.session)\r\n 682|         await leave(page)\r\n 683|         await enter(page); await seek(page, 8.4)\r\n 684|         const before = await read(page), beforeCensus = await census(page)\r\n 685|         const sceneCensus = () => page.evaluate(() => { let roots = 0, meshes = 0; window.__threeScene.traverse(o => { if (o.name === 'manufacturing-study-root') roots++; if (o.isMesh) meshes++ }); return { roots, meshes } })\r\n 686|         const beforeScene = await sceneCensus()\r\n 687|         await page.evaluate(() => window.__shaftByteGate.release()); await page.waitForTimeout(800)\r\n 688|         const after = await read(page), afterCensus = await census(page), afterScene = await sceneCensus()\r\n 689|         const cameraDelta = Math.max(...before.renderFrame.matrix.map((v, i) => Math.abs(v - after.renderFrame.matrix[i])))\r\n 690|         const byteGate = await page.evaluate(() => ({ released: window.__shaftByteGate.released, bytes: window.__shaftByteGate.bytes }))\r\n 691|         assertion(r, gate, byteGate.released && byteGate.bytes > 0, 'late successful shaft bytes were not delivered')\r\n 692|         assertion(r, gate, before.probe.session > epochA && after.probe.session === before.probe.session && after.probe.status === 'ready' && after.probe.kind === 'shaft', 'late success corrupted new shaft epoch')\r\n 693|         const censusFields = c => ({ geometries: c.geometries, textures: c.textures, programs: c.programs })\r\n 694|         assertion(r, gate, cameraDelta === 0 && JSON.stringify(beforeScene) === JSON.stringify(afterScene) && beforeScene.roots === 1 && JSON.stringify(censusFields(beforeCensus)) === JSON.stringify(censusFields(afterCensus)), `late success changed camera/resources ${cameraDelta}/${JSON.stringify({ beforeScene, afterScene, beforeCensus, afterCensus })}`)\r\n 695|     