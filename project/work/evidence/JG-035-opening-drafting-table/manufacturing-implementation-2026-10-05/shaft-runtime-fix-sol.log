+          expect(f.engagedSpace).toBe(space)
+          expect(f.edgeY).toBeLessThan(SHAPING_FACE_END_MM)
+          writeShaftProgression(f, state); writeProgressionUniforms(uniforms, state, 'legacy')
+          const previous = (pass - 1) / SPACE_PASSES_REQUIRED
