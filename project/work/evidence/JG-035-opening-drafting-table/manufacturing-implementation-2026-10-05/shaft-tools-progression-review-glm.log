  applyProgression,
  createProgressionState,
  createProgressionUniforms,
  FACE_START_MM,
  HOBBING_FACE_END_MM,
  HOB_FINAL_YC_MM,
  HOB_INFEED_YC_MM,
  HOB_VISUAL_A_MM,
