+      // swept machining envelope are distinct; preserve the completed feed endpoint.
+      if (t >= 30.2) { approvedState.hobYc = HOB_FINAL_YC_MM; approvedState.hobA = HOB_VISUAL_A_MM }
+      frame.time = t; frame.phase = schedule.beat; frame.discrete = schedule.beatIndex
+      frame.chapter = t < 15 ? 0 : t < 22.6 ? 1 : t < 35 ? 2 : 3
