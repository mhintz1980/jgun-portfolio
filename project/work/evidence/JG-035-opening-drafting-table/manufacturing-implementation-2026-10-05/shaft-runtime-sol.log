+      }
+      stress.kind = script.stress; stress.mix = script.stressMix; stress.scanProgress = script.scanProgress
+      stress.yMin = script.stress === 'warm' ? SHAPING_FACE_END_MM : HOBBING_FACE_END_MM
+      stress.yMax = script.stress === 'warm' ? 12 : 17
