+        cap.position.copy(mesh.position); cap.quaternion.copy(mesh.quaternion); cap.scale.copy(mesh.scale)
+        mesh.parent?.add(cap); cap.visible = false; part.caps.push(cap); resources.meshes++
+      }
+    }
