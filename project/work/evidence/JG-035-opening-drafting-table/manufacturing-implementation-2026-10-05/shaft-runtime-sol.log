+    const times = [0, 1.2, 2, 6, 8.4, 11, 14.99, 15, 16.3, 22.6, 23.8, 25, 28, 30.2, 31.6, 32, 32.8, 35, 36.6, 37.6, 39, 40.5, 43]
+    const expected = times.map(t => digest(runtime, t))
