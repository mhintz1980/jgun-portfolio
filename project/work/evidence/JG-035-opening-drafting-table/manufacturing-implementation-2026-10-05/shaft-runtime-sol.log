+  const toShaft = studyToShaftLocal(new Matrix4()), matrix = new Matrix4(), delta = new Vector3()
+  const wipeLegacy = new Plane(new Vector3(0, 0, -1), 0), wipeApproved = new Plane(new Vector3(0, 0, 1), 0)
