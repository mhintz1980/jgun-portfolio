+    cutter: { visible: false, stroke: 0, infeed: 0, rotation: 0, softened: false },
+    hob: { visible: false, feed: 0, rotation: 0, softened: false },
+    card: { id: script.card, stamp: script.stamp }, stress: { kind: script.stress, mix: 0 },
