+
+  runtime = {
+    root, ready, frame, camera, render, resources,
+    sample(time) {
+      if (disposed) return
+      sampleShaftSchedule(time, schedule)
+      const t = schedule.time
+      sampleShaftKinematics(t, kinematics); sampleShaftScript(t, false, script)
