+  function collect(object: Object3D, shared = false): void {
+    object.traverse(child => {
+      if (!(child instanceof Mesh)) return
+      if (shared) sharedGeometry.add(child.geometry); else ownedGeometry.add(child.geometry)
+      resources.meshes++
