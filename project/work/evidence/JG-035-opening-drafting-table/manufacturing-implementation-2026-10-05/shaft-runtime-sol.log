+  function attachPart(node: Object3D, name: string, kind?: ProgressionShaft): Part {
+    const group = new Group(); group.name = 'study-' + name
+    group.add(node); (name === 'approvedbearing' || name === 'approvedring' ? supportPair : root).add(group)
