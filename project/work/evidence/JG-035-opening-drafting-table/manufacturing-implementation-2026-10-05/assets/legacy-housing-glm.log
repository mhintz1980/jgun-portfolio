import bpy, json, math
import numpy as np
from mathutils import Matrix

def arr(o):
    m = o.data
    v = np.empty(len(m.vertices)*3, dtype=np.float32)
    m.vertices.foreach_get('co', v)
    return v.reshape(-1,3).astype(np.float64)*1000.0

def tris(o):
    o.data.calc_loop_triangles()
    return len(o.data.loop_triangles)

def segments(verts, tris_idx, y):
    p = verts[tris_idx]
    d = p[:,:,1]-y
    cross = np.flatnonzero((d.min(axis=1)<-1e-12)&(d.max(axis=1)>1e-12))
    n = 0
    radii = []
    for ti in cross:
        pts=[]
        pd, dd = p[ti], d[ti]
        for a,b in ((0,1),(1,2),(2,0)):
            da,db = dd[a],dd[b]
            if (da<0<db) or (db<0<da):
                t = da/(da-db)
                pts.append(pd[a]+(pd[b]-pd[a])*t)
        if len(pts)==2:
            n+=1
            radii.append(np.hypot(pts[0][0],pts[0][2])); radii.append(np.hypot(pts[1][0],pts[1][2]))
    return n, (float(min(radii)), float(max(radii))) if radii else None

out = {}
lo = bpy.data.objects['HOUSING_P000725_ORIG']; nw = bpy.data.objects['housing_NEW']
a, b = arr(lo), arr(nw)
d = b - a
dist = np.linalg.norm(d, axis=1)
seat = np.flatnonzero(np.abs(dist - 2.75) <= 0.005)
co = np.flatnonzero(dist <= 0.005)
out['ident'] = {n: bool(o.matrix_world == Matrix.Identity(4)) for n,o in (('orig',lo),('new',nw),('bearing',bpy.data.objects['BEARING_K000210_ORIG']))}
out['counts'] = dict(orig_verts=len(a), new_verts=len(b), orig_tris=tris(lo), new_tris=tris(nw))
out['vertex_classes'] = dict(seat=int(len(seat)), coincident=int(len(co)), other=int(len(a)-len(seat)-len(co)))
if len(seat):
    out['seat'] = dict(y_min=float(a[seat][:,1].min()), y_max=float(a[seat][:,1].max()),
                       y_mode=float(np.median(a[seat][:,1])),
                       delta_mean_mm=d[seat].mean(axis=0).tolist(),
                       delta_max_dev_mm=float(np.abs(d[seat]-np.array([0,2.75,0])).max()))
