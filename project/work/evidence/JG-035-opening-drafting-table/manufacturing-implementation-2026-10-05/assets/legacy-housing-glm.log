+def housing_seat_delta(mesh_a, mesh_l):
+    """Per-vertex approved-minus-legacy delta (mm), seat mask and classification."""
+    a = coordinates(mesh_a).astype(np.float64) * 1000.0
+    l = coordinates(mesh_l).astype(np.float64) * 1000.0
