+    delta = a - l
+    distance = np.linalg.norm(delta, axis=1)
+    seat = np.abs(distance - HOUSING_SHIFT_MM) <= 0.001
+    coincident = distance <= 0.001
+    other = len(a) - int(seat.sum()) - int(coincident.sum())
+    if other or not seat.any():
