+    down = Vector((0.0, -HOUSING_SHIFT_MM, 0.0))
+
+    def classify(points, tree, shift):
+        counts = dict(coincident=0, seat=0, unmatched=0)
+        for point in points:
+            if tree.find(Vector(point))[2] <= 0.005:
+                counts['coincident'] += 1
+            elif tree.find(Vector(point) + shift)[2] <= 0.005:
+                counts['seat'] += 1
+            else:
+                counts['unmatched'] += 1
