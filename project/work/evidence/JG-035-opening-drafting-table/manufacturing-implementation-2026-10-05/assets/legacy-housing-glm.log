import bpy, json, math
import numpy as np
from mathutils import Vector
from mathutils.kdtree import KDTree
from mathutils.bvhtree import BVHTree
import bmesh

SEAT_YS = (13.0, 14.5, 16.0, 16.7327)
SHIFT = 2.75

def coords(mesh):
    v = np.empty(len(mesh.vertices)*3, dtype=np.float32)
    mesh.vertices.foreach_get('co', v)
    return v.reshape(-1,3).astype(np.float64)

def mm(mesh): return coords(mesh)*1000.0

def tri_idx(mesh):
    mesh.calc_loop_triangles()
    return np.array([t.vertices[:] for t in mesh.loop_triangles], dtype=np.int64)

def clean(mesh, dist):
    bm = bmesh.new(); bm.from_mesh(mesh)
    bmesh.ops.remove_doubles(bm, verts=list(bm.verts), dist=dist)
    seen, dup = set(), []
    bm.verts.index_update()
    for f in bm.faces:
        key = tuple(sorted(v.index for v in f.verts))
        if key in seen: dup.append(f)
        seen.add(key)
    if dup: bmesh.ops.delete(bm, geom=dup, context='FACES_ONLY')
    bmesh.ops.recalc_face_normals(bm, faces=list(bm.faces))
    out = bpy.data.meshes.new('probe_clean'); bm.to_mesh(out); bm.free(); out.update()
    return out

def segments(verts, tri, y):
    p = verts[tri]; d = p[:,:,1]-y
    cross = np.flatnonzero((d.min(axis=1)<-1e-12)&(d.max(axis=1)>1e-12))
    segs = np.zeros((max(len(cross),1),2,3), dtype=np.float64); n=0
    for ti in cross:
        pts=[]; pd,dd=p[ti],d[ti]
        for a,b in ((0,1),(1,2),(2,0)):
            da,db=dd[a],dd[b]
            if (da<0<db) or (db<0<da):
                t=da/(da-db); pts.append(pd[a]+(pd[b]-pd[a])*t)
        if len(pts)==2 and np.linalg.norm(pts[0]-pts[1])>1e-9:
            segs[n]=pts; n+=1
    return segs[:n]

def polyline_points(segs, spacing=0.01):
    a,b = segs[:,0], segs[:,1]
    lengths = np.linalg.norm(b-a, axis=1)
    counts = np.maximum(1, np.ceil(lengths/spacing).astype(np.int64))
    parts=[a,b]
    for k in np.unique(counts):
        idx = counts==k
        t=(np.arange(k+1,dtype=np.float64)/k)[None,:,None]
        parts.append((a[idx][:,None,:]+(b[idx]-a[idx])[:,None,:]*t).reshape(-1,3))
    return np.concatenate(parts,axis=0)

def dir_max(points, segs, chunk=256):
    a=segs[:,0]; ab=segs[:,1]-segs[:,0]
    denom=np.einsum('ij,ij->i',ab,ab); denom[denom==0]=1.0
    best=0.0
    for s in range(0,len(points),chunk):
        q=points[s:s+chunk]
        e=q[:,None,:]-a[None,:,:]
        t=np.clip(np.einsum('qsi,si->qs',e,ab)/denom[None,:],0.0,1.0)
        dist=np.sqrt(((e-t[:,:,None]*ab[None,:,:])**2).sum(axis=2)).min(axis=1)
        best=max(best,float(dist.max()))
    return best

def sym_haus(sa, sb):
    if len(sa)==0 or len(sb)==0: return None
    return max(dir_max(polyline_points(sa), sb), dir_max(polyline_points(sb), sa))

def guard_bits(co):
    bounds=[co.min(axis=0), co.max(axis=0)]
    g=np.zeros(len(co),dtype=bool)
    for i in range(3):
        for s in (0,1):
            g |= np.abs(co[:,i]-bounds[s][i])<=1e-3
    return g

def surface_err(mesh_a, mesh_b):
    def mk(m):
        m.calc_loop_triangles()
        return BVHTree.FromPolygons([v.co for v in m.vertices], [tuple(t.vertices) for t in m.loop_triangles], all_triangles=True), coords(m)
    ba, ca = mk(mesh_a); bb, cb = mk(mesh_b)
    def directed(pts, bvh):
        mx=0.0
        for p in pts:
            d = bvh.find_nearest(Vector(p))
            if d[0] is not None: mx=max(mx, d[3]*1000.0)
        return mx
    cent_a = ca[np.array([t.vertices[:] for t in mesh_a.loop_triangles]).mean(axis=1).astype(np.int64)] if False else None
    ta = np.array([t.vertices[:] for t in mesh_a.loop_triangles], dtype=np.int64)
    tb = np.array([t.vertices[:] for t in mesh_b.loop_triangles], dtype=np.int64)
    ca_pts = ca[ta].mean(axis=1); cb_pts = cb[tb].mean(axis=1)
    return max(directed(np.vstack([ca, ca_pts]), bb), directed(np.vstack([cb, cb_pts]), ba))

def reduce_housing(mesh_a_src, target, rad, seat_pos_m, delta_mm):
    obj = bpy.data.objects.new('h_red', mesh_a_src.copy())
    bpy.context.scene.collection.objects.link(obj)
    bpy.context.view_layer.objects.active = obj; obj.select_set(True)
    t0 = len(tri_idx(obj.data))
    if t0 > target:
        m=obj.modifiers.new('dissolve','DECIMATE'); m.decimate_type='DISSOLVE'; m.angle_limit=rad; m.use_dissolve_boundaries=False
        bpy.ops.object.modifier_apply(modifier=m.name)
    t1 = len(tri_idx(obj.data))
    kd = KDTree(len(seat_pos_m))
    for i,p in enumerate(seat_pos_m): kd.insert(Vector(p), i)
    kd.balance()
    def alive_map(mesh):
        co = mm(mesh); alive=np.zeros(len(co),dtype=bool); idx=np.full(len(co),-1,dtype=np.int64)
        for i,p in enumerate(co):
            hit = kd.find(Vector(p/1000.0))
            if hit[0] is not None and hit[2] <= 1e-9:
                alive[i]=True; idx[i]=hit[1]
        return alive, idx
    collapsed=False
    if t1 > target:
        alive,_ = alive_map(obj.data)
        guarded = guard_bits(mm(obj.data))
        pool=[v.index for v in obj.data.vertices if not guarded[v.index] and not alive[v.index]]
        g=obj.vertex_groups.new(name='pool'); g.add(pool,1.0,'REPLACE')
        m=obj.modifiers.new('collapse','DECIMATE'); m.decimate_type='COLLAPSE'; m.ratio=target/t1; m.vertex_group=g.name; m.vertex_group_factor=1.0; m.use_collapse_triangulate=True
        bpy.ops.object.modifier_apply(modifier=m.name)
        obj.vertex_groups.clear()
        collapsed=True
    out = obj.data.copy()
    alive2, idx2 = alive_map(out)
    bpy.data.objects.remove(obj, do_unlink=True)
    legacy = out.copy()
    bm = bmesh.new(); bm.from_mesh(legacy)
    seat_cols = np.array([c for c in delta_mm], dtype=np.float64)  # full per-vertex delta, index = source seat order
    moved=0
    for v in bm.verts:
        i = v.index
        if alive2[i]:
            src = idx2[i]
            d = seat_cols[src]/1000.0
            v.co = Vector((v.co.x-d[0], v.co.y-d[1], v.co.z-d[2]))
            moved+=1
    bm.to_mesh(legacy); bm.free(); legacy.update()
    return out, legacy, dict(tris_before=t0, tris_after_dissolve=t1, tris_final=len(tri_idx(out)), collapse_used=collapsed, seat_vertices_surviving=int(alive2.sum()))

out = {}
lo = bpy.data.objects['HOUSING_P000725_ORIG']; nw = bpy.data.objects['housing_NEW']
orig_l = lo.data.copy(); orig_a = nw.data.copy()
cl_l = clean(orig_l, 5e-6); cl_a = clean(orig_a, 5e-6)
a = mm(cl_a); l = mm(cl_l)
out['clean'] = dict(verts=[len(a), len(l)], tris=[len(tri_idx(cl_a)), len(tri_idx(cl_l))])
if len(a) "'!= len(l):
    out['"'clean']['correspondence'] = 'VERT COUNT MISMATCH'
    print('PROBE2 ' + json.dumps(out), flush=True); raise SystemExit
delta = a - l
dist = np.linalg.norm(delta, axis=1)
seat = np.abs(dist - SHIFT) <= 0.001
co = dist <= 0.001
out['clean']['classification'] = dict(seat=int(seat.sum()), coincident=int(co.sum()), other=int(len(a)-seat.sum()-co.sum()))
if out['clean']['classification']['other'] "'!= 0 or not seat.any():
    print('"'PROBE2 ' + json.dumps(out), flush=True); raise SystemExit
seat_pos_m = (a[seat]/1000.0).tolist()
seat_delta_mm = delta[seat]
refs = {}
for name, m in (('approved', cl_a), ('legacy', cl_l)):
    v = mm(m); t = tri_idx(m)
    refs[name] = {y: segments(v, t, y) for y in SEAT_YS}
results = {}
for tier, target, rads in (('full', 15000, (0.001, 0.002)), ('lite', 9000, (0.005, 0.01, 0.02))):
    rows=[]
    for rad in rads:
        ra, rl, rec = reduce_housing(cl_a, target, rad, seat_pos_m, seat_delta_mm)
        fid_a = {y: sym_haus(refs['approved'][y], segments(mm(ra), tri_idx(ra), y)) for y in SEAT_YS}
        fid_l = {y: sym_haus(refs['legacy'][y], segments(mm(rl), tri_idx(rl), y)) for y in SEAT_YS}
        surf_a = surface_err(orig_a, ra); surf_l = surface_err(orig_l, rl)
        rows.append(dict(rad=rad, **rec,
                         hausdorff_approved={str(k): round(v,5) for k,v in fid_a.items()},
                         hausdorff_legacy={str(k): round(v,5) for k,v in fid_l.items()},
                         seat_max=max(max(fid_a.values()), max(fid_l.values())),
                         surface_err_max=max(surf_a, surf_l)))
        bpy.data.meshes.remove(ra); bpy.data.meshes.remove(rl)
    results[tier]=rows
out['reduction']=results
print('PROBE2 ' + json.dumps(out), flush=True)

