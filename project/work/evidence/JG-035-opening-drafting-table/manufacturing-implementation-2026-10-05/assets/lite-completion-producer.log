+        t = (np.arange(k + 1, dtype=np.float64) / k)[None, :, None]
+        parts.append((a[idx][:, None, :] + (b[idx] - a[idx])[:, None, :] * t).reshape(-1, 3))
+    return np.concatenate(parts, axis=0)
