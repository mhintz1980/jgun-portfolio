-def reduce_shaft(mesh, target):
-    mesh.calc_loop_triangles()
-    vertices = [v.co[:] for v in mesh.vertices]
-    triangles = [tuple(t.vertices) for t in mesh.loop_triangles]
-    protected, working = [], []
-    for tri in triangles:
-        ys = [vertices[i][1] * 1000 for i in tri]
-        keep = max(ys) <= 9.55 or (min(ys) >= 14.18 and max(ys) <= 20) or any(abs(y-8.9) < .0001 for y in ys)
-        (protected if keep else working).append(tri)
-    print('HARD_PROTECTED '+json.dumps(dict(target=target, triangles=len(protected), working=len(working))), flush=True)
-    if len(protected) >= target:
-        raise RuntimeError('Hard protected shaft features alone exceed target')
-    used = sorted({i for tri in working for i in tri})
-    mapping = {old:new for new,old in enumerate(used)}
-    temporary = bpy.data.meshes.new('unprotected_surface')
-    temporary.from_pydata([vertices[i] for i in used], [], [tuple(mapping[i] for i in tri) for tri in working])
-    reduced = decimate(temporary, target-len(protected), 'runout_reduction')
-    reduced.calc_loop_triangles()
-    combined = bpy.data.meshes.new('protected_profile_shaft')
-    combined.from_pydata(vertices + [v.co[:] for v in reduced.vertices], [],
-                         protected + [tuple(len(vertices)+i for i in t.vertices) for t in reduced.loop_triangles])
-    return combined
-
