+        u = np.stack([np.cos(ang), np.sin(ang)], axis=1)
+        ua = u[:, None, 0] * a[None, :, 1] - u[:, None, 1] * a[None, :, 0]
+        ud = u[:, None, 0] * d[None, :, 1] - u[:, None, 1] * d[None, :, 0]
