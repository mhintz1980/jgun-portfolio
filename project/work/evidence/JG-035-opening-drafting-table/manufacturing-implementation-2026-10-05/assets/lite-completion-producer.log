+    segs = np.zeros((len(crossing), 2, 3), dtype=np.float64)
+    for row, ti in enumerate(crossing):
+        pts = []
+        pd, dd = p[ti], d[ti]
+        for a, b in ((0, 1), (1, 2), (2, 0)):
+            da, db = dd[a], dd[b]
+            if (da < 0.0 < db) or (db < 0.0 < da):
+                t = da / (da - db)
+                pts.append(pd[a] + (pd[b] - pd[a]) * t)
