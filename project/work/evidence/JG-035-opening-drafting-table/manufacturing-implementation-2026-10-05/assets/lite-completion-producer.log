+def radial_first_hit_mm(segs, angles, chunk=512):
+    """First-hit radius from the axis for each angle, exact 2D ray vs section polyline."""
+    a = segs[:, 0][:, [0, 2]]
+    d = segs[:, 1][:, [0, 2]] - a
