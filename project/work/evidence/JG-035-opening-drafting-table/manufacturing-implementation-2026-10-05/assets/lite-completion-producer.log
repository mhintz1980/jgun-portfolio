+def profile_weight(profile, y_mm):
+    if 3.0 <= y_mm < 9.6:
+        return profile['tooth']
+    if 9.6 <= y_mm < 14.1:
+        return profile['ramp']
+    if 14.1 <= y_mm <= 20.0:
+        return profile['journal']
+    return profile['body']
+
