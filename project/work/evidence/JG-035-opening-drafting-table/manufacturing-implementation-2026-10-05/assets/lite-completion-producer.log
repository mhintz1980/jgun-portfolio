+    ab = segs[:, 1] - segs[:, 0]
+    denom = np.einsum('ij,ij->i', ab, ab)
+    denom[denom == 0.0] = 1.0
+    best = 0.0
+    for start in range(0, len(points), chunk):
+        q = points[start:start + chunk]
+        e = q[:, None, :] - a[None, :, :]
+        t = np.clip(np.einsum('qsi,si->qs', e, ab) / denom[None, :], 0.0, 1.0)
+        dist = np.sqrt(((e - t[:, :, None] * ab[None, :, :]) ** 2).sum(axis=2)).min(axis=1)
