+def reduce_shaft(mesh, target, profile):
+    """Whole-mesh, seam-free reduction with priority-ordered victim weights.
+
+    The mesh is never split, so no recombination seam can open. Planar redundancy
+    dissolves first; one ratio collapse follows in which ungrouped feature
+    vertices survive longest and victim weights order what collapses first.
+    Nothing here trusts the decimator metric for fidelity: callers measure the
+    result against the assembled source and gate publication on the bound.
+    """
+    obj = bpy.data.objects.new('shaft_reduction', mesh.copy())
+    bpy.context.scene.collection.objects.link(obj)
+    bpy.context.view_layer.objects.active = obj
+    obj.select_set(True)
+    triangles = census(obj.data)['triangles']
+    if triangles > target:
+        planar = obj.modifiers.new('planar_redundancy', 'DECIMATE')
+        planar.decimate_type = 'DISSOLVE'
+        planar.angle_limit = profile['dissolve_rad']
+        planar.use_dissolve_boundaries = False
+        bpy.ops.object.modifier_apply(modifier=planar.name)
+        triangles = census(obj.data)['triangles']
+        print('DISSOLVE '+profile['name']+' triangles='+str(triangles), flush=True)
+    if triangles > target:
+        co = coordinates(obj.data).astype(np.float64) * 1000.0
+        # Silhouette guard: vertices defining the six bounds extremes never collapse.
+        bounds = [co.min(axis=0), co.max(axis=0)]
+        guarded = np.zeros(len(co), dtype=bool)
+        for i in range(3):
+            for side in (0, 1):
+                guarded |= np.abs(co[:, i] - bounds[side][i]) <= 1e-3
+        buckets = {}
+        for v in obj.data.vertices:
+            if guarded[v.index]:
