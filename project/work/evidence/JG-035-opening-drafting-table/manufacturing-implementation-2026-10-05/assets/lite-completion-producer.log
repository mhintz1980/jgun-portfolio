+def polyline_points(segs, spacing_mm=POLYLINE_SPACING_MM):
+    a, b = segs[:, 0], segs[:, 1]
+    lengths = np.linalg.norm(b - a, axis=1)
+    counts = np.maximum(1, np.ceil(lengths / spacing_mm).astype(np.int64))
+    parts = [a, b]
+    for k in np.unique(counts):
+        idx = counts == k
+        t = (np.arange(k + 1, dtype=np.float64) / k)[:, None]
+        parts.append((a[idx] + (b[idx] - a[idx]) * t).reshape(-1, 3))
+    return np.concatenate(parts, axis=0)
 
 
