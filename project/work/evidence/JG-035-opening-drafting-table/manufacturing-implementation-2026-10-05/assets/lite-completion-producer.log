bpy.ops.wm.open_mainfile(filepath=str(es.SOURCE))
src = bpy.data.objects['SHAFT_P001835_HOBBED_NEW'].data.copy()
cleaned, _ = es.approved_topology(src)
cleaned.calc_loop_triangles()
import numpy as np
tri = np.array([t.vertices[:] for t in cleaned.loop_triangles])
co = es.coordinates(cleaned).astype(np.float64) * 1000.0
ys = co[tri][:, :, 1]
bands = dict(below3=(None, 3.0), tooth=(3.0, 9.6), ramp=(9.6, 14.1), journal=(14.1, 20.0), above20=(20.0, None))
counts = {}
for name, (lo, hi) in bands.items():
    m = np.ones(len(tri), dtype=bool)
    if lo is not None: m &= ys.min(axis=1) >= lo
    if hi is not None: m &= ys.max(axis=1) <= hi
    counts[name] = int(m.sum())
print('REGION_COUNTS ' + json.dumps(counts), flush=True)
for angle in (0.001, 0.002, 0.005, 0.01, 0.02):
