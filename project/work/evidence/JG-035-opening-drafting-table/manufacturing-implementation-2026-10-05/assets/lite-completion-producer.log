+                         clock_delta_degrees=fid['tooth']['clock_delta_degrees'],
+                         within_limit=fidelity_ok(fid, limit, size)))
+        bpy.data.meshes.remove(best['mesh'])
+        print('CURVE '+json.dumps(rows[-1]), flush=True)
+    return rows
 
 
