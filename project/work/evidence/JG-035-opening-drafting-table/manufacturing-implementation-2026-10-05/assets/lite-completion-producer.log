+RAMP_YS = tuple(sorted({round(float(y), 3) for y in np.arange(9.55, 13.7501, 0.1)} | {13.78}))
+ALL_SECTION_YS = tuple(sorted({round(float(y), 4) for y in SECTION_YS} | {round(float(y), 4) for y in RAMP_YS}))
+TOOTH_Y_MM = 6.0
