+    counts = np.maximum(1, np.ceil(lengths / spacing_mm).astype(np.int64))
+    parts = [a, b]
+    for k in np.unique(counts):
+        idx = counts == k
+        t = (np.arange(k + 1, dtype=np.float64) / k)[None, :, None]
+        parts.append((a[idx][:, None, :] + (b[idx] - a[idx])[:, None, :] * t).reshape(-1, 3))
