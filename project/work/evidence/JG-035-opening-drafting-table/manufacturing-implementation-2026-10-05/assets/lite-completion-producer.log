+def reduce_shaft(mesh, target, profile):
+    """Whole-mesh, seam-free reduction with priority-ordered victim weights.
+
+    The mesh is never split, so no recombination seam can open. Planar redundancy
+    dissolves first; one ratio collapse follows in which ungrouped feature
+    vertices survive longest and victim weights order what collapses first.
+    Nothing here trusts the decimator metric for fidelity: callers measure the
+    result against the assembled source and gate publication on the bound.
+    """
+    obj = bpy.data.objects.new('shaft_reduction', mesh.copy())
+    bpy.context.scene.collection.objects.link(obj)
+    bpy.context.view_layer.objects.active = obj
