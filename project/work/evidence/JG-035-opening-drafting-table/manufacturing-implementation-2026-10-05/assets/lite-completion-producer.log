+                clock_delta_degrees=round(float(modulo), 6),
+                misses=int(np.isnan(a).sum() + np.isnan(b).sum()),
+                sampling_degrees=SAMPLING_DEG, pitch_degrees=TOOTH_PITCH_DEG)
+
