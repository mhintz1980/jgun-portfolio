+                and tooth['clock_delta_degrees'] == 0.0 and tooth['misses'] == 0
+                and fid['runout']['max_abs_delta_mm'] <= limit
+                and all(row['abs_delta_mm'] is not None for row in fid['runout']['rows'])
+                and fid['silhouette']['max_abs_mm'] <= limit)
