+        cand_r = radial_first_hit_mm(segments_from_arrays(verts, tris, y), [0.0])[0]
+        delta = None if (ref_r is None or cand_r is None or math.isnan(ref_r) or math.isnan(cand_r)) else abs(cand_r - ref_r)
