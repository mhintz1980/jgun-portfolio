+    verts = np.round(coordinates(mesh).astype(np.float64) * 1e9).astype(np.int64)
+    mesh.calc_loop_triangles()
+    tris = np.unique(np.sort(np.array([t.vertices[:] for t in mesh.loop_triangles], dtype=np.int64), axis=1), axis=0)
+    h = hashlib.sha256()
