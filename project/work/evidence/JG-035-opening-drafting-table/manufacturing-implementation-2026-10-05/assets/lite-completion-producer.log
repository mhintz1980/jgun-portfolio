+def directed_polyline_max(points, segs, chunk=256):
+    """Exact max over sample points of min distance to the polyline segments."""
+    a = segs[:, 0]
+    ab = segs[:, 1] - segs[:, 0]
+    denom = np.einsum('ij,ij->i', ab, ab)
+    denom[denom == 0.0] = 1.0
+    best = 0.0
