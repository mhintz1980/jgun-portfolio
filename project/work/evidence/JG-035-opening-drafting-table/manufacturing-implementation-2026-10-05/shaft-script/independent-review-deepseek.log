@keyframes shaft-stamp-settle{0%{transform:rotate(-4deg) scale(1.5)}62%{transform:rotate(-4deg) scale(.94)}100%{transform:rotate(-4deg) scale(1)}}
.shaft-attribution{position:absolute;left:8%;bottom:8%;max-width:min(380px,42%);margin:0;padding:8px 12px;background:#0b141d;border-radius:4px;font-size:13px;line-height:1.5;color:#cfdce6}
.shaft-caption{position:absolute;left:8%;bottom:calc(8% + 58px);max-width:min(340px,42%);margin:0;padding:6px 10px;background:#0b141d;border-radius:4px;font-size:12px;line-height:1.45;color:#cfdce6}
.shaft-caption-recap{bottom:8%}
.shaft-visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;clip:rect(0 0 0 0);clip-path:inset(50%);overflow:hidden;white-space:nowrap}
@media(max-width:600px){
  .shaft-card-slot{top:auto;bottom:calc(8% + 112px);left:8%;right:8%;width:auto}
  .shaft-card{padding:12px 16px 14px}
  .shaft-card-text{font-size:24px}
  .shaft-stamp{font-size:22px;margin-top:10px}
  .shaft-attribution{left:8%;right:8%;bottom:8%;max-width:none;font-size:12px}
  .shaft-caption{left:8%;right:8%;bottom:calc(8% + 54px);max-width:none;font-size:12px}
}
@media(prefers-reduced-motion:reduce){.shaft-stamp-impulse{animation:none}}


