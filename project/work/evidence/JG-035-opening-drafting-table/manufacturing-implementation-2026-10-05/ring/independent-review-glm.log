 115:   // The initial footprint has received pi radians during the dwell. Reveal it smoothly, then trail the
 116:   // leading roller edge by the pi-radian forming interval. The far edge finishes in the stationary end dwell.
 117:   const coveredTravel = clamp((t - COVERAGE_TIME - TRAVERSE_START) / (TRAVERSE_END - TRAVERSE_START))
 118:   out.knurl = ease((t - TRAVERSE_START) / COVERAGE_TIME) * (WHEEL_WIDTH + (BAND_WIDTH - WHEEL_WIDTH) * coveredTravel) / BAND_WIDTH
 119:   // Export uses absolute frame/fps samples: first key is 1/30, last is 150/30.
 120:   // Approach eases into first contact (zero closing speed), then the clip rolls through the 0.4 s dwell to the
 121:   // traverse key; traverse is 1:1 clip time; retract is linear to the final key.
 122:   out.clipTime = t < APPROACH_START ? CLIP_START
 123:     : t < CONTACT_START ? CLIP_START + (CLIP_CONTACT_START - CLIP_START) * ease((t - APPROACH_START) / (CONTACT_START - APPROACH_START))
 124:     : t < TRAVERSE_START ? CLIP_CONTACT_START + (CLIP_TRAVERSE_START - CLIP_CONTACT_START) * (t - CONTACT_START) / CONTACT_DWELL
 125:     : t < TRAVERSE_END ? CLIP_TRAVERSE_START + t - TRAVERSE_START
 126:     : t < 8.2 ? CLIP_TRAVERSE_END + (t - TRAVERSE_END) / 2 * (CLIP_END - CLIP_TRAVERSE_END) : CLIP_END
 127:   out.contact = out.clipTime >= CLIP_CONTACT_START && out.clipTime <= CLIP_CONTACT_END
 128:   out.toolOpacity = t < APPROACH_START || t >= TOOL_FADE_END ? 0 : 1 - ease((t - TOOL_FADE_START) / (TOOL_FADE_END - TOOL_FADE_START))
 129:   out.toolVisible = out.toolOpacity > 0
 130:   sampleSpin(t, out)
 131:   const ringHz = out.spin * (2 * RING_FEATURES) / (2 * Math.PI)
 132:   const rollerHz = out.spin * RING_RADIUS / WHEEL_RADIUS * ROLLER_TEETH / (2 * Math.PI)
 133:   out.ringDetailScale = ringHz > MAX_FEATURE_HZ ? MAX_FEATURE_HZ / ringHz : 1
 134:   out.rollerDetailScale = rollerHz > MAX_FEATURE_HZ ? MAX_FEATURE_HZ / rollerHz : 1
 135:   out.returnBlend = ease((t - 10.5) / 1.5)
 136:   return out
 137: }
 138: export function odMask(radius: number, z: number, normalZ: number, od: number, halfWidth: number, progress: number): number {
 139:   const bandMin = -halfWidth + SHOULDER, bandMax = halfWidth - SHOULDER
 140:   if (radius < od - 0.00035 || Math.abs(normalZ) > 0.2 || z <= bandMin || z >= bandMax || progress <= 0) return 0
 141:   return z <= bandMin + progress * (bandMax - bandMin) ? 1 : 0
 142: }
