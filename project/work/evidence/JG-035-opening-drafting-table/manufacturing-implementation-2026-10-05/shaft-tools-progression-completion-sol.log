+    const position = thread.geometry.getAttribute('position')
+    const matrix = new Matrix4()
+    const vertex = new Vector3()
+    let maxRadius = 0
+    let minY = Infinity
+    let maxY = -Infinity
+    for (let i = 0; i < thread.count; i++) {
