def bvh_for(name, poly_filter=None):
    ob = bpy.data.objects[name]
    me = ob.evaluated_get(deps).to_mesh()
    verts = [tuple(ob.matrix_world @ v.co) for v in me.vertices]
    polys = [tuple(p.vertices) for p in me.polygons]
