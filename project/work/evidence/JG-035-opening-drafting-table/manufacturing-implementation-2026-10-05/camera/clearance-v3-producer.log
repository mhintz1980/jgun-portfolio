+        poses.append(("infeed", 13.9, a0 + (reach_d(13.9) - ROOT_R) + RETRACT * (1 - frac)))
+    for yc in np.arange(13.9, 9.5249 - 1e-9, -0.05):
+        poses.append(("feed", float(yc), a0 + (reach_d(float(yc)) - ROOT_R)))
+    for frac in np.arange(0.0, 1.0001, 0.02):
+        poses.append(("retract", 9.5249, a0 + RETRACT * frac))
