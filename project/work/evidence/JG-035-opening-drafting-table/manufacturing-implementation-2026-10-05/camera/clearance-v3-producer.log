+                  "ramp_fit": {"y_mm": fy.tolist(), "floor_r_mm": fr.tolist(),
+                               "model_mm": reach(fy - Y_END, R_FIT).tolist()}}), fh, indent=1)
+log("wrote report.json and tools.json")
+
+for p, h in hashes_before.items():
