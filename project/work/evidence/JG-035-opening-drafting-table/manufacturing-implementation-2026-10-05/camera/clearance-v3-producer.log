+        cross = di * dj < 0
+        t = -di[cross] / (dj[cross] - di[cross])
+        a = V[F[cross, i]]
+        b = V[F[cross, j]]
+        p = a + (b - a) * t[:, None]
+        pts.append(p[:, [0, 2]])
+        seg_tris.append(np.nonzero(cross)[0])
