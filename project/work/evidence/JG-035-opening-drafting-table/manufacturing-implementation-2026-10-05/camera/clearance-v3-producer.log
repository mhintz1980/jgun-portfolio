+            AA = self.A[S]
+            EE = self.E[S]
+            t = ((P[:, None, :] - AA[None, :, :]) * EE[None, :, :]).sum(2) / self.ee[S][None, :]
+            t = np.clip(t, 0, 1)
+            proj = AA[None, :, :] + t[:, :, None] * EE[None, :, :]
+            out[sel] = np.sqrt(((P[:, None, :] - proj) ** 2).sum(2)).min(1)
