+        "addendum_mm": r9(R_WP_HOB - ROOT_R), "body_length_mm": HOB_LEN,
+        "path": {"infeed": "radial at y=13.9 from retracted distance",
+                 "feed": "arc centre path y 13.9 -> 9.5249 (centre dist = ramp(y)+R_o)",
