+# ------------------------------------------------------- section machinery
+def plane_segments(V, F, y0, eps=1e-9):
+    y = V[:, 1]
+    tri_y = y[F]
+    d = tri_y - y0
+    d[np.abs(d) < eps] = eps
+    pts = []
+    seg_tris = []
+    for e in ((0, 1), (1, 2), (2, 0)):
