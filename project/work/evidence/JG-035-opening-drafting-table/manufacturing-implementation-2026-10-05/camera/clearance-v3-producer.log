def sagitta_bound(A, B):
    """Max chord sagitta h^2/(8 rho) over consecutive segment pairs."""
    if len(A) < 3:
        return 0.0
    mid = (A + B) / 2
    phi = np.arctan2(mid[:, 1], mid[:, 0])
    order = np.argsort(np.mod(phi, 2 * math.pi), kind="stable")
    P0 = mid[order]
    n = len(P0)
    P1 = np.roll(P0, -1, axis=0)
    P2 = np.roll(P0, -2, axis=0)
    a = np.linalg.norm(P1 - P0, axis=1)
    b = np.linalg.norm(P2 - P1, axis=1)
    c = np.linalg.norm(P2 - P0, axis=1)
    area2 = np.abs((P1[:, 0] - P0[:, 0]) * (P2[:, 1] - P0[:, 1])
                   - (P1[:, 1] - P0[:, 1]) * (P2[:, 0] - P0[:, 0]))
    with np.errstate(divide="ignore", invalid="ignore"):
        rho = a * b * c / (2 * area2)
    h = np.maximum(a, b)
    sag = np.where(np.isfinite(rho) & (rho > 0), h * h / (8 * np.where(rho > 0, rho, 1)), 0.0)
    return float(sag.max())


