+# ------------------------------------------------------- section machinery
+def plane_segments(V, F, y0, eps=1e-9):
+    y = V[:, 1]
+    d = y[F] - y0
+    d[np.abs(d) < eps] = eps
+    pts = []
+    tri_ids = []
+    for i, j in ((0, 1), (1, 2), (2, 0)):
+        di, dj = d[:, i], d[:, j]
+        cross = di * dj < 0
+        t = -di[cross] / (dj[cross] - di[cross])
+        a = V[F[cross, i]]
+        b = V[F[cross, j]]
+        pts.append(a + (b - a) * t[:, None])
+        tri_ids.append(np.nonzero(cross)[0])
