+    tid = np.concatenate(tri_ids)
+    counts = np.bincount(tid, minlength=len(F))
+    two = counts == 2
+    P = P[two[tid]]
+    P = P[np.argsort(tid[two[tid]], kind="stable")]
+    n = len(P) // 2
+    return P[0::2][:n].copy(), P[1::2][:n].copy()
