+        "collars_arbor_mm": {k: list(v) for k, v in COLLARS.items()},
+        "gash_scallop_note": ("smooth-thread rack-envelope model; 10-gash scallop ~0.001 mm "
+                              "included in e_total_path; relieved flanks assumed"),
