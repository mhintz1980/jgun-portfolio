+
+def reach(delta, Ro):
+    rh = Ro - (R_WP_HOB - ROOT_R)
+    g = math.asin(min(1.0, 1.0 / (2 * rh)))
+    d = np.asarray(delta, dtype=float)
+    inner = np.clip(1.0 - (d / (Ro * math.cos(g))) ** 2, 0.0, 1.0)
+    return np.sqrt((d * math.tan(g)) ** 2 + (ROOT_R + Ro * (1 - np.sqrt(inner))) ** 2)
