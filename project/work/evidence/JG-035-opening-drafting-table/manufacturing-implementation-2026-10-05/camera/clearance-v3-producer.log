+# holders: hub / clamp nut / arbor cylinders behind the trailing face
+HOLDERS = {"hub": (8.0, 6.0), "clamp_nut": (9.0, 3.0), "arbor": (7.0, 12.0)}
+holder_min = None
+holder_at = None
