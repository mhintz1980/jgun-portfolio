+# ------------------------------------------------------------------ hob
+log("STAGE 4 hob: ramp extraction and least-squares fit")
+floor_pts = []
+for y0 in np.arange(9.45, 13.90 + 1e-9, 0.02):
+    A, B = plane_segments(APP_V, APP_F, float(y0))
+    if len(A) >= 4:
