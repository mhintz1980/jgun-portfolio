+    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=1e-6)  # 1 um weld, in memory
+    remap = {}
+    vlist = []
+
+    def key_of(co):
+        w = co * 1000.0
+        return (round(w[0], 6), round(w[1], 6), round(w[2], 6))
