+    tri_id = np.concatenate(seg_tris)
+    counts = np.bincount(tri_id, minlength=len(F))
+    two = counts == 2
+    use = two[tri_id]
+    P = P[use]
+    tri_id = tri_id[use]
+    order = np.argsort(tri_id, kind="stable")
+    P = P[order]
+    n = len(P) // 2
+    return P[0::2][:n], P[1::2][:n]
