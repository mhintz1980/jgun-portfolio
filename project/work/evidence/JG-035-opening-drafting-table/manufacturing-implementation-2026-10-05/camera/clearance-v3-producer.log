+         % (rack_worst_pen, tol_gen, RACK_SCAT))
+add_pair("hob_vs_approved_ramp_reproduction", R_MAX, E_TOTAL_PATH, EPS_STOCK,
+         R_MAX <= E_TOTAL_PATH + EPS_STOCK, {"y_end_mm": Y_END, "stations": int(m.sum())},
+         "fit residual max %.5f rms %.5f; authored arc R %.4f" % (R_MAX, R_RMS, R_ARC))
+for k in sorted(hob_pairs):
