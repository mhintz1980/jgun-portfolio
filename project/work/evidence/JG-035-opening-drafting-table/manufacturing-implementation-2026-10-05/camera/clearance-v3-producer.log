+    p = Path(s["path"])
+    if not p.exists():
+        continue
+    got = sha256(p)
+    if got != s["sha256"]:
+        raise SystemExit("HASH_MISMATCH_BEFORE %s" % p)
+    hashes_before[str(p)] = got
+blend_sha_before = sha256(BLEND)
