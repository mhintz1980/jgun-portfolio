+        "outer_boundary_ray_hits_max": {t: {y: int(sections[t][y]["outer_hits_max"])
+                                            for y in ("3.5", "6.0", "9.0")}
+                                        for t in ("legacy", "approved")},
+        "section_min_max_mm": {t: {y: [r9(sections[t][y]["min"]), r9(sections[t][y]["max"])]
+                                   for y in ("3.5", "6.0", "9.0")}
