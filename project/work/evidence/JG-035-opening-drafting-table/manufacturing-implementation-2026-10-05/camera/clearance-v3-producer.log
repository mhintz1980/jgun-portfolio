+    "pairs": pairs,
+    "verdict": verdict,
+    "determinism": "rerun the exact command; compare report.json with generated_utc removed",
+}
+if verdict != "CERTIFIED":
+    report["unresolved"] = [p["pair"] for p in pairs if not p["PASS"]] + (
