+        "e_total_path": {"shaper": r9(E_TOTAL_PATH_SHAPER), "hob": r9(E_TOTAL_PATH_HOB)},
+        "margin_noncontact_mm": MARGIN,
+        "eps_stock_mm": EPS_STOCK,
+    },
