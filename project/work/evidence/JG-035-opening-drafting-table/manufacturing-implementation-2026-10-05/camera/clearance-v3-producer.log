+    u_bin = (ub / pitch_rack * nb_r).astype(np.int64) % nb_r
+    dmax = np.zeros(nb_r)
+    np.maximum.at(dmax, u_bin, depth)
+    strand = depth - dmax[u_bin]
+    sc = float(np.abs(strand).max())
+    if scat_best is None or sc < scat_best[0]:
+        scat_best = (sc, sgn, dmax, nb_r, pitch_rack)
+RACK_SCAT, RACK_SIGN, RACK_PROF, NB_RACK, PITCH_RACK = scat_best
