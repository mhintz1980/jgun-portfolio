+# coverage: every usable feasible work sample touched by the tool at its pose
+P = np.column_stack((qx[con["feas"]], qz[con["feas"]]))
+cov_max = 0.0
+cov_at = None
+for i in range(len(P)):
+    wx, wz = tool_pose_work(np.array([alp[i]]))
