+def r9(x):
+    if isinstance(x, (np.floating, float)):
+        return round(float(x), 9)
+    if isinstance(x, (np.integer, int)):
+        return int(x)
+    if isinstance(x, dict):
+        return {k: r9(v) for k, v in x.items()}
+    if isinstance(x, (list, tuple)):
+        return [r9(v) for v in x]
+    return x
