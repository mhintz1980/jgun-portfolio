+# ---------------------------------------------- legacy loom + stroke checks
+log("STAGE 3 legacy loom + stroke/holder checks")
+loom = {}
+for y0 in np.arange(0.0, 11.75 + 1e-9, 0.05):
+    A, B = plane_segments(LEG_V, LEG_F, float(y0))
+    if len(A) >= 4:
+        sc = SegCloud(A, B, nbins=360)
+        r_out, _ = sc.outer_r(ANG_LOOM)
