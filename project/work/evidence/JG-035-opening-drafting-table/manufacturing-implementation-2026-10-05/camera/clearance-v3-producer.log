+    S = S.ravel()
+    Bd = Bd.ravel()
+    y = yc + S * sg - Rc * np.sin(Bd) * cg
+    x = S * cg + Rc * np.sin(Bd) * sg
+    z = ca + Rc * np.cos(Bd)
+    return y, np.hypot(x, z)
