+BLEND = SRC_DIR / "input-shaft-assembly-parts-v1.blend"
+BLEND_SHA = "88d1ce4ac7ca112adcd370e77852cfb9977dfec81b4bfcb61ee1872895574a89"
+REGISTRY = EV / "geometry" / "source-registry.json"
