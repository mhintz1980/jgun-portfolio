+            reach = SHAPER_C - Rc
+            if y_lo <= y0 <= y_hi:
+                d = reach - e["rmax"]
+            elif y0 > y_hi:
+                d = math.hypot(max(0.0, e["rmax"] - reach), y0 - y_hi)
+            else:
+                d = math.hypot(max(0.0, e["rmax"] - reach), y_lo - y0)
+            if holder_min is None or d < holder_min:
