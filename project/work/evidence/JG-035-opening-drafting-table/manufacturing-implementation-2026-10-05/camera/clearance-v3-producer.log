+        cov_at = (float(math.degrees(con["theta"][i])), float(np.hypot(*P[i])))
+log("coverage: %d feasible samples, max point-gap %.5f mm at (theta_deg, r)=%s"
+    % (len(P), cov_max, cov_at))
+E_TOTAL_GEN = E_CAD + E_TOOL + E_POSE_ROLL
