+    ea = np.array([nid(p) for p in a])
+    eb = np.array([nid(p) for p in b])
+    coord = np.zeros((len(nodes), 2))
+    for p, i in zip(np.vstack((a, b)), np.concatenate((ea, eb))):
+        coord[i] = p
+    adj = {}
+    for u, v in zip(ea, eb):
+        if u == v:
+            continue
+        adj.setdefault(u, []).append(v)
+        adj.setdefault(v, []).append(u)
+    best = []
+    seen_e = set()
+    for start in range(len(nodes)):
+        if start not in adj:
+            continue
+        loop = [start]
+        prev, cur = -1, start
+        while True:
+            nxt = [w for w in adj[cur] if w != prev]
+            if not nxt:
+                break
+            step = nxt[0]
+            ek = (min(cur, step), max(cur, step))
+            if ek in seen_e:
