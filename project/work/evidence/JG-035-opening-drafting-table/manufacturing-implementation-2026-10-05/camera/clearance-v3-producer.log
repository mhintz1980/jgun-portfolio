+    keep = slope <= 0.5  # mm per degree; excludes tooth-corner bins
+    constancy_flank[tag] = float(np.abs(means[:, keep] - means[:, keep].mean(axis=0)).max())
+    log("%s: cross-y constancy all-bins %.5f mm, flank-bins(keep %d/720) %.5f mm"
