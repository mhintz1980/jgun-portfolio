+    n = len(loop)
+    r_out = np.zeros(len(angles))
+    hits = np.zeros(len(angles), dtype=np.int64)
+    A = loop
+    B = loop[np.arange(1, n + 1) % n]
+    E = B - A
+    for k, phi in enumerate(angles):
+        d = np.array([math.cos(phi), math.sin(phi)])
+        den = d[0] * E[:, 1] - d[1] * E[:, 0]
+        ok = np.abs(den) > 1e-12
+        t = np.zeros(n)
+        s = np.zeros(n)
+        t[ok] = (A[ok, 0] * E[ok, 1] - A[ok, 1] * E[ok, 0]) / den[ok]
+        s[ok] = (A[ok, 0] * d[1] - A[ok, 1] * d[0]) / den[ok]
+        good = ok & (t >= 0) & (s >= 0) & (s <= 1)
+        rr = np.hypot((t[good] * d[0]), (t[good] * d[1]))
+        hits[k] = good.sum()
+        if rr.size:
+            r_out[k] = rr.max()
+    return r_out, hits
+
+
+ANG_FINE = np.arange(7200) * 2 * math.pi / 7200
+
+
+def exact_section(V, F, y0):
+    a, b = plane_segments(V, F, y0)
+    loop = chain_loop(a, b)
+    if len(loop) < 8:
+        return None
+    r_out, hits = ray_profile(loop, ANG_FINE)
+    return {"loop": loop, "r": r_out, "hits": hits}
+
+
+def seg_sagitta(loop):
+    """Max polyline chord sagitta h^2/(8 rho) over consecutive triples."""
+    n = len(loop)
+    idx = np.arange(n)
+    P0 = loop[idx]
+    P1 = loop[(idx + 1) % n]
+    P2 = loop[(idx + 2) % n]
+    a = np.linalg.norm(P1 - P0, axis=1)
+    b = np.linalg.norm(P2 - P1, axis=1)
+    c = np.linalg.norm(P2 - P0, axis=1)
+    area2 = np.abs((P1[:, 0] - P0[:, 0]) * (P2[:, 1] - P0[:, 1])
+                   - (P1[:, 1] - P0[:, 1]) * (P2[:, 0] - P0[:, 0]))
+    valid = (a > 1e-12) & (b > 1e-12) & (c > 1e-12)
+    rho = np.where(valid, a * b * c / (2 * np.where(valid, area2, 1e-12)), np.inf)
+    h = np.maximum(a, b)
+    sag = np.where(np.isfinite(rho) & (rho > 0), h * h / (8 * rho), 0.0)
+    return float(sag.max())
+
+
+def fold_stats(r, n_fold=TEETH_W, nbins=720):
+    ang = np.arange(len(r)) * 2 * math.pi / len(r)
+    fold = np.mod(ang, 2 * math.pi / n_fold)
+    bins = (fold / (2 * math.pi / n_fold) * nbins).astype(np.int64) % nbins
+    mean = np.zeros(nbins)
+    cnt = np.zeros(nbins)
+    np.add.at(mean, bins, r)
+    np.add.at(cnt, bins, 1)
+    mean /= np.maximum(cnt, 1)
+    dev = np.abs(r - mean[bins])
+    return mean, float(dev.max())
+
+
+log("STAGE 1 exact sections y=3.5/6/9")
+sections = {}
+for tag, V, F in (("legacy", LEG_V, LEG_F), ("approved", APP_V, APP_F)):
+    sections[tag] = {}
+    for y in (3.5, 6.0, 9.0):
+        s = exact_section(V, F, y)
+        r = s["r"]
+        s["min"], s["max"] = float(r.min()), float(r.max())
+        s["sagitta"] = seg_sagitta(s["loop"])
+        s["fold_mean"], s["fold_dev"] = fold_stats(r)
+        s["star_shaped"] = bool((s["hits"] == 1).all())
+        sections[tag][str(y)] = s
+        log("section %s y=%.1f r=[%.4f, %.4f] hits1=%s fold_dev=%.5f sag=%.6f"
+            % (tag, y, s["min"], s["max"], s["star_shaped"], s["fold_dev"], s["sagitta"]))
+
+constancy = {}
+for tag in ("legacy", "approved"):
+    means = np.vstack([sections[tag][y]["fold_mean"] for y in ("3.5", "6.0", "9.0")])
+    constancy[tag] = float(np.abs(means - means.mean(axis=0)).max())
+log("cross-y constancy (10-fold): legacy %.5f approved %.5f mm"
+    % (constancy["legacy"], constancy["approved"]))
+SECTIONS_OK = constancy["legacy"] <= 0.003 and constancy["approved"] <= 0.003
+E_CAD_BASE = 0.002
+E_CAD = E_CAD_BASE + max(constancy.values())
+
+# ---------------------------------------------------------------- shaper
+log("STAGE 2 shaper conjugate cutter")
+prof = sections["legacy"]["6.0"]
+nb = len(prof["fold_mean"])
+sector = 2 * math.pi / TEETH_W
+fold_ang = np.arange(nb) * sector / nb
+mean_full = np.tile(prof["fold_mean"], TEETH_W)
+phi_full = fold_ang[np.arange(nb * TEETH_W) % nb] + (np.arange(nb * TEETH_W) // nb) * sector
+r_wp = SHAPER_C / (1.0 + N_SHAPER / TEETH_W)
+r_wc = SHAPER_C - r_wp
+
+rr = mean_full
+dphi = phi_full[1] - phi_full[0]
+rp = (np.roll(rr, -1) - np.roll(rr, 1)) / (2 * dphi)
+qx = rr * np.cos(phi_full)
+qz = rr * np.sin(phi_full)
+tx = rp * np.cos(phi_full) - rr * np.sin(phi_full)
+tz = rp * np.sin(phi_full) + rr * np.cos(phi_full)
+tn = np.hypot(tx, tz)
+tx, tz = tx / tn, tz / tn
+nx, nz = tz, -tx  # outward for CCW
+radial_dot = nx * qx / rr + nz * qz / rr
+assert np.abs(radial_dot).min() > 0.1, "outward normal assumption violated"
+qt = qx * tx + qz * tz
+feas_bound = float(np.abs(qt).max())
+log("feasibility max|q.t| = %.5f mm vs r_wp = %.5f mm" % (feas_bound, r_wp))
+
+k = -qt / r_wp
+feas = np.abs(k) <= 1.0 - 1e-12
+psi = np.arctan2(nz, nx)
+theta_c = psi - np.arccos(np.clip(k[feas], -1, 1))
+Iw_x = -r_wp * np.sin(theta_c)
+Iw_z = r_wp * np.cos(theta_c)
+side = (Iw_x - qx[feas]) * nx[feas] + (Iw_z - qz[feas]) * nz[feas]
+flip = side <= 0
+theta_full = np.array(theta_c)
+theta_full[flip] = psi[feas][flip] + np.arccos(np.clip(k[feas][flip], -1, 1))
+
+
+def rot2(x, z, a):
+    c, s = np.cos(a), np.sin(a)
+    return x * c + z * s, -x * s + z * c
+
+
+alp = -theta_full * (TEETH_W / N_SHAPER)
+gwx, gwz = rot2(qx[feas], qz[feas], theta_full)
+cx = gwx - 0.0
+cz = gwz - SHAPER_C
+qcx, qcz = rot2(cx, cz, -alp)
+qcr = np.hypot(qcx, qcz)
+beta = np.mod(np.arctan2(qcz, qcx), 2 * math.pi / N_SHAPER)
+
+# round-trip check: tool point at pose (alpha, theta) maps back onto q
+vwx, vwz = rot2(qcx, qcz, alp)
+vwx = vwx
+vwz = vwz + SHAPER_C
+bwx, bwz = rot2(vwx, vwz, -theta_full)
+rt = float(np.abs(bwx - qx[feas]).max() + np.abs(bwz - qz[feas]).max())
+assert rt < 1e-7, "conjugate round-trip failed: %.3e" % rt
+log("conjugate flank points %d/%d feasible; round-trip %.2e mm"
+    % (feas.sum(), len(k), rt))
+
+NBINS_T = 900
+bin_t = (beta / (2 * math.pi / N_SHAPER) * NBINS_T).astype(np.int64) % NBINS_T
+tool_r = np.zeros(NBINS_T)
+cnt_t = np.zeros(NBINS_T, dtype=np.int64)
+np.maximum.at(tool_r, bin_t, qcr)
+np.add.at(cnt_t, bin_t, 1)
+unfilled = cnt_t == 0
+filled = ~unfilled
+for j in np.nonzero(unfilled)[0]:
+    nb_ok = [tool_r[m % NBINS_T] for m in range(j - 25, j + 26) if filled[m % NBINS_T]]
+    tool_r[j] = min(nb_ok) - 0.2 if nb_ok else 0.0
+tool_r_arc = tool_r.copy()
+tool_r_arc[unfilled] -= EPS_STOCK
+tool_r_arc[filled] -= EPS_STOCK
+tool_beta = np.arange(NBINS_T) * (2 * math.pi / N_SHAPER) / NBINS_T
+log("tool tooth profile: tip %.4f root %.4f mm (unfilled bins %d)"
+    % (tool_r_arc.max(), tool_r_arc.min(), unfilled.sum()))
+
+tool_pts = np.zeros((N_SHAPER * NBINS_T, 2))
+for tooth in range(N_SHAPER):
+    a0 = tooth * 2 * math.pi / N_SHAPER
+    tool_pts[tooth * NBINS_T:(tooth + 1) * NBINS_T, 0] = tool_r_arc * np.cos(tool_beta + a0)
+    tool_pts[tooth * NBINS_T:(tooth + 1) * NBINS_T, 1] = tool_r_arc * np.sin(tool_beta + a0)
+
+
+def point_seg_dist_2d(px, pz, A, B):
+    ex = B[:, 0] - A[:, 0]
+    ez = B[:, 1] - A[:, 1]
+    ee = ex * ex + ez * ez
+    ee[ee < 1e-18] = 1e-18
+    t = ((px - A[:, 0]) * ex + (pz - A[:, 1]) * ez) / ee
+    t = np.clip(t, 0, 1)
+    dx = px - (A[:, 0] + t * ex)
+    dz = pz - (A[:, 1] + t * ez)
+    return np.hypot(dx, dz)
+
+
+def tool_pose_work(alpha):
+    theta = -2.0 * alpha
+    rx, rz = rot2(tool_pts[:, 0], tool_pts[:, 1], alpha)
+    rz = rz + SHAPER_C
+    wx, wz = rot2(rx, rz, -theta)
+    return wx, wz
+
+
+def section_dist_for_points(wx, wz, loop, rmax, window_deg=3.0):
+    """Min Euclidean 2D distance from points to a section loop (local window)."""
+    n = len(loop)
+    A = loop
+    B = loop[np.arange(1, n + 1) % n]
+    out = np.full(len(wx), np.inf)
+    phi = np.arctan2(wz, wx)
+    rad = np.hypot(wx, wz)
+    seg_phi = np.arctan2((A[:, 1] + B[:, 1]) / 2, (A[:, 0] + B[:, 0]) / 2)
+    w = window_deg * math.pi / 180
+    near = rad < rmax + 1.0
+    idx_near = np.nonzero(near)[0]
+    for i in idx_near:
+        dphi = np.angle(np.exp(1j * (seg_phi - phi[i])))
+        sel = np.abs(dphi) < w
+        if not sel.any():
+            sel = np.abs(dphi) < 6 * w
+        out[i] = point_seg_dist_2d(wx[i], wz[i], A[sel], B[sel]).min()
+    return out
+
+
+# forward generating fit at the gear zone: rolls over one cutter pitch
+ROLL_STEP = math.radians(0.2)
+rolls = np.arange(0, 2 * math.pi / N_SHAPER, ROLL_STEP)
+E_POSE_ROLL = 7.5 * ROLL_STEP / 2
+gear_worst_pen = -np.inf
+gear_witness = None
+for y in ("3.5", "6.0", "9.0"):
+    loop = sections["legacy"][y]["loop"]
+    rmax = sections["legacy"][y]["max"]
+    for alpha in rolls:
+        wx, wz = tool_pose_work(alpha)
+        d = section_dist_for_points(wx, wz, loop, rmax)
+        inside = np.hypot(wx, wz) < np.interp(
+            np.mod(np.arctan2(wz, wx), 2 * math.pi),
+            np.r_[ANG_FINE, 2 * math.pi], np.r_[sections["legacy"][y]["r"], sections["legacy"][y]["r"][0]])
+        pen = np.where(inside, -d, d).min()
+        if pen > gear_worst_pen:
+            j = int(np.argmin(np.where(inside, -d, d)))
+            gear_worst_pen = float(pen)
+            gear_witness = {"y": y, "alpha_deg": float(math.degrees(alpha)),
+                            "point_mm": [float(wx[j]), float(wz[j])],
+                            "unsigned_mm": float(d[j])}
+log("gear-zone worst signed penetration %.5f mm at %s" % (gear_worst_pen, gear_witness))
+
+# coverage: distance from raw work samples to the tool at their conjugate pose
+raw = sections["legacy"]["6.0"]
+loop_raw = raw["loop"]
+P = loop_raw
+T = np.roll(P, -1, axis=0)
+ttx = (T[:, 0] - P[:, 0]); ttz = (T[:, 1] - P[:, 1])
+ttn = np.hypot(ttx, ttz); ttx, ttz = ttx / ttn, ttz / ttn
+qqx, qqz = P[:, 0], P[:, 1]
+qqt = qqx * ttx + qqz * ttz
+kk = -qqt / r_wp
+ff = np.abs(kk) <= 1.0 - 1e-12
+psi2 = np.arctan2(ttz, ttx) * 0 + np.arctan2(ttx, -ttz)  # outward normal angle
+th2 = psi2 - np.arccos(np.clip(kk[ff], -1, 1))
+Iwx = -r_wp * np.sin(th2); Iwz = r_wp * np.cos(th2)
+sd = (Iwx - qqx[ff]) * (-ttz[ff]) + (Iwz - qqz[ff]) * (ttx[ff])
+fl2 = sd <= 0
+th2[fl2] = psi2[ff][fl2] + np.arccos(np.clip(kk[ff][fl2], -1, 1))
+al2 = -th2 * (TEETH_W / N_SHAPER)
+cov = []
+for i in np.nonzero(ff)[0]:
+    wx, wz = tool_pose_work(np.array([al2[i]]))
+    # tool at this alpha: distance from work sample to tool polyline
+    twx = tool_pose_work(np.array([al2[i]]))
+    a = np.column_stack(twx)
+    b = np.roll(a, -1, axis=0)
+    cov.append(point_seg_dist_2d(P[i, 0], P[i, 1], a, b).min())
+cov = np.array(cov)
+infeas_ct = int((~ff).sum())
+log("coverage: feasible %d infeasible %d, max residual %.5f mm"
+    % (ff.sum(), infeas_ct, cov.max()))
+
+TOOL_SAGITTA = seg_sagitta(np.column_stack((tool_r_arc * np.cos(tool_beta),
+                                            tool_r_arc * np.sin(tool_beta))))
+E_TOOL = TOOL_SAGITTA
+E_TOTAL_GEN = E_CAD + E_TOOL + E_POSE_ROLL
+
+# ---- 3D path/feature checks (legacy loom)
+log("STAGE 3 legacy loom + stroke checks")
+LOOM_STATIONS = np.arange(0.0, 11.75 + 1e-9, 0.05)
+loom = {}
+ANG_LOOM = np.arange(720) * 2 * math.pi / 720
+for y0 in LOOM_STATIONS:
+    a, b = plane_segments(LEG_V, LEG_F, y0)
+    loop = chain_loop(a, b)
+    if len(loop) >= 8:
+        r_out, _ = ray_profile(loop, ANG_LOOM)
+        loom[round(y0, 3)] = {"rmax": float(r_out.max()), "rmin": float(r_out.min()),
+                              "loop": loop}
+log("loom stations with sections: %d" % len(loom))
+
+
+def ring_min_dist(rad, y0):
+    """Lower bound on Euclidean distance from a point set at radius rad to the ring at station y0."""
+    e = loom.get(round(y0, 3))
+    if e is None:
+        return None
+    return rad - e["rmax"]
+
+
+tool_min_radius_by_roll = []
+for alpha in np.arange(0, 2 * math.pi / N_SHAPER, math.radians(0.5)):
+    wx, wz = tool_pose_work(alpha)
+    tool_min_radius_by_roll.append(float(np.hypot(wx, wz).min()))
+TOOL_MIN_R = min(tool_min_radius_by_roll)
+log("tool inner envelope radius over rolls: %.5f mm (root %.4f)" % (TOOL_MIN_R, ROOT_R))
+
+# cutter tip vs groove floor and journal step (positive-clearance pairs)
+stroke_c0, stroke_c1 = 2.0748584, 10.3248584
+lead0, lead1 = stroke_c0 + SHAPER_THICK / 2, stroke_c1 + SHAPER_THICK / 2
+overtravel = lead1 - FACE_END
+
+groove_st = [y for y in sorted(loom) if 10.0 <= y <= 11.6]
+groove_min = None
+groove_at = None
+for y0 in groove_st:
+    d = TOOL_MIN_R - loom[y0]["rmax"]
+    if groove_min is None or d < groove_min:
+        groove_min, groove_at = d, y0
+
+# cutter leading-face rim (extrusion cap) to journal step: exact ring/station scan
+step_st = [y for y in sorted(loom) if 10.9 <= y <= 12.0]
+rim_radii = tool_r_arc  # profile radii about cutter axis
+rim_min = None
+rim_at = None
+for y0 in step_st:
+    for rr_, bta in zip(rim_radii, tool_beta):
+        wr = SHAPER_C - rr_ * math.cos(bta)  # radial distance of rim point toward work
+        d = math.hypot(max(0.0, wr - loom[y0]["rmax"]), 0.0) if wr <= loom[y0]["rmax"] \
+            else wr - loom[y0]["rmax"]
+        d3 = math.hypot(d, y0 - lead1) if y0 > lead1 else d
+        if rim_min is None or d3 < rim_min:
+            rim_min, rim_at = d3, (y0, float(rr_), float(math.degrees(bta)))
+log("groove-floor min %.5f mm at y=%.2f; leading-rim/journal-step min %.5f mm at %s"
+    % (groove_min, groove_at, rim_min, rim_at))
+
+# face side + holders
+face_min = min(TOOL_MIN_R - loom[y]["rmax"] for y in sorted(loom) if 0.2 <= y <= 3.1749)
+HUB = {"hub": (8.0, 6.0), "clamp_nut": (9.0, 3.0), "arbor": (7.0, 12.0)}
+holder_min = None
+holder_at = None
+for y_c in np.arange(stroke_c0, stroke_c1 + 1e-9, 0.25):
+    back = y_c - SHAPER_THICK / 2
+    for name, (Rc, Lc) in HUB.items():
+        y_lo, y_hi = back - Lc, back
+        for y0 in sorted(loom):
+            if y_lo - 0.05 <= y0 <= y_hi + 0.05:
+                d = (SHAPER_C - Rc) - loom[y0]["rmax"]
+                if d < 0 and (y0 < y_lo or y0 > y_hi):
+                    d = math.hypot(SHAPER_C - Rc - loom[y0]["rmax"], min(abs(y0 - y_lo), abs(y0 - y_hi)))
+                if holder_min is None or d < holder_min:
+                    holder_min, holder_at = d, (name, float(y_c), float(y0))
+log("face-side min %.5f mm; holder min %.5f mm at %s" % (face_min, holder_min, holder_at))
+
+# relieved return: certified backoff
+return_backoff_illustrative = 0.8
+whole_depth = TIP_R - ROOT_R
+backoff_need = whole_depth + MARGIN
+return_backoff_certified = math.ceil((whole_depth + MARGIN + 0.05) * 20) / 20
+return_clear = (SHAPER_C + return_backoff_certified - tool_r_arc.max()) - TIP_R
+log("return relief: 0.8 mm illustrative leaves %.4f mm interference; certified %.2f mm -> %.4f mm clearance"
+    % (return_backoff_illustrative - whole_depth, return_backoff_certified, return_clear))
+
+# runout-zone roll sweep (exact 2D vs loom sections)
+runout_st = [y for y in sorted(loom) if FACE_END <= y <= 10.05 and y in
+             [round(v, 2) for v in np.arange(9.55, 10.06, 0.05)]]
+runout_worst = -np.inf
+runout_wit = None
+for y0 in runout_st:
+    loop = loom[y0]["loop"]
+    rmax = loom[y0]["rmax"]
+    for alpha in np.arange(0, 2 * math.pi / N_SHAPER, math.radians(0.2)):
+        wx, wz = tool_pose_work(alpha)
+        d = section_dist_for_points(wx, wz, loop, rmax)
+        rad = np.hypot(wx, wz)
+        phi = np.mod(np.arctan2(wz, wx), 2 * math.pi)
+        rsec = np.interp(phi, np.r_[ANG_LOOM, 2 * math.pi],
+                         np.r_[ray_profile(loop, ANG_LOOM)[0], ray_profile(loop, ANG_LOOM)[0][0]]) \
+            if False else None
+        inside = rad < loom[y0]["rmax"]
+        pen = float(np.where(inside, -d, d).min())
+        if pen > runout_worst:
+            runout_worst = pen
+            runout_wit = (y0, float(math.degrees(alpha)))
+log("runout-zone worst signed penetration %.5f mm at %s" % (runout_worst, runout_wit))
+
+# ------------------------------------------------------------------- hob
+log("STAGE 4 hob: ramp extraction and fit")
+ramp_st = np.arange(9.45, 13.90 + 1e-9, 0.02)
+floor_r = []
+for y0 in ramp_st:
+    a, b = plane_segments(APP_V, APP_F, y0)
+    loop = chain_loop(a, b)
+    if len(loop) >= 8:
+        r_out, _ = ray_profile(loop, ANG_LOOM)
+        floor_r.append((float(y0), float(r_out.min())))
+floor_r = np.array(floor_r)
+fit_mask = (floor_r[:, 0] >= 9.525 - 1e-9) & (floor_r[:, 0] <= RAMP_END + 1e-9)
+fy, fr = floor_r[fit_mask, 0], floor_r[fit_mask, 1]
+
+
+def reach(delta, Ro, yc_end, mn=1.0):
+    rh = Ro - (R_WP_HOB - ROOT_R)
+    g = math.asin(min(1.0, mn / (2 * rh)))
+    cg = math.cos(g)
+    d = np.asarray(delta, dtype=float)
+    inner = np.clip(1.0 - (d / (Ro * cg)) ** 2, 0.0, 1.0)
+    a_eff = ROOT_R + Ro
+    return np.sqrt((d * math.tan(g)) ** 2 + (a_eff - Ro * np.sqrt(inner)) ** 2)
+
+
+best = None
+for Ro in np.arange(4.5, 7.5, 0.005):
+    for ye in np.arange(9.40, 9.65, 0.005):
+        model = reach(fy - ye, Ro, ye)
+        res = fr - model
+        cost = float((res ** 2).sum())
+        if best is None or cost < best[0]:
+            best = (cost, Ro, ye)
+_, R_FIT, Y_END = best
+model = reach(fy - Y_END, R_FIT, Y_END)
+fit_res = fr - model
+R_RMS = float(np.sqrt((fit_res ** 2).mean()))
+R_MAX = float(np.abs(fit_res).max())
+
+# authored-arc comparison (pure circle fit, Kasa)
+Ac = np.column_stack((fy, fr, np.ones(len(fy))))
+bv = -(fy ** 2 + fr ** 2)
+sol, *_ = np.linalg.lstsq(Ac, bv, rcond=None)
+yc0 = -sol[0] / 2
+rc0 = -sol[1] / 2
+R_ARC = math.sqrt(yc0 ** 2 + rc0 ** 2 - sol[2])
+log("hob fit: R_o=%.4f mm y_end=%.4f residual rms=%.5f max=%.5f; authored arc R=%.4f"
+    % (R_FIT, Y_END, R_RMS, R_MAX, R_ARC))
+
+rh_h = R_FIT - (R_WP_HOB - ROOT_R)
+gamma_h = math.asin(1.0 / (2 * rh_h))
+lead_h = math.pi / math.cos(gamma_h)
+gamma_atan = math.atan(lead_h / (2 * math.pi * rh_h))
+log("hob: r_pitch=%.4f gamma(asin)=%.4f deg gamma(atan)=%.4f deg lead=%.4f mm"
+    % (rh_h, math.degrees(gamma_h), math.degrees(gamma_atan), lead_h))
+
+# hob rack conjugate of the approved tooth profile
+prof_a = sections["approved"]["6.0"]
+mean_a = np.tile(prof_a["fold_mean"], TEETH_W)
+rr2 = mean_a
+rp2 = (np.roll(rr2, -1) - np.roll(rr2, 1)) / (2 * dphi)
+qx2 = rr2 * np.cos(phi_full)
+qz2 = rr2 * np.sin(phi_full)
+tx2 = rp2 * np.cos(phi_full) - rr2 * np.sin(phi_full)
+tz2 = rp2 * np.sin(phi_full) + rr2 * np.cos(phi_full)
+tn2 = np.hypot(tx2, tz2)
+tx2, tz2 = tx2 / tn2, tz2 / tn2
+nx2, nz2 = tz2, -tx2
+qt2 = qx2 * tx2 + qz2 * tz2
+feas2 = np.abs(qt2) <= R_WP_HOB - 1e-9
+psi3 = np.arctan2(nz2, nx2)
+kk2 = -qt2[feas2] / R_WP_HOB
+th3 = psi3[feas2] - np.arccos(np.clip(kk2, -1, 1))
+Iwx3 = -R_WP_HOB * np.sin(th3)
+Iwz3 = R_WP_HOB * np.cos(th3)
+sd3 = (Iwx3 - qx2[feas2]) * nx2[feas2] + (Iwz3 - qz2[feas2]) * nz2[feas2]
+fl3 = sd3 <= 0
+th3[fl3] = psi3[feas2][fl3] + np.arccos(np.clip(kk2[fl3], -1, 1))
+
+
+def rack_point(theta, q_x, q_z, sign=1.0):
+    gwx, gwz = rot2(q_x, q_z, theta)
+    return gwx - sign * R_WP_HOB * theta, gwz - R_WP_HOB
+
+
+scat_best = None
+for sgn in (1.0, -1.0):
+    ux, uz = rack_point(th3, qx2[feas2], qz2[feas2], sgn)
+    depth = R_WP_HOB - uz
+    nb_r = 720
+    u_bin = np.mod(ux + 10 * math.pi, 2 * math.pi * R_WP_HOB / TEETH_W)
+    u_bin = (u_bin / (2 * math.pi * R_WP_HOB / TEETH_W) * nb_r).astype(np.int64) % nb_r
+    dmax = np.zeros(nb_r)
+    np.maximum.at(dmax, u_bin, depth)
+    strand = depth - dmax[u_bin]
+    sc = float(np.abs(strand).max())
+    if scat_best is None or sc < scat_best[0]:
+        scat_best = (sc, sgn, ux, uz, dmax, nb_r)
+RACK_SCATTER, RACK_SIGN, rack_u, rack_z, RACK_PROF, NB_RACK = scat_best
+log("rack profile: scatter %.5f mm (sign %+.0f)" % (RACK_SCATTER, RACK_SIGN))
+
+# rack forward fit vs approved sections at 3.5/6/9 (Euclidean, roll sweep)
+rack_pts = []
+pitch_rack = 2 * math.pi * R_WP_HOB / TEETH_W
+for j in range(NB_RACK):
+    u = (j / NB_RACK) * pitch_rack - pitch_rack / 2
+    rack_pts.append((u, R_WP_HOB - RACK_PROF[j]))
+rack_pts = np.array(rack_pts)
+
+
+def rack_pose_work(theta):
+    x0 = RACK_SIGN * R_WP_HOB * theta
+    px = rack_pts[:, 0] + x0
+    pz = rack_pts[:, 1]
+    wx, wz = rot2(px, pz, -theta)
+    return wx, wz
+
+
+rack_worst_pen = -np.inf
+rack_wit = None
+for y in ("3.5", "6.0", "9.0"):
+    loop = sections["approved"][y]["loop"]
+    rmax = sections["approved"][y]["max"]
+    rr_ = sections["approved"][y]["r"]
+    for theta in np.arange(0, 2 * math.pi / TEETH_W, math.radians(0.2)):
+        wx, wz = rack_pose_work(theta)
+        d = section_dist_for_points(wx, wz, loop, rmax)
+        phi = np.mod(np.arctan2(wz, wx), 2 * math.pi)
+        rsec = np.interp(phi, np.r_[ANG_FINE, 2 * math.pi], np.r_[rr_, rr_[0]])
+        inside = np.hypot(wx, wz) < rsec
+        pen = float(np.where(inside, -d, d).min())
+        if pen > rack_worst_pen:
+            j = int(np.argmin(np.where(inside, -d, d)))
+            rack_worst_pen = pen
+            rack_wit = {"y": y, "theta_deg": float(math.degrees(theta)),
+                        "point_mm": [float(wx[j]), float(wz[j])]}
+log("rack generating fit worst signed penetration %.5f mm at %s"
+    % (rack_worst_pen, rack_wit))
+
+# hob hull path clearance vs approved journal side (y >= 13.78) and full loom
+log("STAGE 5 hob hull path vs approved shaft")
+app_loom_st = list(np.arange(13.5, 20.5 + 1e-9, 0.05)) + list(np.arange(9.4, 13.5, 0.1))
+app_loom = {}
+for y0 in app_loom_st:
+    a, b = plane_segments(APP_V, APP_F, y0)
+    loop = chain_loop(a, b)
+    if len(loop) >= 8:
+        r_out, _ = ray_profile(loop, ANG_LOOM)
+        app_loom[round(float(y0), 3)] = float(r_out.max())
+log("approved loom stations: %d" % len(app_loom))
+
+RETRACT = 2.5
+COLLARS = {"collar_a": (R_FIT + 1.0, 3.0, 8.0), "collar_b": (R_FIT + 1.0, 3.0, -8.0),
+           "arbor": (R_FIT - 1.5, 8.0, -14.5)}
+
+
+def hull_reach_min(delta, Ro, centre_a):
+    """Inner envelope radius of a tilted disc/cylinder hull at station offsets."""
+    d = np.asarray(delta, dtype=float)
+    inner = np.clip(1.0 - (d / (Ro * math.cos(gamma_h))) ** 2, 0.0, 1.0)
+    return np.sqrt((d * math.tan(gamma_h)) ** 2 + (centre_a - Ro * np.sqrt(inner)) ** 2)
+
+
+def hob_path_poses():
+    poses = []
+    a0 = ROOT_R + R_FIT
+    d_exit = a0 + RETRACT
+    for frac in np.arange(0.0, 1.0001, 0.05):
+        poses.append(("infeed", 13.9, d_exit + (a0 + reach_d(13.9) - d_exit) * frac))
+    for yc in np.arange(13.9, 9.5249 - 1e-9, -0.05):
+        poses.append(("feed", float(yc), a0 + (reach_d(float(yc)) - ROOT_R)))
+    for frac in np.arange(0.0, 1.0001, 0.1):
+        poses.append(("retract", 9.5249, a0 + (reach_d(9.5249) - ROOT_R) + RETRACT * frac))
+    for yc in np.arange(9.5249, 14.6, 0.1):
+        poses.append(("withdraw", float(yc), a0 + RETRACT))
+    return poses
+
+
+def reach_d(yc):
+    return float(reach(max(0.0, yc - Y_END), R_FIT, Y_END))
+
+
+hob_pairs = {}
+zone_of = lambda y: ("face" if y < FACE_START else
+                     "gear" if y <= FACE_END else
+                     "ramp" if y <= 13.9 else
+                     "journal" if y <= 14.7 else
+                     "ringgroove" if y <= 15.05 else
+                     "journal2" if y <= 16.6 else "shoulder")
+for phase, yc, ca in hob_path_poses():
+    for y0, rmax in app_loom.items():
+        zone = zone_of(y0)
+        if zone in ("face", "gear"):
+            continue
+        d_hob = float(hull_reach_min(np.array([abs(y0 - yc)]), R_FIT, ca)[0]) - rmax
+        key = "hob_hull_vs_%s" % zone
+        rec = hob_pairs.setdefault(key, {"min": None, "pose": None})
+        if d_hob < 0 and abs(y0 - yc) > R_FIT * math.cos(gamma_h):
+            d_hob = None
+        if d_hob is not None and (rec["min"] is None or d_hob < rec["min"]):
+            rec["min"] = d_hob
+            rec["pose"] = {"phase": phase, "y_centre": float(yc), "centre_dist": float(ca),
+                           "station": float(y0)}
+    for name, (Rc, Lc, s_c) in COLLARS.items():
+        cy = yc + s_c * math.sin(gamma_h)
+        ca_c = math.sqrt((s_c * math.cos(gamma_h)) ** 2 + ca ** 2)
+        for y0, rmax in app_loom.items():
+            zone = zone_of(y0)
+            if zone in ("face", "gear"):
+                continue
+            dy = abs(y0 - cy)
+            if dy > Rc * math.cos(gamma_h):
+                d_c = math.sqrt(max(0.0, ca_c - Rc) ** 2 + 0.0) - rmax
+            else:
+                d_c = float(hull_reach_min(np.array([dy]), Rc, ca_c)[0]) - rmax
+            key = "%s_vs_%s" % (name, zone)
+            rec = hob_pairs.setdefault(key, {"min": None, "pose": None})
+            if d_c is not None and (rec["min"] is None or d_c < rec["min"]):
+                rec["min"] = d_c
+                rec["pose"] = {"phase": phase, "y_centre": float(yc), "station": float(y0)}
+for k in sorted(hob_pairs):
+    log("pair %-24s min %.5f mm pose %s" % (k, hob_pairs[k]["min"], hob_pairs[k]["pose"]))
+
+# hob sanity: envelope reproduces authored ramp
+ramp_repro_max = R_MAX
+
+# ---------------------------------------------------------------- verdicts
+log("STAGE 6 verdicts")
+E_GRID_LOOM = 0.05 * 1.0 / 2 + 0.0005  # station spacing on max slope + angular bin
+E_POSE_PATH = 0.05 / 2
+E_TOTAL_PATH = E_CAD + E_TOOL + E_POSE_PATH + E_GRID_LOOM + 0.001  # + gash scallop
+
+pairs = []
+
+
+def add_pair(name, dmin, etot, margin, ok, pose, note):
+    pairs.append({
+        "pair": name,
+        "min_unsigned_distance_mm": r9(dmin) if dmin is not None else None,
+        "e_total_mm": r9(etot),
+        "margin_mm": margin,
+        "d_minus_e_total_mm": r9(dmin - etot) if dmin is not None else None,
+        "PASS": bool(ok),
+        "pose": pose,
+        "note": note,
+    })
+
+
+tol_gen = E_TOTAL_GEN + max(s["sagitta"] for tag in ("legacy", "approved")
+                            for s in sections[tag].values())
+add_pair("shaper_cutter_vs_legacy_gear_zone", 0.0 if gear_worst_pen < 0 else gear_witness["unsigned_mm"],
+         E_TOTAL_GEN, 0.0, gear_worst_pen <= tol_gen, gear_witness,
+         "generation contact pair; worst signed penetration %.6f mm vs tol %.6f; "
+         "coverage max residual %.5f; unfeasible samples %d"
+         % (gear_worst_pen, tol_gen, cov.max(), infeas_ct))
+add_pair("shaper_cutter_vs_legacy_runout_zone", None, E_TOTAL_GEN, 0.0,
+         runout_worst <= tol_gen, runout_wit,
+         "worst signed penetration %.6f mm vs tol %.6f (generation contact pair)"
+         % (runout_worst, tol_gen))
+add_pair("shaper_tip_vs_groove_floor", groove_min, E_TOTAL_PATH, MARGIN,
+         groove_min - E_TOTAL_PATH >= MARGIN, {"station": groove_at},
+         "ring lower bound; tool inner envelope %.5f" % TOOL_MIN_R)
+add_pair("shaper_leading_rim_vs_journal_step", rim_min, E_TOTAL_PATH, MARGIN,
+         rim_min - E_TOTAL_PATH >= MARGIN, {"witness": rim_at}, "exact ring/station scan")
+add_pair("shaper_cutter_vs_face_side", face_min, E_TOTAL_PATH, MARGIN,
+         face_min - E_TOTAL_PATH >= MARGIN, {}, "ring lower bound below face start")
+add_pair("shaper_holders_vs_shaft", holder_min, E_TOTAL_PATH + 0.13, MARGIN,
+         holder_min - (E_TOTAL_PATH + 0.13) >= MARGIN, {"witness": holder_at},
+         "hub R8.0 L6 / nut R9.0 L3 / arbor R7.0 L12 cylinders; +0.13 ring sampling")
+add_pair("hob_rack_vs_approved_gear_zone", 0.0 if rack_worst_pen < 0 else None,
+         E_TOTAL_GEN, 0.0, rack_worst_pen <= tol_gen, rack_wit,
+         "rack generation contact; worst signed penetration %.6f vs tol %.6f; "
+         "rack strand scatter %.5f" % (rack_worst_pen, tol_gen, RACK_SCATTER))
+ramp_ok = R_MAX <= E_TOTAL_PATH + EPS_STOCK
+add_pair("hob_vs_approved_ramp_reproduction", R_MAX, E_TOTAL_PATH, EPS_STOCK, ramp_ok,
+         {"y_end": Y_END, "stations": int(fit_mask.sum())},
+         "fit residual max %.5f rms %.5f; authored arc R %.4f" % (R_MAX, R_RMS, R_ARC))
+for k in sorted(hob_pairs):
+    dmin = hob_pairs[k]["min"]
+    add_pair(k, dmin, E_TOTAL_PATH, MARGIN,
+             dmin is not None and dmin - E_TOTAL_PATH >= MARGIN, hob_pairs[k]["pose"],
+             "tilted cylinder hull lower bound (conservative)")
+
+all_pass = all(p["PASS"] for p in pairs) and SECTIONS_OK
+verdict = "CERTIFIED" if all_pass else "UNRESOLVED"
+
+report = {
+    "schema": "jgun-g0-clearance-v3/v1",
+    "generated_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+    "exact_command": COMMAND,
+    "spec": "camera/clearance-v3-spec.md",
+    "frame": "shaft-local mm; +Y shaft axis; tool centre on +Z side",
+    "inputs": {
+        "blend": str(BLEND),
+        "blend_sha256_before": blend_sha_before,
+        "baseline_files": {str(k): v for k, v in sorted(hashes_before.items())},
+        "source_registry": str(REGISTRY),
+    },
+    "measured_facts_check": {
+        "tip_r": TIP_R, "root_r": ROOT_R, "face_start": FACE_START,
+        "face_end": FACE_END, "sections_constancy_ok": SECTIONS_OK,
+        "cross_y_constancy_mm": {k: r9(v) for k, v in constancy.items()},
+        "star_shaped_sections": {tag: all(sections[tag][y]["star_shaped"] for y in ("3.5", "6.0", "9.0"))
+                                 for tag in ("legacy", "approved")},
+        "section_min_max_mm": {tag: {y: [r9(sections[tag][y]["min"]), r9(sections[tag][y]["max"])]
+                                     for y in ("3.5", "6.0", "9.0")} for tag in ("legacy", "approved")},
+        "authored_polygon_sagitta_mm": {tag: {y: r9(sections[tag][y]["sagitta"])
+                                              for y in ("3.5", "6.0", "9.0")}
+                                        for tag in ("legacy", "approved")},
+    },
+    "error_budget_mm": {
+        "e_cad": r9(E_CAD), "e_tool": r9(E_TOOL),
+        "e_pose_roll_0p2deg": r9(E_POSE_ROLL), "e_pose_path_0p05mm": r9(E_POSE_PATH),
+        "e_grid_loom": r9(E_GRID_LOOM), "e_total_generation": r9(E_TOTAL_GEN),
+        "e_total_path": r9(E_TOTAL_PATH), "margin_noncontact": MARGIN,
+        "eps_stock": EPS_STOCK,
+    },
+    "shaper": {
+        "shaft": "SHAFT_P001835_ORIG",
+        "teeth": N_SHAPER, "signed_ratio_work_over_cutter": -N_SHAPER / TEETH_W,
+        "centre_distance_mm": SHAPER_C, "work_pitch_radius_mm": r9(r_wp),
+        "cutter_pitch_radius_mm": r9(r_wc),
+        "feasibility_bound_max_qt_mm": r9(feas_bound),
+        "feasibility_satisfied": bool(feas_bound <= r_wp),
+        "cutter_tip_radius_mm": r9(tool_r_arc.max()),
+        "cutter_root_radius_mm": r9(tool_r_arc.min()),
+        "thickness_mm": SHAPER_THICK,
+        "stroke_centre_y_mm": [stroke_c0, stroke_c1],
+        "overtravel_into_groove_mm": r9(overtravel),
+        "infeed": {"band_y_mm": [stroke_c0 - SHAPER_THICK / 2, stroke_c0 + SHAPER_THICK / 2],
+                   "path": "radial -Z at the start band below face start",
+                   "clearance_min_mm": r9(face_min)},
+        "relieved_return": {"illustrative_backoff_mm": return_backoff_illustrative,
+                            "interference_left_mm": r9(return_backoff_illustrative - whole_depth),
+                            "certified_backoff_mm": return_backoff_certified,
+                            "certified_clearance_mm": r9(return_clear)},
+        "holders_mm": HUB,
+        "tool_inner_envelope_radius_mm": r9(TOOL_MIN_R),
+    },
+    "hob": {
+        "shaft": "SHAFT_P001835_HOBBED_NEW",
+        "starts": 1, "normal_module_mm": 1.0, "work_pitch_radius_mm": R_WP_HOB,
+        "fitted_outside_radius_mm": r9(R_FIT), "fit_y_end_mm": r9(Y_END),
+        "fit_residual_rms_mm": r9(R_RMS), "fit_residual_max_mm": r9(R_MAX),
+        "authored_construction_arc_radius_mm": r9(R_ARC),
+        "pitch_radius_mm": r9(rh_h), "lead_angle_deg_asin": r9(math.degrees(gamma_h)),
+        "lead_angle_deg_atan": r9(math.degrees(gamma_atan)), "lead_mm": r9(lead_h),
+        "addendum_mm": r9(R_WP_HOB - ROOT_R),
+        "path": {"infeed": "radial at y=13.9 from retracted distance",
+                 "feed": "arc centre path y 13.9 -> 9.5249 (D = ramp(y) + R_o)",
+                 "retract": "+Z %.1f mm at y=9.5249" % RETRACT,
+                 "withdraw": "axial +Y at retracted distance"},
+        "collars_arbor_mm": {k: v for k, v in COLLARS.items()},
+        "gash_scallop_note": "smooth-thread rack envelope model; 10-gash scallop ~0.001 mm included in e_total_path",
+        "sanity_ramp_reproduction_max_mm": r9(ramp_repro_max),
+    },
+    "pairs": pairs,
+    "verdict": verdict,
+    "determinism": "rerun the exact command; compare report.json with generated_utc removed",
+}
+
+if verdict != "CERTIFIED":
+    report["unresolved"] = [p["pair"] for p in pairs if not p["PASS"]] + (
+        [] if SECTIONS_OK else ["sections_constancy"])
+
+(OUT / "report.json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+json.dump(r9({
+    "shaper_tool_tooth": {"beta_deg": np.degrees(tool_beta).tolist(),
+                          "radius_mm": tool_r_arc.tolist()},
+    "hob_rack": {"u_mm": rack_pts[:, 0].tolist(),
+                 "depth_mm": rack_pts[:, 1].tolist()},
+    "ramp_fit": {"y": fy.tolist(), "floor_r": fr.tolist(),
+                 "model": model.tolist()},
+}), open(OUT / "tools.json", "w"), indent=1)
+log("wrote report.json and tools.json")
+
+# hash recheck
+for p, h in hashes_before.items():
+    if sha256(Path(p)) != h:
+        raise SystemExit("HASH_MISMATCH_AFTER %s" % p)
+blend_sha_after = sha256(BLEND)
+if blend_sha_after != blend_sha_before:
+    raise SystemExit("HASH_MISMATCH_BLEND_AFTER")
+LOG_FH.close()
+print("G0_CLEARANCE_V3 %s pairs=%d pass=%d fail=%d"
+      % (verdict, len(pairs), sum(1 for p in pairs if p["PASS"]),
+         sum(1 for p in pairs if not p["PASS"])), flush=True)

