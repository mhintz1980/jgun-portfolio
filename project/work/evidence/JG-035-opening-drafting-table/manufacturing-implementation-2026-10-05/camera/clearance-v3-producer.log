+add_pair("hob_rack_vs_approved_gear_zone", None, E_TOTAL_GEN, 0.0,
+         rack_worst_pen <= tol_gen, rack_wit,
+         "rack generation contact; worst signed penetration %.6f vs tol %.6f; strand scatter %.5f"
