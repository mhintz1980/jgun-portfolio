import numpy as np, math
d=np.load('profiles.npz')
YS=d['y']; app_ro=d['approved_r_outer']; app_rmin=d['approved_r_min']
Y_LO,H=-0.2,0.01
ROOT_R=4.2918; R=5.87; YC=9.5249; A=ROOT_R+R; g=math.asin(1.0/(2*(R-(5.0-ROOT_R))))
print('g_deg',math.degrees(g))
def hob_points(R,yc,A,g,ds,db,s_lo=-8,s_hi=8,band=1.6):
    s=np.arange(s_lo,s_hi+1e-12,ds); b=np.arange(math.pi-band,math.pi+band+1e-12,db)
    S,B=np.meshgrid(s,b,indexing='ij'); S,B=S.ravel(),B.ravel()
    cg,sg=math.cos(g),math.sin(g)
    x=S*cg+R*np.sin(B)*sg; y=yc+S*sg-R*np.sin(B)*cg; z=A+R*np.cos(B)
    return np.hypot(x,z), y
def meridian_clearance(rho,y,prof,keep,reach=0.8):
    k=int(reach/H); masked=np.where(keep,prof,0.0); win=masked.copy()
    for off in range(1,k+1): win=np.maximum(win,np.maximum(np.roll(masked,off),np.roll(masked,-off)))
    jj=np.clip(np.round((y-Y_LO)/H).astype(int),0,len(YS)-1)
    bound=rho-win[jj]; near=bound<reach
    if not near.any():
        i=int(np.argmin(bound)); return float(bound[i]),float(YS[jj[i]]),float(rho[i]),float(y[i])
    rho,y=rho[near],y[near]; j0=np.round((y-Y_LO)/H).astype(int)
    bd=np.full(len(rho),np.inf); bj=np.zeros(len(rho),dtype=int)
    for off in range(-k,k+1):
        j=np.clip(j0+off,0,len(YS)-1); dy=np.abs(y-YS[j]); drho=rho-prof[j]
        inside=(dy<=H/2)&(drho<=0)
        dd=np.where(inside,drho,np.hypot(np.maximum(drho,0.0),dy)); dd=np.where(keep[j],dd,np.inf)
        b=dd<bd; bd=np.where(b,dd,bd); bj=np.where(b,j,bj)
    i=int(np.argmin(bd)); return float(bd[i]),float(YS[bj[i]]),float(rho[i]),float(y[i])
rho,y=hob_points(R,YC,A,g,0.02,math.radians(0.1))
after=(YS>13.75)&(YS<14.18); turned=after&(app_ro>6.074+0.01); junction=after&~turned; journal=YS>=14.18
app_floor=np.where(np.isfinite(app_rmin),app_rmin,app_ro)
print('junction vs FLOOR  :', meridian_clearance(rho,y,app_floor,junction))
print('junction vs OUTER  :', meridian_clearance(rho,y,app_ro,junction))
print('turned   vs OUTER  :', meridian_clearance(rho,y,app_ro,turned))
# per-station envelope (min rho) in junction for inspection
idx=np.round((y-Y_LO)/H).astype(int); idx=np.clip(idx,0,len(YS)-1)
env=np.full(len(YS),np.inf); np.minimum.at(env,idx,rho)
j=np.nonzero(junction)[0]
for i in j:
    print('y=%.2f env=%s outer=%.4f floor=%.4f'%(YS[i], ('%.4f'%env[i]) if np.isfinite(env[i]) else '   -  ', app_ro[i], app_floor[i]))

