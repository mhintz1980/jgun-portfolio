 102: def profiles(V, F):
 103:     """Exact plane sections every H mm: r_outer (max radius) and r_min (min radius)."""
 104:     ys = np.round(np.arange(Y_LO, Y_HI + 1e-9, H), 6)
 105:     tri_y = V[F][:, :, 1]
 106:     lo, hi = tri_y.min(1), tri_y.max(1)
 107:     order = np.argsort(lo)
 108:     lo_s = lo[order]
 109:     r_out = np.zeros(len(ys))
 110:     r_min = np.full(len(ys), np.nan)
 111:     # Offset planes 0.23 um so no section plane coincides with (float32-noisy) mesh vertices.
 112:     for i, y0 in enumerate(ys + 2.3e-4):
 113:         cand = order[: np.searchsorted(lo_s, y0, side="right")]
 114:         cand = cand[hi[cand] >= y0]
 115:         if len(cand) == 0:
 116:             continue
 117:         T = V[F[cand]]
 118:         d = T[:, :, 1] - y0
 119:         d[np.abs(d) < 1e-9] = 1e-9
 120:         pts = []
 121:         for a, b in ((0, 1), (1, 2), (2, 0)):
 122:             m = d[:, a] * d[:, b] < 0
 123:             t = d[m, a] / (d[m, a] - d[m, b])
 124:             P = T[m, a] + (T[m, b] - T[m, a]) * t[:, None]
 125:             pts.append((np.nonzero(m)[0], P[:, [0, 2]]))
 126:         ids = np.concatenate([p[0] for p in pts])
 127:         P = np.vstack([p[1] for p in pts])
 128:         if len(P) == 0:
 129:             continue
 130:         r_out[i] = np.hypot(P[:, 0], P[:, 1]).max()
 131:         srt = np.argsort(ids, kind="stable")
 132:         ids, P = ids[srt], P[srt]
 133:         pair = np.nonzero(ids[1:] == ids[:-1])[0]
 134:         A, B = P[pair], P[pair + 1]
 135:         E = B - A
 136:         ee = np.maximum((E ** 2).sum(1), 1e-18)
 137:         tt = np.clip(-(A * E).sum(1) / ee, 0, 1)
 138:         r_min[i] = np.hypot(*(A + tt[:, None] * E).T).min()
 139:     # Interior empty stations (seams): fill from neighbours, counted in the report.
 140:     nz = np.nonzero(r_out)[0]
 141:     filled = 0
 142:     for i in range(nz[0] + 1, nz[-1]):
 143:         if r_out[i] == 0:
 144:             r_out[i] = max(r_out[i - 1], r_out[i + 1])
 145:             filled += 1
 146:     FILLED.append(filled)
 147:     # Conservative envelope: max over the neighbouring samples (covers steps between planes).
 148:     r_dil = np.maximum(r_out, np.maximum(np.roll(r_out, 1), np.roll(r_out, -1)))
 149:     r_dil[0], r_dil[-1] = max(r_out[0], r_out[1]), max(r_out[-1], r_out[-2])
 150:     return ys, r_out, r_dil, r_min
