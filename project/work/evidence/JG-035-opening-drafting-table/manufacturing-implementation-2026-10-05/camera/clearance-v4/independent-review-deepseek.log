 200: def rect_clearance(ro, ys, rho0, ya, yb, exclude=None):
 201:     """Min meridian distance from rectangle [rho0, inf) x [ya, yb] to region rho <= r(y)."""
 202:     dy = np.maximum(0.0, np.maximum(ya - ys, ys - yb))
 203:     drho = rho0 - ro
 204:     inside = (dy == 0) & (drho <= 0)
 205:     d = np.where(inside, drho, np.hypot(np.maximum(drho, 0.0), dy))
 206:     if exclude is not None:
 207:         d = np.where(exclude, np.inf, d)
 208:     i = int(np.argmin(d))
 209:     return float(d[i]), float(ys[i])
