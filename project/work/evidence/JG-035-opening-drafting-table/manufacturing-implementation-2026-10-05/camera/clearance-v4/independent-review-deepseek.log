  76:     with open(path, "rb") as fh:
  77:         for chunk in iter(lambda: fh.read(1 << 20), b""):
  78:             h.update(chunk)
  79:     return h.hexdigest()
  80: 
  81: 
  82: if sha256(BLEND) != BLEND_SHA:
  83:     raise SystemExit("HASH_MISMATCH_BEFORE")
