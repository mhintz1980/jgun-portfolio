 260: def hob_points(R, yc, A, g, ds, db, s_lo=-HOB_LEN / 2, s_hi=HOB_LEN / 2, band=1.25):
 261:     s = np.arange(s_lo, s_hi + 1e-12, ds)
 262:     b = np.arange(math.pi - band, math.pi + band + 1e-12, db)
 263:     S, B = np.meshgrid(s, b, indexing="ij")
 264:     S, B = S.ravel(), B.ravel()
 265:     cg, sg = math.cos(g), math.sin(g)
 266:     x = S * cg + R * np.sin(B) * sg
 267:     y = yc + S * sg - R * np.sin(B) * cg
 268:     z = A + R * np.cos(B)
 269:     return np.hypot(x, z), y
