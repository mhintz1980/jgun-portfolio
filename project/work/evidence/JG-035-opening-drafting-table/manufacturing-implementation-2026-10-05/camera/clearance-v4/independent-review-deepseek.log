 307: def meridian_clearance(rho, y, prof, keep, reach=0.8):
 308:     """Min distance from points to region rho <= prof(y') over stations where keep is true."""
 309:     # Prefilter: a point farther than reach (radially, against the window max) cannot be the minimum
 310:     # unless every point is; keep the closest-by-bound points only.
 311:     k = int(reach / H)
 312:     masked = np.where(keep, prof, 0.0)
 313:     win = masked.copy()
 314:     for off in range(1, k + 1):
 315:         win = np.maximum(win, np.maximum(np.roll(masked, off), np.roll(masked, -off)))
 316:     jj = np.clip(np.round((y - Y_LO) / H).astype(int), 0, len(YS) - 1)
 317:     bound = rho - win[jj]
 318:     near = bound < reach
 319:     if not near.any():
 320:         i = int(np.argmin(bound))
 321:         return float(bound[i]), float(YS[jj[i]]), float(rho[i]), float(y[i])
 322:     rho, y = rho[near], y[near]
 323:     j0 = np.round((y - Y_LO) / H).astype(int)
 324:     best_d = np.full(len(rho), np.inf)
 325:     best_j = np.zeros(len(rho), dtype=int)
 326:     for off in range(-k, k + 1):
 327:         j = np.clip(j0 + off, 0, len(YS) - 1)
 328:         dy = np.abs(y - YS[j])
 329:         drho = rho - prof[j]
 330:         inside = (dy <= H / 2) & (drho <= 0)
 331:         d = np.where(inside, drho, np.hypot(np.maximum(drho, 0.0), dy))
 332:         d = np.where(keep[j], d, np.inf)
 333:         better = d < best_d
 334:         best_d = np.where(better, d, best_d)
 335:         best_j = np.where(better, j, best_j)
 336:     i = int(np.argmin(best_d))
 337:     return float(best_d[i]), float(YS[best_j[i]]), float(rho[i]), float(y[i])
