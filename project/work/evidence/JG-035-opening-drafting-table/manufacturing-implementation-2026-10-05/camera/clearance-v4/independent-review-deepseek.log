  88: def mesh_mm(name):
  89:     ob = bpy.data.objects[name]
  90:     assert np.abs(np.array(ob.matrix_world) - np.eye(4)).max() < 1e-9
  91:     me = ob.evaluated_get(deps).to_mesh()
  92:     bm = bmesh.new()
  93:     bm.from_mesh(me)
  94:     bmesh.ops.triangulate(bm, faces=bm.faces)
  95:     V = np.array([v.co[:] for v in bm.verts], dtype=float) * 1000.0
  96:     F = np.array([[v.index for v in f.verts] for f in bm.faces], dtype=np.int64)
  97:     bm.free()
  98:     ob.to_mesh_clear()
  99:     return V, F
