 131: 
 132:     def nid(co):
 133:         k = key_of(co)
 134:         idx = remap.get(k)
 135:         if idx is None:
 136:             idx = len(vlist)
 137:             remap[k] = idx
 138:             vlist.append((k[0], k[1], k[2]))
 139:         return idx
