 797: def hull_points(Rc, s_lo, s_hi, yc, ca, ds_=0.2, db=math.radians(2.0)):
 798:     """Near-side ring points of a coaxial cylinder on the tilted hob axis.
 799: 
 800:     Axis direction a=(cos g, sin g, 0) through (0, yc, ca); radial bases
 801:     z-hat and m=(sin g, -cos g, 0); point = s*a + Rc*(cos b*z + sin b*m).
 802:     """
 803:     s = np.arange(s_lo, s_hi + 1e-9, ds_)
 804:     b = np.arange(math.pi - 0.9, math.pi + 0.9 + 1e-9, db)
 805:     S, Bd = np.meshgrid(s, b, indexing="ij")
 806:     S = S.ravel()
 807:     Bd = Bd.ravel()
 808:     y = yc + S * sg - Rc * np.sin(Bd) * cg
 809:     x = S * cg + Rc * np.sin(Bd) * sg
 810:     z = ca + Rc * np.cos(Bd)
 811:     return y, np.hypot(x, z)
