 386: def conjugate_from_profile(r_out, r_wp, centre=None, ratio=None):
 387:     """Closed-form conjugate: contact where the normal passes the pitch point."""
 388:     nb = len(r_out)
 389:     phi = np.arange(nb) * 2 * math.pi / nb
 390:     dphi = 2 * math.pi / nb
 391:     rp = (np.roll(r_out, -1) - np.roll(r_out, 1)) / (2 * dphi)
 392:     qx = r_out * np.cos(phi)
 393:     qz = r_out * np.sin(phi)
 394:     tx = rp * np.cos(phi) - r_out * np.sin(phi)
 395:     tz = rp * np.sin(phi) + r_out * np.cos(phi)
 396:     tn = np.hypot(tx, tz)
 397:     good = tn > 1e-12
 398:     tx, tz = tx / np.where(good, tn, 1), tz / np.where(good, tn, 1)
 399:     nx, nz = tz, -tx
 400:     rdot = (nx * qx + nz * qz) / r_out
 401:     slope_deg = np.abs(rp) / (math.pi / 180)
 402:     use = good & (rdot > 0.15) & (slope_deg < 50.0)
 403:     qt = qx * tx + qz * tz
 404:     feas = use & (np.abs(qt) <= r_wp - 1e-9)
 405:     k = qt[feas] / r_wp
 406:     psi = np.arctan2(nz[feas], nx[feas])
 407:     ac = np.arccos(np.clip(k, -1, 1))
 408:     th_a = psi - ac
 409:     th_b = psi + ac
 410:     return {"phi": phi, "q": (qx, qz), "t": (tx, tz), "use": use, "feas": feas,
 411:             "theta_a": th_a, "theta_b": th_b,
 412:             "feas_bound": float(np.abs(qt[use]).max()),
 413:             "n_used": int(use.sum()), "n_feas": int(feas.sum())}
 414: 
 415: 
 416: def point_seg_dist_2d(px, pz, A, B):
 417:     E = B - A
 418:     ee = np.maximum((E ** 2).sum(1), 1e-18)
 419:     t = ((px - A[:, 0]) * E[:, 0] + (pz - A[:, 1]) * E[:, 1]) / ee
 420:     t = np.clip(t, 0, 1)
 421:     return np.hypot(px - (A[:, 0] + t * E[:, 0]), pz - (A[:, 1] + t * E[:, 1]))
