 194: # ------------------------------------------------------- section machinery
 195: def plane_segments(V, F, y0, eps=1e-9):
 196:     y = V[:, 1]
 197:     d = y[F] - y0
 198:     d[np.abs(d) < eps] = eps
 199:     pts = []
 200:     tri_ids = []
 201:     for i, j in ((0, 1), (1, 2), (2, 0)):
 202:         di, dj = d[:, i], d[:, j]
 203:         cross = di * dj < 0
 204:         t = -di[cross] / (dj[cross] - di[cross])
 205:         a = V[F[cross, i]]
 206:         b = V[F[cross, j]]
 207:         pts.append(a + (b - a) * t[:, None])
 208:         tri_ids.append(np.nonzero(cross)[0])
 209:     P = np.vstack(pts)[:, [0, 2]]
 210:     tid = np.concatenate(tri_ids)
 211:     counts = np.bincount(tid, minlength=len(F))
 212:     two = counts == 2
 213:     P = P[two[tid]]
 214:     P = P[np.argsort(tid[two[tid]], kind="stable")]
 215:     n = len(P) // 2
 216:     return P[0::2][:n].copy(), P[1::2][:n].copy()
 217: 
 218: 
 219: class SegCloud:
 220:     """Section segment cloud in the (x, z) plane with binned queries."""
 221: 
 222:     def __init__(self, A, B, nbins=720):
 223:         self.A, self.B = A, B
 224:         self.n = len(A)
 225:         self.E = B - A
 226:         self.ee = np.maximum((self.E ** 2).sum(1), 1e-18)
 227:         mid = (A + B) / 2
 228:         self.mid_phi = np.mod(np.arctan2(mid[:, 1], mid[:, 0]), 2 * math.pi)
 229:         self.nbins = nbins
 230:         self.binw = 2 * math.pi / nbins
 231:         bins = (self.mid_phi / self.binw).astype(np.int64) % nbins
 232:         self.order = np.argsort(bins, kind="stable")
 233:         sb = bins[self.order]
 234:         self.starts = np.searchsorted(sb, np.arange(nbins))
 235:         self.ends = np.searchsorted(sb, np.arange(nbins) + 1)
 236:         self._cross_ae = A[:, 0] * self.E[:, 1] - A[:, 1] * self.E[:, 0]
 237: 
 238:     def segs(self, bin_idx, half=2):
 239:         idx = np.concatenate([self.order[self.starts[(bin_idx + k) % self.nbins]:
 240:                                           self.ends[(bin_idx + k) % self.nbins]]
 241:                               for k in range(-half, half + 1)])
 242:         return idx
 243: 
 244:     def min_dist(self, px, pz):
 245:         out = np.full(len(px), np.inf)
 246:         phi = np.mod(np.arctan2(pz, px), 2 * math.pi)
 247:         b = (phi / self.binw).astype(np.int64) % self.nbins
 248:         for bi in range(self.nbins):
 249:             sel = b == bi
 250:             if not sel.any():
 251:                 continue
 252:             S = self.segs(bi)
 253:             if len(S) == 0:
 254:                 continue
 255:             P = np.stack((px[sel], pz[sel]), axis=1)
 256:             AA = self.A[S]
 257:             EE = self.E[S]
 258:             t = ((P[:, None, :] - AA[None, :, :]) * EE[None, :, :]).sum(2) / self.ee[S][None, :]
 259:             t = np.clip(t, 0, 1)
 260:             proj = AA[None, :, :] + t[:, :, None] * EE[None, :, :]
 261:             out[sel] = np.sqrt(((P[:, None, :] - proj) ** 2).sum(2)).min(1)
 262:         return out
 263: 
 264:     def outer_r(self, angles, chunk=90):
 265:         rmax = np.zeros(len(angles))
 266:         hits = np.zeros(len(angles), dtype=np.int64)
 267:         cross_ae = self._cross_ae
 268:         for lo in range(0, len(angles), chunk):
 269:             ang = angles[lo:lo + chunk]
 270:             D0 = np.cos(ang)[:, None]
 271:             D1 = np.sin(ang)[:, None]
 272:             den = D0 * self.E[None, :, 1] - D1 * self.E[None, :, 0]
 273:             A0 = self.A[None, :, 0]
 274:             A1 = self.A[None, :, 1]
 275:             with np.errstate(divide="ignore", invalid="ignore"):
 276:                 t = (A0 * self.E[None, :, 1] - A1 * self.E[None, :, 0]) / den
 277:                 s = (A0 * D1 - A1 * D0) / den
 278:             ok = (np.abs(den) > 1e-12) & (t >= 0) & (s >= 0) & (s <= 1)
 279:             tt = np.where(ok, t, -1.0)
 280:             rmax[lo:lo + chunk] = tt.max(1)
 281:             hits[lo:lo + chunk] = ok.sum(1)
 282:         return rmax, hits
 283: 
 284:     def contains(self, px, pz):
 285:         inside = np.zeros(len(px), dtype=bool)
 286:         rho = np.hypot(px, pz)
 287:         phi = np.mod(np.arctan2(pz, px), 2 * math.pi)
 288:         b = (phi / self.binw).astype(np.int64) % self.nbins
 289:         D0 = np.cos(phi)
 290:         D1 = np.sin(phi)
 291:         for bi in range(self.nbins):
 292:             sel = np.nonzero(b == bi)[0]
 293:             if len(sel) == 0:
 294:                 continue
 295:             S = self.segs(bi)
 296:             if len(S) == 0:
 297:                 continue
 298:             A0 = self.A[S][None, :, 0]
 299:             A1 = self.A[S][None, :, 1]
 300:             E0 = self.E[S][None, :, 0]
 301:             E1 = self.E[S][None, :, 1]
 302:             den = D0[sel, None] * E1 - D1[sel, None] * E0
 303:             with np.errstate(divide="ignore", invalid="ignore"):
 304:                 t = (A0 * E1 - A1 * E0) / den
 305:                 s = (A0 * D1[sel, None] - A1 * D0[sel, None]) / den
 306:             ok = (np.abs(den) > 1e-12) & (t >= 0) & (s >= 0) & (s <= 1) & (t > rho[sel, None] + 1e-9)
 307:             inside[sel] = ok.sum(1) % 2 == 1
 308:         return inside
 309: 
 310: 
 311: def sagitta_profile(phi_arr, r_arr):
 312:     """Max chord sagitta h^2/(8 rho) along an angular profile."""
 313:     if len(r_arr) < 3:
 314:         return 0.0
 315:     P0 = np.column_stack((r_arr * np.cos(phi_arr), r_arr * np.sin(phi_arr)))
 316:     n = len(P0)
 317:     P1 = np.roll(P0, -1, axis=0)
 318:     P2 = np.roll(P0, -2, axis=0)
 319:     a = np.linalg.norm(P1 - P0, axis=1)
 320:     b = np.linalg.norm(P2 - P1, axis=1)
 321:     c = np.linalg.norm(P2 - P0, axis=1)
 322:     area2 = np.abs((P1[:, 0] - P0[:, 0]) * (P2[:, 1] - P0[:, 1])
 323:                    - (P1[:, 1] - P0[:, 1]) * (P2[:, 0] - P0[:, 0]))
 324:     with np.errstate(divide="ignore", invalid="ignore"):
 325:         rho = a * b * c / (2 * area2)
 326:     h = np.maximum(a, b)
 327:     sag = np.where(np.isfinite(rho) & (rho > 0), h * h / (8 * np.where(rho > 0, rho, 1)), 0.0)
 328:     return float(sag.max())
 329: 
 330: 
 331: def fold_profile(r, n_fold=TEETH_W, nbins=720):
 332:     ang = np.arange(len(r)) * 2 * math.pi / len(r)
 333:     fold = np.mod(ang, 2 * math.pi / n_fold)
 334:     bins = (fold / (2 * math.pi / n_fold) * nbins).astype(np.int64) % nbins
 335:     mean = np.zeros(nbins)
 336:     cnt = np.zeros(nbins)
 337:     np.add.at(mean, bins, r)
 338:     np.add.at(cnt, bins, 1)
 339:     mean /= np.maximum(cnt, 1)
 340:     return mean
