 141:     tris = []
 142:     for f in bm.faces:
 143:         ids = [nid(v.co) for v in f.verts]
 144:         for k in range(1, len(ids) - 1):
 145:             a, b, c = ids[0], ids[k], ids[k + 1]
 146:             if a != b and b != c and a != c:
 147:                 tris.append((a, b, c))
 148:     n_raw = (len(me.vertices), len(me.polygons))
 149:     bm.free()
 150:     ob.to_mesh_clear()
 151:     weld = np.array(vlist)
 152:     tri_np = np.array(tris, dtype=np.int64)
 153:     keep = tri_np[tri_np.max(axis=1) < len(weld)]
 154:     return weld, keep, n_raw
