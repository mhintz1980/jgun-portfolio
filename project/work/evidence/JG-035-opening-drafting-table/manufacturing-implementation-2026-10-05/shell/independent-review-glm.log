91:export function enterInspection(trigger: HTMLElement, staticMode: boolean, story?: StoryId, chapter?: number): void  // default story 'ring-p003068': existing 2-arg calls compile and behave the same
92:export function exitInspection(): void           // no-op unless active; clears entry/session; setScrollState(entry) exactly once; sets exiting for one frame
