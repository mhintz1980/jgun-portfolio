64:## 3. Session, load, cancel, compile (new src/scene/inspection/session.ts, owner W1)
65:
66:~~~ts
67:export interface StorySession {
68:  readonly id: number                       // === inspection.epoch at creation
69:  readonly kind: StoryKind
70:  readonly signal: AbortSignal              // aborted by cancel(); pass to every fetch (pattern: InspectionScene.tsx:49-56)
71:  current(): boolean                        // !cancelled && inspection.active && inspection.epoch === id (loadLease.ts:6)
72:  fail(error: unknown): void                // dropped unless current()
73:  own<T extends { dispose(): void }>(r: T): T      // disposed once on cancel
74:  borrowShared(key: string): () => void     // refcount a cached resource; release never disposes it
75:  cancel(): void                            // idempotent; aborts, disposes owned, releases borrowed
76:}
77:export function createStorySession(kind: StoryKind): StorySession
