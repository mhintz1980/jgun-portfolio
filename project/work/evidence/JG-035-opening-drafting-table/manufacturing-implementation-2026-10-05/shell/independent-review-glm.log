71:  return {
72:    advance(deltaMs: number, visible: boolean) {
73:      if (expired || !visible || !session.current() || !Number.isFinite(deltaMs) || deltaMs <= 0) return
74:      elapsed += deltaMs
75:      if (elapsed >= timeoutMs) { expired = true; session.fail(new Error('The inspection could not load. Return or try again.')) }
