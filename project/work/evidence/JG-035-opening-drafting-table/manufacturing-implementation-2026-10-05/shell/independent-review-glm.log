24:## 2. Story descriptors (new file src/scene/inspection/story.ts, owner W1)
25:
26:~~~ts
27:import type { Color, Vector3 } from 'three'
28:export type StoryKind = 'ring' | 'shaft'
29:export type StoryId = 'ring-p003068' | 'shaft-p001835'
30:export interface StoryChapter { id: string; label: string; start: number; end: number }   // seconds, start<end, contiguous
31:export interface StoryAsset { id: string; url: string; tier: 'full' | 'lite' | 'both'; required: boolean; maxBytes: number; sha256: string | null }
32:export interface StoryDescriptor {
33:  readonly id: StoryId; readonly kind: StoryKind; readonly version: 1
34:  readonly duration: number                       // seconds; replaces INSPECTION_DURATION (timeline.ts:1)
35:  readonly chapters: readonly StoryChapter[]       // ring: one chapter 'finish'; shaft: the four plan chapters
36:  readonly assets: readonly StoryAsset[]           // ring: knurling-tool.glb (InspectionScene.tsx:51); shaft: manufacturing bundle
37:  readonly entryWindow: readonly [number, number]  // paced progress where the DOM entry is offered (ring: 0.12-0.525, RingInspection.tsx:90)
38:  readonly staticAlt: string                       // key into the DOM-only static story; must need no GL and no CAD fetch
39:  create(session: StorySession, ctx: StoryContext): StoryRuntime
40:}
41:export interface StoryContext { gl: import('three').WebGLRenderer; scene: import('three').Scene; hero: import('three').Object3D; rig: unknown /* WrenchRig */; tier: 'full' | 'lite'; aspect: number }
42:export interface StoryFrame {            // preallocated by the runtime, mutated in place
43:  time: number; chapter: number; phase: string; discrete: number   // discrete = integer key; DOM updates only when it changes
44:  narrativeAlpha: number                  // 1 narrative fully visible, 0 hidden
45:  returnBlend: number                     // ring: ease((t-10.5)/1.5) (timeline.ts:24); shaft: always 0
46:  ownsNarrative: boolean                  // true for the whole session (never derived from time)
47:}
48:export interface InspectionCameraSample { valid: boolean; position: Vector3; target: Vector3; up: Vector3; fov: number }
49:export interface StoryRuntime {
50:  readonly frame: StoryFrame; readonly camera: InspectionCameraSample; readonly render: RenderSample
51:  sample(time: number): void              // PURE in time: no read of previous time, no accumulators, no allocation
52:  apply(): void                           // writes meshes/materials/lights owned by this runtime from the last sample()
53:  telemetry(out: Record<string, unknown>): void
54:  readonly resources: { geometries: number; materials: number; textures: number; meshes: number }
55:  dispose(): void                         // instance-owned only; idempotent
56:}
57:~~~
58:
59:Rules:
60:- sample(t) after any call sequence equals sample(t) from a fresh runtime (digest equality, section 9 V3). No cumulative cutter angle, chip history, particle state or stamp timers. Chips and stamps are closed-form functions of t with fixed seeds.
61:- Audio, if enabled, is edge-triggered by the playhead driver only when advancing by playback. Seek, chapter jump and replay never fire cues.
62:- Ring adapter: sampleInspection (timeline.ts:13-26) and the ring mesh/tool code in InspectionScene.tsx:96-154 move behind a ring StoryRuntime unchanged in behavior. The ring descriptor reports duration 12.
