+
+import { chromium } from 'playwright'
+const url = 'http://localhost:5199/?chapter=1&inspectionProof=1'
+const browser = await chromium.launch({ channel: 'chrome', headless: true, args: ['--use-angle=d3d11','--disable-background-timer-throttling','--disable-renderer-backgrounding','--disable-backgrounding-occluded-windows'] })
+const ctx = await browser.newContext({ viewport: { width: 1440, height: 960 } })
+const page = await ctx.newPage()
+page.on('pageerror', e => console.log('PAGE-ERR:', e.message))
+page.on('framenavigated', f => { if (f===page.mainFrame()) console.log('NAV:', f.url()) })
+page.on('console', m => { if (m.type()==='error') console.log('CONSOLE-ERR:', m.text()) })
+await page.goto(url, { waitUntil: 'domcontentloaded' })
+await page.reload({ waitUntil: 'domcontentloaded' })
+await page.getByRole('button', { name: 'Inspect the finish' }).waitFor({ state: 'visible', timeout: 120000 })
+await page.waitForFunction(() => window.__rig && window.__telemetry?.performance?.warmReady, null, { timeout: 120000 })
+await page.waitForTimeout(800)
+await page.getByRole('button', { name: /BLUEPRINT WIREFRAME/ }).click()
+await page.waitForTimeout(800)
+console.log('AFTER-BLUEPRINT-HUD', JSON.stringify(await page.evaluate(() => ({ materialMode: window.__telemetry?.scroll?.materialMode, threeScene: !!window.__threeScene, threeCamera: !!window.__threeCamera }))))
+const before = await page.evaluate(() => ({ scrollY, materialMode: window.__telemetry?.scroll?.materialMode ?? null, cam: Array.from(window.__threeCamera.matrixWorld.elements) }))
+await page.getByRole('button', { name: 'Inspect the finish' }).click()
+await page.getByRole('dialog').waitFor({ timeout: 30000 })
+await page.waitForFunction(() => window.__inspection?.loaded && window.__inspectionProof, null, { timeout: 60000 })
+await page.getByRole('button', { name: 'Play sequence', exact: true }).click()
+await page.waitForTimeout(1500)
+console.log('DURING', JSON.stringify(await page.evaluate(() => ({ status: window.__inspection.status, time: window.__inspection.time, threeScene: !!window.__threeScene, materialMode: window.__telemetry?.scroll?.materialMode }))))
+await page.getByRole('button', { name: /Return/ }).focus()
+await page.keyboard.press('Enter')
+await page.getByRole('dialog').waitFor({ state: 'detached', timeout: 15000 })
+for (const delay of [50, 250, 600, 1500, 4000, 10000]) {
+  await page.waitForTimeout(delay === 50 ? 50 : 0)
+}
+await page.waitForTimeout(300)
+console.log('AFTER-RETURN-300ms', JSON.stringify(await page.evaluate(() => ({ threeScene: !!window.__threeScene, threeCamera: !!window.__threeCamera, materialMode: window.__telemetry?.scroll?.materialMode, telemetryScroll: window.__telemetry?.scroll ?? null }))))
+await page.waitForTimeout(4000)
+console.log('AFTER-RETURN-4s', JSON.stringify(await page.evaluate(() => ({ threeScene: !!window.__threeScene, threeCamera: !!window.__threeCamera, materialMode: window.__telemetry?.scroll?.materialMode }))))
+await browser.close()
+

