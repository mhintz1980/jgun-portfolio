const enterDialog = async page => {
  await page.getByRole('button', { name: 'Inspect the finish' }).click()
  await page.getByRole('dialog').waitFor({ timeout: 30000 })
}
const waitLoaded = page => page.waitForFunction(() => window.__inspection?.loaded && window.__inspectionProof, null, { timeout: 60000 })
const returnKey = async page => {
