/** Retry a case once when its evidence was tainted by an unexpected page navigation. */
const runCase = async fn => {
  let outcome
  for (let attempt = 1; attempt <= 4; attempt++) {
    outcome = await fn()
    const results = Array.isArray(outcome) ? outcome : [outcome]
    const tainted = results.some(r => r && r.pass === false && r.navigations?.length > 0)
    if (!tainted) break
    for (const r of results) if (r) { r.superseded = true; r.attempt = attempt }
  }
  const finals = Array.isArray(outcome) ? outcome : [outcome]
  for (const r of finals) if (r && r.attempt === undefined) r.retriedAfterNavigation = true
  return outcome
}

