  await runCase(caseOrderingReadiness)
  await runCase(casePauseHiddenSeek)
  await runCase(caseRestoreDesktop)
  await runCase(caseRestoreNarrow)
  await runCase(caseCensusLifecycle)
  await runCase(caseRingRendering)
} finally {
  await browser.close()
  report.finished = new Date().toISOString()
}

