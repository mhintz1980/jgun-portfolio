+        queueMicrotask(() => {
+          hooks.last = { ...frame, backgroundAfterFrame: scene.background?.getHexString?.() ?? null }
+          for (const callback of hooks.callbacks) callback()
+        })
+      }
+      return value
+    }
+  })
