  const result = { name: 'restore-narrow-escape', gates: ['V3'], errors: [], warnings: [], requests: [], failures: [], measures: {} }
  report.cases.push(result)
  const page = await freshPage(result, { mobile: true })
  await installRestoreWatcher(page)
  try {
