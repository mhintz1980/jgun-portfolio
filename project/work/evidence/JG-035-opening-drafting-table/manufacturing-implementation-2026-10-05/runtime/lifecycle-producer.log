+}
+
+// ---------- Case 6: ring rendering evidence (V5) ----------
+async function caseRingRendering() {
+  const result = { name: 'ring-rendering', gates: ['V5'], errors: [], warnings: [], requests: [], failures: [], measures: { frames: [], shots: [] } }
+  report.cases.push(result)
