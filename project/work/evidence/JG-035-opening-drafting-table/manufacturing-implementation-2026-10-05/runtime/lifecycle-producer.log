+// ---------- Case 3: restore matrix, stale completion, error/retry (V3 desktop) ----------
+async function caseRestoreDesktop() {
+  const result = { name: 'restore-desktop', gates: ['V3'], errors: [], warnings: [], requests: [], failures: [], measures: {}, subs: [] }
+  report.cases.push(result)
+  const page = await freshPage(result)
