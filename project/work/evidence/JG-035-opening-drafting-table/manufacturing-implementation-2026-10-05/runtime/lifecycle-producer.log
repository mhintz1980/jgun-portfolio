+        if (p.status === 'ready' && p.active && !rec.readyFrame) rec.readyFrame = { playing: p.playing, compileReady: p.compileReady, warmReady: p.warmReady, programs: w.__g1Programs ? w.__g1Programs.created : null }
+        if (p.active && p.sampleStamp > 0 && (rec.tuples.length === 0 || p.sampleStamp !== rec.tuples[rec.tuples.length - 1].sampleStamp)) {
