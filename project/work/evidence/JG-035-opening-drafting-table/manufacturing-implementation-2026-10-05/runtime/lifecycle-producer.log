+    await page.waitForFunction(() => window.__telemetry?.performance?.tier === 'poster', null, { timeout: 30000 }).catch(() => {})
+    result.measures.contextLoss.tier = await page.evaluate(() => window.__telemetry?.performance?.tier ?? null)
+    check(result.measures.contextLoss.tier === 'poster', `context loss did not force the poster tier (saw ${result.measures.contextLoss.tier})`)
+    check(result.errors.length === 0, `${result.errors.length} console/page errors; first: ${result.errors[0]}`)
