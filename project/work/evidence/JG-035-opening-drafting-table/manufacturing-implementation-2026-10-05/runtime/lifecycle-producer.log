+    values[name] = Function(...Object.keys(values), `return (${expression})`)(...Object.values(values))
+  }
+  const required = ['INSPECTION_DURATION', 'CONTACT_START', 'TRAVERSE_START', 'TRAVERSE_END', 'CONTACT_END',
