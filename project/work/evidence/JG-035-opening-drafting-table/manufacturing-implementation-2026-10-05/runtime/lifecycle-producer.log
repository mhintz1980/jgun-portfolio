+const cameraMatrices = page => page.evaluate(() => new Promise(resolve => {
+  const mats = []
+  const tick = () => {
+    mats.push(window.__threeCamera ? Array.from(window.__threeCamera.matrixWorld.elements) : null)
+    if (mats.length < 3) requestAnimationFrame(tick)
