+      sub.pass = true
+    } catch (error) {
+      sub.failures.push(error.stack || String(error))
+      report.failures.push(`${sub.name}: ${error}`)
+      sub.pass = false
+    } finally {
+      await sub.context.close()
+    }
+  }
+  // Poster tier (WebGL2 undefined): no canvas, no CAD/tool fetches at all.
+  {
