+async function freshPage(result, config = {}) {
+  const context = await browser.newContext({
+    viewport: config.mobile ? { width: 390, height: 844 } : { width: 1440, height: 960 },
+    reducedMotion: config.reduced ? 'reduce' : 'no-preference',
