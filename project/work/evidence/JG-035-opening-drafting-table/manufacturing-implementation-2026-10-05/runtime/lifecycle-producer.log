+// ---------- Case 2: pause/hidden + seek/replay determinism + endpoint (V2) ----------
+async function casePauseHiddenSeek() {
+  const result = { name: 'pause-hidden-seek-desktop', gates: ['V2'], errors: [], warnings: [], requests: [], failures: [], measures: {} }
+  report.cases.push(result)
