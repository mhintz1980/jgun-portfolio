+function parseTimeline(source) {
+  const values = {}
+  for (const match of source.replace(/\r\n/g, '\n').matchAll(/^export const ([A-Z][A-Z0-9_]*) = ([^\n]+)$/gm)) {
+    const [, name, raw] = match
+    const expression = raw.trim()
