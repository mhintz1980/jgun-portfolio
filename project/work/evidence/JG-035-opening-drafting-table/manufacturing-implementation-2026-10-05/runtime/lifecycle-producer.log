+
+const sceneContext = page => page.evaluate(() => {
+  const scene = window.__threeScene, cam = window.__threeCamera
+  if (!scene || !cam) return { error: 'scene/camera probe missing' }
+  const lights = []
+  scene.traverse(object => {
