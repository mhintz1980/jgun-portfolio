+    result.pass = true
+  } catch (error) {
+    result.failures.push(error.stack || String(error))
+    report.failures.push(`${result.name}: ${error}`)
+    result.pass = false
+  } finally {
+    await result.context.close()
+  }
+  return result
+}
+
+/** Retry a case once when its evidence was tainted by an unexpected page navigation. */
+const runCase = async fn => {
+  let outcome
+  for (let attempt = 1; attempt <= 4; attempt++) {
+    outcome = await fn()
