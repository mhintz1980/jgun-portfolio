+    camera: Array.from(cam.matrixWorld.elements),
+    materialMode: window.__telemetry?.scroll?.materialMode ?? null,
+    progress: window.__telemetry?.scroll?.progress ?? null,
+    chapter: window.__telemetry?.scroll?.chapter ?? null,
