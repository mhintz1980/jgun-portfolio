+    const identifiers = [...expression.matchAll(/[A-Za-z_][A-Za-z0-9_]*/g)].map(m => m[0])
+    if (!identifiers.every(id => id in values)) throw new Error(`timeline const ${name} references unknown identifiers: ${expression}`)
