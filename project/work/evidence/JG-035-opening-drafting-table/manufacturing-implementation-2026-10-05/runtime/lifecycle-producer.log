+// ---------- Case 3: restore matrix, stale completion, error/retry (V3 desktop) ----------
+async function caseRestoreDesktop() {
+  const result = { name: 'restore-desktop', gates: ['V3'], errors: [], warnings: [], requests: [], failures: [], measures: {}, subs: [] }
+  report.cases.push(result)
+  const page = await freshPage(result)
+  try {
+    await page.waitForFunction(() => window.__rig && window.__telemetry?.performance?.warmReady, null, { timeout: 120000 })
+    await page.waitForTimeout(800)
+    for (const mode of ['blueprint', 'exploded']) {
+      const sub = { name: `entry-${mode}` }
+      result.subs.push(sub)
+      await page.getByRole('button', { name: mode === 'blueprint' ? /BLUEPRINT WIREFRAME/ : /EXPLODED ASSEMBLY/ }).click()
+      await page.waitForTimeout(500)
+      const before = await sceneContext(page, { clickEntry: true })
+      await page.getByRole('dialog').waitFor({ timeout: 30000 })
+      await waitLoaded(page)
+      await page.getByRole('button', { name: 'Play sequence', exact: true }).click()
+      await page.waitForTimeout(1500)
+      await page.getByRole('button', { name: /Return/ }).click()
+      await page.getByRole('dialog').waitFor({ state: 'detached', timeout: 15000 })
+      // Read at the restore-observed frame: after it, the narrative camera legitimately
+      // resumes (rest orbit 0.3 deg/s), which is motion, not restore error.
+      await page.waitForFunction(() => window.__inspection && window.__inspection.active === false && window.__inspection.restoreObserved === true, null, { timeout: 10000 })
+      const after = await sceneContext(page)
