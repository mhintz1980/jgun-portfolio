+    for (const time of [...times].reverse()) {
+      await seek(page, time)
+      const repeat = atomicState(page)
+      check(JSON.stringify(repeat) === JSON.stringify(digests.get(time)), `direct seek to ${time} not deterministic across seek orders`)
+    }
