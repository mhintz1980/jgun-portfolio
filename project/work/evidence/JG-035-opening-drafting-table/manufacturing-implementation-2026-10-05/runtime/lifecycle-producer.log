+  await page.waitForTimeout(150)
+}
+
+// ---------- Case 1: ordering / readiness (V1) ----------
+async function caseOrderingReadiness() {
+  const result = { name: 'readiness-ordering-desktop', gates: ['V1'], errors: [], warnings: [], requests: [], failures: [], measures: {} }
+  report.cases.push(result)
+  const page = await freshPage(result, { countPrograms: true })
+  let toolDelay = true
+  await page.route('**/models/knurling-tool.glb', async route => {
+    if (toolDelay) await new Promise(resolve => setTimeout(resolve, 1200))
+    await route.continue()
+  })
