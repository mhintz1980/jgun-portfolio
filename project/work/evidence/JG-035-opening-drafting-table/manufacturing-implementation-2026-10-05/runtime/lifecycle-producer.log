+    last = [c.x, c.y, c.z]
+    if (count > 200) return resolve({ settled: false })
+    setTimeout(tick, 140)
+  }
+  tick()
+}))
+const setHidden = (page, hidden) => page.evaluate(hidden => {
+  if (hidden) {
