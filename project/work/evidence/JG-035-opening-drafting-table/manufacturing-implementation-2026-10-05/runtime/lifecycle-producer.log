+    'TOOL_FADE_START', 'TOOL_FADE_END', 'TOOL_FADE_MIN_CLEARANCE', 'BLACK_FINISH_START', 'RETURN_START', 'FINAL_ANGLE', 'COVERAGE_TIME', 'FORMING_END']
