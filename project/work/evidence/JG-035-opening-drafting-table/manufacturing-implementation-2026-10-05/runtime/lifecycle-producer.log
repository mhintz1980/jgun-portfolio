+// ---------- Case 5: lifecycle census, reduced/poster, context loss (V4) ----------
+async function caseCensusLifecycle() {
+  const result = { name: 'census-lifecycle', gates: ['V4'], errors: [], warnings: [], requests: [], failures: [], measures: { cycles: [] } }
+  report.cases.push(result)
+  const page = await freshPage(result)
