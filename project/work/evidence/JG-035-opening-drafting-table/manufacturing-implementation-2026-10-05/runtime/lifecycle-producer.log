+  }
+  w.requestAnimationFrame(tick)
+})
+const resetRecorder = page => page.evaluate(() => {
+  const r = window.__g1Recorder
+  r.statuses.length = 0; r.tuples.length = 0; r.readyFrame = null; r.framesAfterReady = 0; r.programsAfter60 = null; r.playBeforeReady = false
+})
