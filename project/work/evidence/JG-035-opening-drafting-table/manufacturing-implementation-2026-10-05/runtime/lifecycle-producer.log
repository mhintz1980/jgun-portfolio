+/** Atomic per-frame state digest: telemetry + camera in one synchronous read. */
+const atomicState = page => page.evaluate(() => {
+  const p = window.__inspection, cam = window.__threeCamera
+  const r12 = v => Math.round(v * 1e12) / 1e12
+  return {
+    time: p.time,
+    phase: p.phase,
+    ringAngle: r12(p.ringAngle),
+    odKnurlProgress: r12(p.odKnurlProgress),
+    aluminiumBlend: r12(p.aluminiumBlend),
+    toolClipTime: r12(p.toolClipTime),
+    toolVisible: p.toolVisible,
+    toolOpacity: r12(p.toolOpacity ?? -1),
+    trueSpin: r12(p.trueSpin ?? -1),
+    narrativeAlpha: r12(p.narrativeAlpha),
+    camera: cam ? Array.from(cam.matrixWorld.elements).map(r12) : null,
+  }
+})
