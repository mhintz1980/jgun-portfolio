207:/** Set the object-to-shaft-local matrix once per mesh (or per frame if the object moves). */
208:export function setShaftTransform(uniforms: ProgressionUniforms, objectToShaft: Matrix4): void {
209:  uniforms.uShaftMatrix.value.copy(objectToShaft)
210:  uniforms.uShaftInverse.value.copy(objectToShaft).invert()
211:  uniforms.uShaftNormalMatrix.value.getNormalMatrix(uniforms.uShaftInverse.value)
212:}
