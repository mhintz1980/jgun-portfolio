21:// Explicit host callbacks keep the session and descriptor modules independent of the store.
22:export function createStorySession(kind: StoryKind, lifecycle: StorySessionLifecycle): StorySession {
23:  const controller = new AbortController()
24:  const owned = new Set<{ dispose(): void }>()
25:  const disposed = new WeakSet<object>()
26:  const borrowed = new Set<() => void>()
27:  let cancelled = false
28:  function dispose(resource: { dispose(): void }) {
29:    if (disposed.has(resource)) return
30:    disposed.add(resource)
31:    // One broken resource must not prevent abort/restore or the remaining releases.
32:    try { resource.dispose() } catch { /* Context loss can make resource cleanup fail. */ }
33:  }
34:  const current = () => !cancelled && lifecycle.current()
35:  return {
36:    id: lifecycle.id, kind, signal: controller.signal, current,
37:    fail(error) { if (current()) lifecycle.fail(error) },
38:    own(resource) {
39:      if (!current()) dispose(resource)
40:      else owned.add(resource)
41:      return resource
42:    },
43:    borrowShared(key) {
44:      if (!current()) return () => {}
45:      sharedReferences.set(key, sharedStoryRefCount(key) + 1)
46:      let released = false
47:      const release = () => {
48:        if (released) return
49:        released = true
50:        const count = sharedStoryRefCount(key) - 1
51:        if (count > 0) sharedReferences.set(key, count)
52:        else sharedReferences.delete(key)
53:        borrowed.delete(release)
54:      }
55:      borrowed.add(release)
56:      return release
57:    },
58:    cancel() {
59:      if (cancelled) return
60:      cancelled = true
61:      controller.abort()
62:      owned.forEach(dispose); owned.clear()
63:      borrowed.forEach(release => release()); borrowed.clear()
64:    },
65:  }
66:}
