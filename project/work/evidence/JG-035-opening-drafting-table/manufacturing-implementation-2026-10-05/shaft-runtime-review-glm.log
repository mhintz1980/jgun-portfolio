214:const MODE_VALUE: Readonly<Record<ProgressionMode, number>> = { none: 0, shaping: 1, hobbing: 2 }
215:const STRESS_VALUE: Readonly<Record<StressOverlay['kind'], number>> = { none: 0, warm: 1, cool: 2 }
216:
217:/** Write the per-frame progression uniforms in place (no allocation). */
218:export function writeProgressionUniforms(
219:  uniforms: ProgressionUniforms,
220:  state: ProgressionState,
221:  shaft?: ProgressionShaft,
222:): void {
223:  const resolved: ProgressionShaft = shaft ?? (state.mode === 'hobbing' ? 'approved' : 'legacy')
224:  uniforms.uProgressionMode.value = MODE_VALUE[state.mode]
225:  uniforms.uShaftKind.value = resolved === 'approved' ? 1 : 0
226:  uniforms.uFaceEnd.value = resolved === 'approved' ? HOBBING_FACE_END_MM : SHAPING_FACE_END_MM
227:  const depth = uniforms.uSpaceDepth.value
228:  const source = state.spaceDepth
229:  for (let i = 0; i < SHAFT_SPACES; i++) depth[i] = source[i]
230:  uniforms.uEngagedSpace.value = state.engagedSpace
231:  uniforms.uEngagedPreviousDepth.value = state.engagedPreviousDepth ?? 0
232:  uniforms.uEdgeY.value = state.edgeY
233:  uniforms.uHobYc.value = state.hobYc
234:  uniforms.uHobA.value = state.hobA
235:  uniforms.uHobR.value = state.hobR
236:}
237:
238:/** Write the stress-overlay uniforms in place (no allocation). */
239:export function writeStressUniforms(uniforms: ProgressionUniforms, stress: StressOverlay): void {
240:  uniforms.uStressKind.value = STRESS_VALUE[stress.kind]
241:  uniforms.uStressMix.value = stress.mix
242:  uniforms.uStressScanProgress.value = stress.scanProgress
243:  uniforms.uStressYMin.value = stress.yMin
244:  uniforms.uStressYMax.value = stress.yMax
245:  uniforms.uStressRMax.value = stress.rMax
246:}
