49:export const SPACE_PITCH_RAD = (Math.PI * 2) / SHAFT_SPACES
50:/**
51: * Azimuth (rad, shaft-local) of the centre of tooth space 0. Recovered by
52: * progression.test.ts from profile-study.json legacy 6.0 polar data: the 10 tooth-tip
53: * centroids sit at 18 deg + 36 deg k, so the space centres sit at 0 + 36 deg k.
54: */
55:export const SPACE_CLOCK_RAD = 0
56:/** Tooth tip radius = measured OD of the legacy face band. */
57:export const SHAFT_OD_MM = 6.083507443359969
58:/** Tooth-space floor radius = measured root of the approved face band. */
59:export const SHAFT_ROOT_MM = 4.29182859636582
60:/** First tooth-space material y (legacy pilot end). */
61:export const FACE_START_MM = 3.1749
62:/** Legacy last tooth material y: the shaping band ends here. */
63:export const SHAPING_FACE_END_MM = 9.875
64:/** Approved ramp end y: the hobbing band ends here. */
65:export const HOBBING_FACE_END_MM = 13.78
