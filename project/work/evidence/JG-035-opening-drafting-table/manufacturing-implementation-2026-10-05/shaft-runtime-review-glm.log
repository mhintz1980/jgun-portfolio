248:const VERTEX_COMMON = /* glsl */ `
249:uniform mat4 uShaftMatrix;
250:uniform mat4 uShaftInverse;
251:uniform mat3 uShaftNormalMatrix;
252:uniform float uProgressionMode;
253:uniform float uShaftKind;
254:uniform float uSpaceDepth[10];
255:uniform float uSpacePitch;
256:uniform float uSpaceClock;
257:uniform float uEngagedSpace;
258:uniform float uEngagedPreviousDepth;
259:uniform float uEdgeY;
260:uniform float uHobYc;
261:uniform float uHobA;
262:uniform float uHobR;
263:uniform float uFaceStart;
264:uniform float uFaceEnd;
265:uniform float uShaftOD;
266:uniform float uShaftRoot;
267:varying vec3 vShaftLocal;
268:// ${PROGRESSION_LAW_MARKER}
269:float jgEffectiveMode() {
270:  if (uProgressionMode > 1.5) return uShaftKind > 0.5 ? 2.0 : 0.0;
271:  if (uProgressionMode > 0.5) return uShaftKind < 0.5 ? 1.0 : 0.0;
272:  return 0.0;
273:}
274:float jgProgressedRadius(vec3 jgLocal, out float jgClamped) {
275:  float jgRadius = length(jgLocal.xz);
276:  float jgNew = jgRadius;
277:  jgClamped = 0.0;
278:  float jgMode = jgEffectiveMode();
279:  if (jgMode > 0.5 && jgLocal.y >= uFaceStart && jgLocal.y <= uFaceEnd) {
280:    if (jgMode < 1.5) {
281:      if (jgRadius < uShaftOD) {
282:        // atan(0, 0) is undefined in GLSL; use the CPU atan2(0, 0) convention (+X).
283:        float jgAngle = jgRadius > 0.0 ? atan(jgLocal.z, jgLocal.x) : 0.0;
284:        float jgSpace = mod(floor((jgAngle - uSpaceClock) / uSpacePitch + 0.5), 10.0);
285:        float jgDepth = uSpaceDepth[int(jgSpace)];
286:        if (abs(uEngagedSpace - jgSpace) < 0.5 && jgLocal.y > uEdgeY) jgDepth = uEngagedPreviousDepth;
287:        jgNew = min(uShaftOD, jgRadius + (1.0 - jgDepth) * (uShaftOD - uShaftRoot));
288:      }
289:    } else {
290:      float jgFloor = uShaftOD;
291:      if (jgLocal.y <= uHobYc) {
292:        jgFloor = uShaftRoot;
293:      } else if (jgLocal.y < uHobYc + uHobR) {
294:        float jgDy = jgLocal.y - uHobYc;
295:        jgFloor = uHobA - sqrt(max(0.0, uHobR * uHobR - jgDy * jgDy));
296:      }
297:      jgNew = max(jgRadius, min(uShaftOD, jgFloor));
298:    }
299:    // Preserve original normals in the finished state and on untouched journal/tip vertices.
300:    if (jgNew > jgRadius + 0.000001 && jgNew > uShaftOD - 0.0001) jgClamped = 1.0;
301:  }
302:  return jgNew;
303:}
