1:/**
2: * JG-035 shaft tooling leaf: illustrative shaper cutter and hob props.
3: *
4: * Both builders return a Group in metres, centred on the tool's own axis, with the axis
5: * documented below. Materials are supplied by the caller (steel instances) and are never
6: * disposed here; dispose() releases only the geometry this module creates.
7: *
8: *   buildShaperCutter - cutter axis parallel to the shaft axis (local +Y). The disc is one
9: *     20-tooth ExtrudeGeometry (depth 1.2 mm) from cutterOutline.json; the trailing stack is
10: *     hub, clamp nut then arbor along -Y, so the leading (+Y) face stays clear of the cut.
11: *   buildHob - hob axis is the group's local +Y; the root quaternion points it along the
12: *     clearance-v4 axis (cos(lead), sin(lead), 0) in the shaft-local CAD frame, i.e. perpendicular
13: *     to the shaft axis and tilted by the lead angle. Collars and arbor are coaxial.
14: */
15:import {
16:  BufferGeometry,
17:  CylinderGeometry,
18:  ExtrudeGeometry,
19:  Group,
20:  InstancedMesh,
21:  Matrix4,
22:  Mesh,
23:  Object3D,
24:  Quaternion,
25:  Shape,
26:  Vector3,
27:} from 'three'
28:import type { Material } from 'three'
29:import outlineData from './cutterOutline.json'
30:import {
31:  HOB_ARBOR_LENGTH_MM,
32:  HOB_ARBOR_RADIUS_MM,
33:  HOB_COLLAR_RADIUS_MM,
34:  HOB_COLLAR_WIDTH_MM,
35:  HOB_LEAD_ANGLE_DEG,
36:  HOB_LEAD_MM,
37:  HOB_LENGTH_MM,
38:  HOB_RADIUS_MM,
39:  HOB_THREAD_DEPTH_MM,
40:  SHAPER_ARBOR_LENGTH_MM,
41:  SHAPER_ARBOR_RADIUS_MM,
42:  SHAPER_CLAMP_LENGTH_MM,
43:  SHAPER_CLAMP_RADIUS_MM,
44:  SHAPER_HUB_LENGTH_MM,
45:  SHAPER_HUB_RADIUS_MM,
46:  SHAPER_TEETH,
47:  SHAPER_THICKNESS_MM,
48:} from './toolSpec'
49:
50:const MM = 1e-3
51:const DEG = Math.PI / 180
52:/** Points kept per tooth when triangulating the shaper disc; the file keeps the full 0.05 deg polyline. */
53:const SHAPE_POINTS_PER_TOOTH = 90
54:/** Trapezoid thread instances per helix turn (5 deg of cutter rotation each). */
55:const HOB_INSTANCES_PER_TURN = 72
56:const HOB_GASH_COUNT = 10
57:const HOB_GASH_HALF_WIDTH_DEG = 3
58:const Y_AXIS = new Vector3(0, 1, 0)
59:
60:interface CutterOutlineFile {
61:  schema: string
62:  tooth: { angle_span_deg: number; point_count: number; min_radius_mm: number; max_radius_mm: number; points: number[][] }
63:}
64:
65:const OUTLINE = outlineData as unknown as CutterOutlineFile
66:
67:export interface ShaperCutter {
68:  readonly root: Group
69:  /** Rake-face point at the cutter crest on the leading (+Y) face, in the root's local metre frame. */
70:  readonly cuttingEdgeLocal: Vector3
71:  dispose(): void
72:}
73:
74:export interface HobProp {
75:  readonly root: Group
76:  dispose(): void
77:}
78:
79:/** Keep every stride-th outline point, always preserving index 0. */
80:function decimateTooth(points: number[][], target: number): number[][] {
81:  const stride = Math.max(1, Math.ceil(points.length / target))
82:  const kept: number[][] = []
83:  for (let i = 0; i < points.length; i += stride) kept.push(points[i])
84:  if (kept[kept.length - 1] !== points[points.length - 1]) kept.push(points[points.length - 1])
85:  return kept
86:}
87:
88:export function buildShaperCutter(material: Material): ShaperCutter {
89:  const root = new Group()
90:  root.name = 'shaper-cutter'
91:
92:  const span = OUTLINE.tooth.angle_span_deg
93:  const tooth = decimateTooth(OUTLINE.tooth.points, SHAPE_POINTS_PER_TOOTH)
94:  const shape = new Shape()
95:  let tipRadius = 0
96:  let tipAngle = 0
97:  for (let t = 0; t < SHAPER_TEETH; t++) {
98:    for (let i = 0; i < tooth.length; i++) {
99:      const angle = tooth[i][0] + t * span * DEG
100:      const radius = tooth[i][1]
101:      const x = radius * Math.cos(angle)
102:      const y = radius * Math.sin(angle)
103:      if (t === 0 && i === 0) shape.moveTo(x, y)
104:      else shape.lineTo(x, y)
105:      if (radius > tipRadius) {
106:        tipRadius = radius
107:        tipAngle = angle
108:      }
109:    }
110:  }
111:  shape.closePath()
112:
113:  const discGeometry = new ExtrudeGeometry(shape, { depth: SHAPER_THICKNESS_MM, bevelEnabled: false, steps: 1, curveSegments: 1 })
114:  // Certified stroke positions are disc-centre positions; the leading face is +thickness/2.
115:  discGeometry.translate(0, 0, -SHAPER_THICKNESS_MM / 2)
116:  discGeometry.rotateX(-Math.PI / 2)
117:  discGeometry.scale(MM, MM, MM)
118:  const disc = new Mesh(discGeometry, material)
119:  disc.name = 'shaper-cutter-disc'
120:  root.add(disc)
121:
122:  const trailing = [
123:    { name: 'shaper-hub', radius: SHAPER_HUB_RADIUS_MM, length: SHAPER_HUB_LENGTH_MM, y: -SHAPER_THICKNESS_MM / 2 - SHAPER_HUB_LENGTH_MM / 2 },
124:    {
125:      name: 'shaper-clamp-nut',
126:      radius: SHAPER_CLAMP_RADIUS_MM,
127:      length: SHAPER_CLAMP_LENGTH_MM,
128:      y: -SHAPER_THICKNESS_MM / 2 - SHAPER_HUB_LENGTH_MM - SHAPER_CLAMP_LENGTH_MM / 2,
129:    },
130:    {
131:      name: 'shaper-arbor',
132:      radius: SHAPER_ARBOR_RADIUS_MM,
133:      length: SHAPER_ARBOR_LENGTH_MM,
134:      y: -SHAPER_THICKNESS_MM / 2 - SHAPER_HUB_LENGTH_MM - SHAPER_CLAMP_LENGTH_MM - SHAPER_ARBOR_LENGTH_MM / 2,
135:    },
136:  ]
137:  const geometries: BufferGeometry[] = [discGeometry]
138:  for (const part of trailing) {
139:    const geometry = new CylinderGeometry(part.radius * MM, part.radius * MM, part.length * MM, 24, 1, false)
140:    geometries.push(geometry)
141:    const mesh = new Mesh(geometry, material)
142:    mesh.name = part.name
143:    mesh.position.y = part.y * MM
144:    root.add(mesh)
145:  }
146:
147:  const cuttingEdgeLocal = new Vector3(
148:    tipRadius * MM * Math.cos(tipAngle),
149:    SHAPER_THICKNESS_MM / 2 * MM,
150:    -tipRadius * MM * Math.sin(tipAngle),
151:  )
152:
153:  return { root, cuttingEdgeLocal, dispose: makeDisposer(geometries) }
154:}
155:
156:export function buildHob(material: Material): HobProp {
157:  const root = new Group()
158:  root.name = 'hob'
159:  const geometries: BufferGeometry[] = []
160:
161:  const bodyRadius = HOB_RADIUS_MM - HOB_THREAD_DEPTH_MM
162:  const bodyGeometry = new CylinderGeometry(bodyRadius * MM, bodyRadius * MM, HOB_LENGTH_MM * MM, 32, 1, false)
163:  geometries.push(bodyGeometry)
164:  const body = new Mesh(bodyGeometry, material)
165:  body.name = 'hob-body'
166:  root.add(body)
167:
168:  const collarGeometry = new CylinderGeometry(HOB_COLLAR_RADIUS_MM * MM, HOB_COLLAR_RADIUS_MM * MM, HOB_COLLAR_WIDTH_MM * MM, 24, 1, false)
169:  geometries.push(collarGeometry)
170:  for (const sign of [-1, 1]) {
171:    const collar = new Mesh(collarGeometry, material)
172:    collar.name = sign < 0 ? 'hob-collar-drive' : 'hob-collar-free'
173:    collar.position.y = sign * (HOB_LENGTH_MM / 2 + HOB_COLLAR_WIDTH_MM / 2) * MM
174:    root.add(collar)
175:  }
176:
177:  const arborGeometry = new CylinderGeometry(HOB_ARBOR_RADIUS_MM * MM, HOB_ARBOR_RADIUS_MM * MM, HOB_ARBOR_LENGTH_MM * MM, 24, 1, false)
178:  geometries.push(arborGeometry)
179:  const arbor = new Mesh(arborGeometry, material)
180:  arbor.name = 'hob-arbor'
181:  arbor.position.y = (HOB_LENGTH_MM / 2 + HOB_COLLAR_WIDTH_MM + HOB_ARBOR_LENGTH_MM / 2) * MM
182:  root.add(arbor)
183:
184:  // Single-start helical thread approximated by trapezoid instances placed along the helix.
185:  const axialHalfRoot = HOB_LEAD_MM * 0.25
186:  const axialHalfCrest = Math.max(0.05, axialHalfRoot - HOB_THREAD_DEPTH_MM * 0.2)
187:  const tangentialWidth = (HOB_RADIUS_MM * 2 * Math.PI) / HOB_INSTANCES_PER_TURN
188:  // A tangential extrusion otherwise puts crest corners outside the certified cylinder.
189:  const crestRadius = Math.sqrt(HOB_RADIUS_MM ** 2 - (tangentialWidth / 2) ** 2)
190:  const threadShape = new Shape()
191:  threadShape.moveTo(bodyRadius, -axialHalfRoot)
192:  threadShape.lineTo(crestRadius, -axialHalfCrest)
193:  threadShape.lineTo(crestRadius, axialHalfCrest)
194:  threadShape.lineTo(bodyRadius, axialHalfRoot)
195:  threadShape.closePath()
196:  const threadGeometry = new ExtrudeGeometry(threadShape, { depth: tangentialWidth, bevelEnabled: false, steps: 1, curveSegments: 1 })
197:  threadGeometry.translate(0, 0, -tangentialWidth / 2)
198:  threadGeometry.scale(MM, MM, MM)
199:  geometries.push(threadGeometry)
200:
201:  const yPositions: number[] = []
202:  const angles: number[] = []
203:  const gashCentres = new Float64Array(HOB_GASH_COUNT)
204:  for (let g = 0; g < HOB_GASH_COUNT; g++) gashCentres[g] = (360 / HOB_GASH_COUNT) * g
205:  for (let i = 0; ; i++) {
206:    // Keep the complete trapezoid inside the certified 16 mm axial cutting-body span.
207:    const y = -HOB_LENGTH_MM / 2 + axialHalfRoot + (i / HOB_INSTANCES_PER_TURN) * HOB_LEAD_MM
208:    if (y + axialHalfRoot > HOB_LENGTH_MM / 2 + 1e-9) break
209:    const deg = (i % HOB_INSTANCES_PER_TURN) * (360 / HOB_INSTANCES_PER_TURN)
210:    let gash = false
211:    for (let g = 0; g < HOB_GASH_COUNT; g++) {
212:      const delta = Math.abs(deg - gashCentres[g])
213:      if (Math.min(delta, 360 - delta) <= HOB_GASH_HALF_WIDTH_DEG) {
214:        gash = true
215:        break
216:      }
217:    }
218:    if (gash) continue
219:    yPositions.push(y)
220:    angles.push((i % HOB_INSTANCES_PER_TURN) * (2 * Math.PI / HOB_INSTANCES_PER_TURN))
221:  }
222:
223:  const thread = new InstancedMesh(threadGeometry, material, yPositions.length)
224:  thread.name = 'hob-thread'
225:  const matrix = new Matrix4()
226:  const quaternion = new Quaternion()
227:  const position = new Vector3()
228:  const scale = new Vector3(1, 1, 1)
229:  for (let k = 0; k < yPositions.length; k++) {
230:    quaternion.setFromAxisAngle(Y_AXIS, angles[k])
231:    position.set(0, yPositions[k] * MM, 0)
232:    matrix.compose(position, quaternion, scale)
233:    thread.setMatrixAt(k, matrix)
234:  }
235:  thread.instanceMatrix.needsUpdate = true
236:  root.add(thread)
237:
238:  // Ten axial gashes: the thread instances are omitted inside each window, so the smooth body
239:  // reads as the flute floor. Named anchors keep the gash phase available downstream.
240:  for (let g = 0; g < HOB_GASH_COUNT; g++) {
241:    const anchor = new Object3D()
242:    anchor.name = 'hob-gash-' + g
243:    anchor.rotation.y = (2 * Math.PI / HOB_GASH_COUNT) * g
244:    root.add(anchor)
245:  }
246:
247:  // Hob axis = perpendicular to the shaft axis, tilted by the lead angle (clearance-v4 axis).
248:  const axis = new Vector3(Math.cos(HOB_LEAD_ANGLE_DEG * DEG), Math.sin(HOB_LEAD_ANGLE_DEG * DEG), 0).normalize()
249:  root.quaternion.setFromUnitVectors(Y_AXIS, axis)
250:
251:  const disposeGeometry = makeDisposer(geometries)
252:  let disposed = false
253:  return { root, dispose() {
254:    if (disposed) return
255:    disposed = true
256:    thread.dispose()
257:    disposeGeometry()
258:  } }
259:}
