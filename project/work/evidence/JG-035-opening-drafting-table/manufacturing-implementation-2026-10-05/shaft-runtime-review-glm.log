361:/**
362: * Patch a standard/physical material with the progression law and stress overlay.
363: *
364: * The caller owns the `uniforms` object (createProgressionUniforms), updates it each frame
365: * with writeProgressionUniforms/writeStressUniforms, and disposes the material. This takes
366: * ownership of material.onBeforeCompile.
367: */
368:export function applyProgression(
369:  material: MeshStandardMaterial | MeshPhysicalMaterial,
370:  uniforms: ProgressionUniforms,
371:): Material {
372:  material.onBeforeCompile = (shader) => {
373:    for (const key of Object.keys(uniforms) as (keyof ProgressionUniforms)[]) {
374:      shader.uniforms[key] = uniforms[key]
375:    }
376:    shader.vertexShader = shader.vertexShader
377:      .replace('#include <common>', '#include <common>\n' + VERTEX_COMMON)
378:      .replace('#include <beginnormal_vertex>', NORMAL_CHUNK)
379:      .replace('#include <begin_vertex>', VERTEX_CHUNK)
380:    shader.fragmentShader = shader.fragmentShader
381:      .replace('#include <common>', '#include <common>\n' + FRAGMENT_COMMON)
382:      .replace('#include <emissivemap_fragment>', STRESS_CHUNK)
383:  }
384:  material.customProgramCacheKey = () => 'jgun-shaft-progression-v2'
385:  material.needsUpdate = true
386:  return material
387:}

