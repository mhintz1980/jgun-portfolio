316:const NORMAL_CHUNK = /* glsl */ `
317:#include <beginnormal_vertex>
318:// ${PROGRESSION_NORMAL_MARKER}
319:{
320:  vec4 jgNormalLocal = uShaftMatrix * vec4(position, 1.0);
321:  float jgNormalClamp;
322:  jgProgressedRadius(jgNormalLocal.xyz, jgNormalClamp);
323:  if (jgNormalClamp > 0.5) {
324:    vec3 jgRadialLocal = length(jgNormalLocal.xz) > 0.0
325:      ? normalize(vec3(jgNormalLocal.x, 0.0, jgNormalLocal.z)) : vec3(1.0, 0.0, 0.0);
326:    vec3 jgRadialObject = normalize(uShaftNormalMatrix * jgRadialLocal);
327:    objectNormal = normalize(mix(objectNormal, jgRadialObject, jgNormalClamp));
328:  }
329:}
330:`
331:
332:const VERTEX_CHUNK = /* glsl */ `
333:// ${PROGRESSION_VERTEX_MARKER}
334:vec4 jgLocal4 = uShaftMatrix * vec4(position, 1.0);
335:float jgClamp;
336:float jgNewRadius = jgProgressedRadius(jgLocal4.xyz, jgClamp);
337:float jgOldRadius = length(jgLocal4.xz);
338:float jgScale = jgOldRadius > 0.0 ? jgNewRadius / jgOldRadius : 1.0;
339:vec3 jgLocalNew = jgOldRadius > 0.0
340:  ? vec3(jgLocal4.x * jgScale, jgLocal4.y, jgLocal4.z * jgScale)
341:  : vec3(jgNewRadius, jgLocal4.y, 0.0);
342:vShaftLocal = jgLocalNew;
343:vec3 transformed = (uShaftInverse * vec4(jgLocalNew, 1.0)).xyz;
344:`
345:
346:const STRESS_CHUNK = /* glsl */ `
347:#include <emissivemap_fragment>
348:// ${STRESS_MARKER}
349:if (uStressKind > 0.5 && uStressMix > 0.001) {
350:  float jgStressInBand = step(uStressYMin, vShaftLocal.y) * (1.0 - step(uStressYMax, vShaftLocal.y));
351:  float jgStressRadius = length(vShaftLocal.xz);
352:  float jgStressInR = (1.0 - step(uStressRMax, jgStressRadius)) * step(0.0001, jgStressRadius);
353:  float jgStressEdge = mix(uStressYMin, uStressYMax, clamp(uStressScanProgress, 0.0, 1.0));
354:  float jgStressScanned = 1.0 - smoothstep(jgStressEdge - 0.05, jgStressEdge + 0.05, vShaftLocal.y);
355:  float jgStressMask = jgStressInBand * jgStressInR * jgStressScanned * clamp(uStressMix, 0.0, 1.0);
356:  vec3 jgStressTint = uStressKind < 1.5 ? vec3(1.0, 0.42, 0.16) : vec3(0.18, 0.72, 0.95);
357:  totalEmissiveRadiance += jgStressTint * jgStressMask * 0.35;
358:}
