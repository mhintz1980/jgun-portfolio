432:export function sampleShaftKinematics(time: number, out: ShaftKinematicsFrame): ShaftKinematicsFrame {
433:  const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time
434:  const m = machiningTimeAt(t)
435:  const rate = machiningRateAt(t)
436:  const shaping = t >= T_SHAPING_START && t < T_SHAPING_END
437:  const hobbing = t >= 25 && t < T_HOB_END
438:
439:  out.time = t
440:  out.machining = m
441:  out.machiningRate = rate
442:  out.mode = shaping ? 'shaping' : hobbing ? 'hobbing' : 'none'
443:  out.followAzimuth = FOLLOW_GAIN * followMfAt(t)
444:  out.followWeight = followWeightAt(t)
445:
446:  // shaper
447:  const mShaping = shaping || t < T_SHAPING_START ? m : t >= T_SHAPING_END ? MACHINING_AT_SHAPING_END : m
448:  const cutterPhi = CUTTER_RATE * mShaping
449:  const workPhi = SHAPER_SIGNED_RATIO * cutterPhi
450:  const phase = strokePhaseAt(mShaping)
451:  const cuttingStroke = phase < 0.5
452:  const yc = strokeCentreYAt(mShaping)
453:  const edgeY = yc + SHAPER_THICKNESS_MM * 0.5
454:  const backoff = backoffAt(mShaping)
455:  const infeedRho = infeedRhoAt(mShaping)
456:  out.cutterPhi = cutterPhi
457:  out.workPhi = workPhi
458:  out.strokeCentreY = yc
459:  out.edgeY = edgeY
460:  out.strokePhase = phase
461:  out.cutting = cuttingStroke
462:  out.returning = !cuttingStroke
463:  out.backoff = backoff
464:  out.cutterRho = infeedRho + backoff
465:
466:  for (let i = 0; i < SHAFT_SPACES; i++) {
467:    const depth = countedPasses(mShaping, i) / SPACE_PASSES_REQUIRED
468:    out.spaceDepth[i] = depth > 1 ? 1 : depth
469:  }
470:  const inStock = shaping && cuttingStroke && edgeY >= FACE_START_MM && edgeY <= SHAPING_FACE_END_MM + SHAPER_OVERTRAVEL_MM
471:  if (inStock) {
472:    const raw = (MESH_AZ_RAD - SPACE_CLOCK_RAD - workPhi) / SPACE_PITCH_RAD
473:    const index = ((Math.round(raw) % SHAFT_SPACES) + SHAFT_SPACES) % SHAFT_SPACES
474:    out.engagedSpace = index
475:  } else {
476:    out.engagedSpace = -1
477:  }
478:
479:  // chip: only while stock is removed at the rake face; curls toward -X (surface motion at mesh)
480:  const chipActive = inStock && infeedRho < SHAFT_OD_MM - 1e-3 && mShaping > 0.02
481:  if (chipActive) {
482:    const u = phase * 2
483:    out.chipOpacity = 0.9 * Math.sin(Math.PI * u)
484:    out.chipX = -(CHIP_SEED * 0.4 + 0.55 * u)
485:    out.chipY = edgeY
486:    out.chipZ = infeedRho + 0.2 + 0.6 * u
487:    out.chipCurl = 0.8 + 2.4 * u
488:  } else {
489:    out.chipOpacity = 0
490:    out.chipX = 0
491:    out.chipY = edgeY
492:    out.chipZ = out.cutterRho
493:    out.chipCurl = 0
494:  }
495:
496:  // hob
497:  const hobYc = hobYcAt(t)
498:  const offA = hobRadialOffsetAt(t)
499:  const hobPhi = hobPhiAt(t)
500:  out.hobPhi = hobPhi
501:  out.hobWorkPhi = -hobPhi * (HOB_STARTS / SHAFT_SPACES)
502:  out.hobRevRate = hobRevRateAt(t)
503:  out.hobYc = hobYc
504:  out.hobA = HOB_VISUAL_A_MM + offA
505:  out.hobToolA = HOB_CENTRE_DISTANCE_AT_DEPTH_MM + offA
506:  out.hobR = HOB_VISUAL_R_MM
507:
508:  // display-rate guard
509:  const strokeHz = shaping ? rate / STROKE_PERIOD_M : 0
510:  const gashHz = shaping
511:    ? (SHAPER_TEETH * CUTTER_RATE / (2 * Math.PI)) * rate
512:    : hobbing
513:      ? HOB_FLUTES * out.hobRevRate
514:      : 0
515:  out.strokeHz = strokeHz
516:  out.gashHz = gashHz
517:  out.softened = strokeHz > SHAFT_MAX_FEATURE_HZ || gashHz > SHAFT_MAX_FEATURE_HZ
518:  return out
519:}
