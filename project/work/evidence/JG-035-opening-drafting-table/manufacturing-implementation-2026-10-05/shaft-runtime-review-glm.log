122:const lerp = (a: number, b: number, u: number) => a + (b - a) * u
123:
124:/** Closed-form camera sample. Writes only into out and returns it. */
125:export function sampleShaftCamera(
126:  time: number,
127:  aspect: number,
128:  kinematics: ShaftKinematicsFrame,
129:  out: ShaftCameraSample,
130:): ShaftCameraSample {
131:  const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time
132:  let i = 0
133:  while (i < ANCHORS.length - 2 && t >= ANCHORS[i + 1].t) i++
134:  const a = ANCHORS[i]
135:  const b = ANCHORS[i + 1]
136:  const u = ease((t - a.t) / (b.t - a.t))
137:  // Layout blend: 0 at 390x844-class aspects, 1 at desktop-class.
138:  const layout = clamp01((aspect - 0.62) / 0.4)
139:  const ta = a.tgtNarrow ?? a.tgt
140:  const tb = b.tgtNarrow ?? b.tgt
141:  const txMM = lerp(lerp(ta[0], a.tgt[0], layout), lerp(tb[0], b.tgt[0], layout), u)
142:  const tyMM = lerp(lerp(ta[1], a.tgt[1], layout), lerp(tb[1], b.tgt[1], layout), u)
143:  const tzMM = lerp(lerp(ta[2], a.tgt[2], layout), lerp(tb[2], b.tgt[2], layout), u)
144:
145:  // Gentle target follow of the hob centre during the feed phase.
146:  let hobFollow = 0
147:  if (t > 25.4 && t < 30.8) {
148:    const weight = ease((t - 25.4) / 0.5) * (1 - ease((t - 30.2) / 0.6))
149:    hobFollow = 0.35 * (hobYcAt(t) - 2.66495) * weight
150:  }
151:
152:  const az = (lerp(a.az, b.az, u) * DEG) + kinematics.followAzimuth
153:  const el = lerp(a.el, b.el, u) * DEG
154:  const dist = lerp(a.dist, b.dist, u)
155:  const fov = lerp(lerp(a.fovNarrow, a.fovDesktop, layout), lerp(b.fovNarrow, b.fovDesktop, layout), u)
156:
157:  const tx = txMM * MM
158:  const ty = (tyMM + hobFollow) * MM
159:  const tz = tzMM * MM
160:  const ce = Math.cos(el)
161:  out.px = tx + dist * ce * Math.cos(az)
162:  out.py = ty + dist * Math.sin(el)
163:  out.pz = tz + dist * ce * Math.sin(az)
164:  out.tx = tx
165:  out.ty = ty
166:  out.tz = tz
167:  const upY = t < UP_Y_START ? 1 : t >= UP_Y_END ? 0 : 1 - ease((t - UP_Y_START) / (UP_Y_END - UP_Y_START))
168:  const upAngle = upY * (Math.PI / 2)
169:  out.ux = 0
170:  out.uy = Math.sin(upAngle)
171:  out.uz = Math.cos(upAngle)
172:  out.fov = fov
173:  out.followAzimuth = kinematics.followAzimuth
174:  out.followWeight = kinematics.followWeight
175:  out.valid = true
176:  return out
177:}
