74:export function measureSupportDelta(doc: ShaftBundleDocument, out: Vector3): number {
75:  const box = new Box3(), legacy = new Vector3(), approved = new Vector3(), ring = new Vector3()
76:  exportedNodeBounds(doc, 'legacybearing', box).getCenter(legacy)
77:  exportedNodeBounds(doc, 'approvedbearing', box).getCenter(approved)
78:  out.subVectors(approved, legacy)
79:  exportedNodeBounds(doc, 'legacyring', box).getCenter(legacy)
80:  exportedNodeBounds(doc, 'approvedring', box).getCenter(approved)
81:  ring.subVectors(approved, legacy)
82:  const deltaYmm = -out.z * 1000
83:  if (Math.abs(deltaYmm - 2.75) > 0.005 || Math.abs(out.x) > 0.000005 || Math.abs(out.y) > 0.000005
84:    || ring.distanceTo(out) > 0.000005) throw new Error('Exported support pair does not translate rigidly +2.750 mm')
85:  return deltaYmm
86:}
