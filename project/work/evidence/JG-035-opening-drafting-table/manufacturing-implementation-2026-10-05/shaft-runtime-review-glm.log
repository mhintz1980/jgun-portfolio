68:export const HOB_CERTIFIED_R_MM = 5.87
69:export const HOB_CERTIFIED_LEAD_ANGLE_DEG = 5.5587
70:/**
71: * Visual floor: the authored untilted circle R = 6.0 with centre at root + 6.0.
72: * The certified tool is R 5.87 tilted to its lead angle; its equivalent meridian floor
73: * (clearance-v4 ramp fit, max deviation 0.0049 mm) is this untilted circle, so the final
74: * hobbing state equals the approved mesh.
75: */
76:export const HOB_VISUAL_R_MM = 6.0
77:export const HOB_VISUAL_A_MM = SHAFT_ROOT_MM + HOB_VISUAL_R_MM
78:export const HOB_FINAL_YC_MM = 9.5249
79:export const HOB_INFEED_YC_MM = -4.195
80:export const HOB_RETRACT_MM = 2.5
