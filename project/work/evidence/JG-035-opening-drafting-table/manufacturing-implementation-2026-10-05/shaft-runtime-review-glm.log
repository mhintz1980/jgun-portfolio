36:/** Read only GLB metadata; Draco is decoded by the normal loader, not by this helper. */
37:export function readShaftBundleDocument(data: ArrayBuffer): ShaftBundleDocument {
38:  const view = new DataView(data)
39:  if (view.byteLength < 20 || view.getUint32(0, true) !== 0x46546c67 || view.getUint32(4, true) !== 2
40:    || view.getUint32(16, true) !== 0x4e4f534a) throw new Error('Invalid shaft GLB')
41:  const length = view.getUint32(12, true)
42:  if (20 + length > data.byteLength) throw new Error('Truncated shaft GLB')
43:  return JSON.parse(new TextDecoder().decode(new Uint8Array(data, 20, length))) as ShaftBundleDocument
44:}
45:
46:/** Supports are identity nodes with baked vertex poses in today's exports. This also
47: * handles future TRS nodes: use the union of ALL POSITION accessor bounds in study space.
48: */
49:export function exportedNodeBounds(doc: ShaftBundleDocument, name: string, out: Box3): Box3 {
50:  const index = doc.nodes.findIndex(node => node.name === name)
51:  if (index < 0) throw new Error('Missing shaft node: ' + name)
52:  const world = new Matrix4(), local = new Matrix4(), p = new Vector3(), q = new Quaternion(), s = new Vector3()
53:  let cursor = index
54:  while (cursor >= 0) {
55:    const node = doc.nodes[cursor]
56:    if (node.matrix) local.fromArray(node.matrix)
57:    else local.compose(p.fromArray(node.translation ?? [0, 0, 0]), q.fromArray(node.rotation ?? [0, 0, 0, 1]), s.fromArray(node.scale ?? [1, 1, 1]))
58:    world.premultiply(local)
59:    cursor = doc.nodes.findIndex(parent => parent.children?.includes(cursor))
60:  }
61:  const node = doc.nodes[index]
62:  if (node.mesh === undefined) throw new Error('Shaft node has no exported mesh: ' + name)
63:  out.makeEmpty()
64:  const box = new Box3()
65:  for (const primitive of doc.meshes[node.mesh].primitives) {
66:    const accessor = doc.accessors[primitive.attributes.POSITION]
67:    if (!accessor.min || !accessor.max) throw new Error('Shaft accessor bounds missing: ' + name)
68:    box.min.fromArray(accessor.min); box.max.fromArray(accessor.max)
69:    out.union(box.applyMatrix4(world))
70:  }
71:  return out
72:}
