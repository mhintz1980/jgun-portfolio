1:/**
2: * JG-035 shaft tooling leaf: closed-form machining progression.
3: *
4: * Turns the finished CAD shaft meshes into blank / partial / finished states without CSG.
5: * Everything is a pure function of the state passed in: no accumulators, no clocks, no
6: * randomness, and no allocation in per-frame paths. The same law runs on the CPU
7: * (progressedRadius) and on the GPU (applyProgression -> onBeforeCompile), so seek order
8: * cannot diverge.
9: *
10: * Frame: shaft-local millimetres, +Y is the shaft axis (CAD). The runtime loader performs
11: * exactly one conversion (shaft-local +Y -> glTF -Z); the object-to-shaft matrix handed to
12: * applyProgression maps render-object space back to shaft-local mm, once.
13: */
14:import { Matrix3, Matrix4 } from 'three'
15:import type { IUniform, Material, MeshPhysicalMaterial, MeshStandardMaterial } from 'three'
16:
17:export type ProgressionMode = 'none' | 'shaping' | 'hobbing'
18:export type ProgressionShaft = 'legacy' | 'approved'
19:
20:export interface ProgressionState {
21:  mode: ProgressionMode
22:  /** Per tooth-space depth in [0, 1]; 0 = uncut blank stock, 1 = finished tooth space. */
23:  spaceDepth: Float32Array
24:  /** Tooth-space index currently engaged by the cutter, or -1. */
25:  engagedSpace: number
26:  /** Depth before the engaged stroke; omitted means a first pass from the uncut blank. */
27:  engagedPreviousDepth?: number
28:  /** Cutter leading-face y (mm) during the current stroke; material behind it carries the new depth. */
29:  edgeY: number
30:  /** Hob axial centre y (mm). */
31:  hobYc: number
32:  /** Hob centre distance (mm). */
33:  hobA: number
34:  /** Hob envelope radius (mm). */
35:  hobR: number
36:}
