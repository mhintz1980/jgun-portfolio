306:const FRAGMENT_COMMON = /* glsl */ `
307:uniform float uStressKind;
308:uniform float uStressMix;
309:uniform float uStressScanProgress;
310:uniform float uStressYMin;
311:uniform float uStressYMax;
312:uniform float uStressRMax;
313:varying vec3 vShaftLocal;
314:`
