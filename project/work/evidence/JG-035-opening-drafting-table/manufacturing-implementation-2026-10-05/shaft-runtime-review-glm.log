290:/**
291: * Frame-follow azimuth psi(t) = FOLLOW_GAIN * mf(t), mf = integral of followWeight * rate.
292: * Follow weight: 1 on [2,6] (quarter orbit: psi spans -pi/2 in magnitude terms below),
293: * eased to 0 by 7.2 (before the cutter edge reaches the face end), re-engaged 11..12 for
294: * the recap, frozen after 15 s because the rate is zero there.
295: */
296:export const FOLLOW_GAIN = Math.PI / 8
297:
298:export function followWeightAt(t: number): number {
299:  if (t < T_SHAPING_START) return 0
300:  if (t < T_EASE_DOWN) return 1
301:  if (t < T_SLOW_START) return 1 - ease((t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN))
302:  if (t < T_EASE_UP_END) return 0
303:  if (t < 12) return ease((t - T_EASE_UP_END) / 1)
304:  if (t < T_SHAPING_END) return 1
305:  return 0
306:}
307:
308:const ease2Integral = (u: number) => (9 / 5) * u ** 5 - 2 * u ** 6 + (4 / 7) * u ** 7
309:const MF_AT_SLOW_START = 4 + 1.2 * (1 - 1.78 * 0.5 + 0.78 * (9 / 5 - 2 + 4 / 7))
310:const MF_AT_RECAP_START = MF_AT_SLOW_START
311:const MF_AT_12 = MF_AT_SLOW_START + 4 * 0.5
312:const MF_AT_RECAP_END = MF_AT_12 + 8
313:export const FOLLOW_MF_TOTAL = MF_AT_RECAP_END + 4 * 0.5
314:
315:export function followMfAt(t: number): number {
316:  if (t < T_SHAPING_START) return 0
317:  if (t < T_EASE_DOWN) return t - T_SHAPING_START
318:  if (t < T_SLOW_START) {
319:    const u = (t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN)
320:    // integral of (1 - S(u)) * (1 - 0.78 S(u)) over the shared ease window
321:    return 4 + 1.2 * (u - 1.78 * easeIntegral(u) + 0.78 * ease2Integral(u))
322:  }
323:  if (t < T_EASE_UP_END) return MF_AT_SLOW_START
324:  if (t < 12) return MF_AT_RECAP_START + 4 * easeIntegral(t - T_EASE_UP_END)
325:  if (t < T_RECAP_END) return MF_AT_12 + 4 * (t - 12)
326:  if (t < T_SHAPING_END) return MF_AT_RECAP_END + 4 * ((t - T_RECAP_END) - easeIntegral(t - T_RECAP_END))
327:  return FOLLOW_MF_TOTAL
328:}
