82:export function createProgressionState(): ProgressionState {
83:  return {
84:    mode: 'none',
85:    spaceDepth: new Float32Array(SHAFT_SPACES),
86:    engagedSpace: -1,
87:    edgeY: 0,
88:    hobYc: HOB_INFEED_YC_MM,
89:    hobA: HOB_VISUAL_A_MM,
90:    hobR: HOB_VISUAL_R_MM,
91:  }
92:}
93:
94:/** Nearest tooth-space index for a shaft-local azimuth (rad). Allocation-free. */
95:export function spaceIndexAt(azimuth: number): number {
96:  const raw = Math.round((azimuth - SPACE_CLOCK_RAD) / SPACE_PITCH_RAD) % SHAFT_SPACES
97:  const index = raw < 0 ? raw + SHAFT_SPACES : raw
98:  return index === 0 ? 0 : index
99:}
100:
101:/** Hobbing meridian floor radius (mm). Allocation-free. */
102:export function hobFloorRadius(y: number, hobYc: number, hobA: number, hobR: number): number {
103:  if (y <= hobYc) return SHAFT_ROOT_MM
104:  if (y < hobYc + hobR) {
105:    const dy = y - hobYc
106:    const r2 = hobR * hobR - dy * dy
107:    return hobA - Math.sqrt(r2 > 0 ? r2 : 0)
108:  }
109:  return SHAFT_OD_MM
110:}
111:
112:/**
113: * CPU mirror of the vertex-shader law. Returns the progressed radius (mm) for a shaft-local
114: * sample. Pure: depends only on its arguments and never writes to state.
115: *
116: * legacy shaping: only FACE_START <= y <= 9.875 with r < OD; r' = min(OD, r + (1 - depth_i)*(OD - ROOT)).
117: * approved hobbing: only FACE_START <= y <= 13.78; r' = max(r, min(OD, floor(y))).
118: */
119:export function progressedRadius(
120:  r: number,
121:  y: number,
122:  azimuth: number,
123:  state: ProgressionState,
124:  shaft: ProgressionShaft,
125:): number {
126:  if (state.mode === 'none') return r
127:  if (state.mode === 'shaping') {
128:    if (shaft !== 'legacy') return r
129:    if (y < FACE_START_MM || y > SHAPING_FACE_END_MM || r >= SHAFT_OD_MM) return r
130:    const space = spaceIndexAt(azimuth)
131:    let depth = state.spaceDepth[space]
132:    // The engaged space carries the new depth only behind the cutter's leading face.
133:    if (space === state.engagedSpace && y > state.edgeY) depth = state.engagedPreviousDepth ?? 0
134:    const value = r + (1 - depth) * (SHAFT_OD_MM - SHAFT_ROOT_MM)
135:    return value > SHAFT_OD_MM ? SHAFT_OD_MM : value
136:  }
137:  if (shaft !== 'approved') return r
138:  if (y < FACE_START_MM || y > HOBBING_FACE_END_MM) return r
139:  const floor = hobFloorRadius(y, state.hobYc, state.hobA, state.hobR)
140:  const clamped = floor > SHAFT_OD_MM ? SHAFT_OD_MM : floor
141:  return r > clamped ? r : clamped
142:}
