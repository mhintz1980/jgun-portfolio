+})
+
+describe('K5 camera framing at the key beats', () => {
+  for (const layout of [DESKTOP_ASPECT, NARROW_ASPECT] as const) {
+    it(`keeps the shaft axis and cutter exit region inside the 8% safe frame (aspect ${layout.toFixed(3)})`, () => {
