+        const file = `raw-${config.name}-${target.label}.png`
+        await page.evaluate(() => {
+          const canvas = document.querySelector('canvas[data-engine]')
+          if (!canvas) throw new Error('Live canvas missing')
+          window.__staticShaftCapture = []
