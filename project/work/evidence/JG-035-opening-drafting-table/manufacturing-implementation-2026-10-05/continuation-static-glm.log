+console.log(JSON.stringify({ url, cases: report.cases.map(result => ({ name: result.name, pass: result.pass, shots: result.shots.map(shot => shot.label), supportPair: result.supportPair, requests: result.requests.length, failures: result.failures ?? [] })), failures: report.failures }, null, 2))
