+const url = process.argv.find(arg => arg.startsWith('--url='))?.slice(6) || 'http://localhost:5199'
+await fs.mkdir(rawDir, { recursive: true })
+
+const nearly = (a, b, eps = 1e-9) => Math.abs(a - b) < eps
