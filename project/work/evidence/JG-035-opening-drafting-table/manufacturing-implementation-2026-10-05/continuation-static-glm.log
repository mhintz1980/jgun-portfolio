+          await slider.fill(String(target.t))
+          await page.waitForFunction(t => { const p = window.__inspection; return p?.active && p.status === 'ready' && p.playing === false && Math.abs(p.sampledTime - t) < 1e-8 && Math.abs(p.cameraSampleTime - t) < 1e-8 }, target.t, { timeout: 20000 })
