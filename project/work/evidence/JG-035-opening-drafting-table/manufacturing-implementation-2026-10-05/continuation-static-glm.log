+            window.__staticShaftCapture.push([element, element.style.visibility])
+            element.style.visibility = 'hidden'
+          }
+        })
+        let bytes
+        try { bytes = await page.locator('canvas[data-engine]').screenshot({ path: path.join(rawDir, file) }) }
+        finally { await page.evaluate(() => { for (const [element, visibility] of window.__staticShaftCapture) element.style.visibility = visibility; window.__staticShaftCapture = [] }) }
+        result.shots.push({
+          label: target.label, why: target.why, t: target.t, file,
+          sha256: createHash('sha256').update(bytes).digest('hex'),
+          probe: {
+            status: probe.status, phase: probe.phase, time: probe.time, sampledTime: probe.sampledTime, cameraSampleTime: probe.cameraSampleTime,
+            shaft: probe.shaft,
+          },
+          camera,
+        })
+      }
+      const before = result.shots.find(shot => shot.label === 'support-before')
+      const after = result.shots.find(shot => shot.label === 'support-after')
+      const matrixDelta = Math.max(...before.camera.matrixWorld.map((value, index) => Math.abs(value - after.camera.matrixWorld[index])))
+      const projectionDelta = Math.max(...before.camera.projection.map((value, index) => Math.abs(value - after.camera.projection[index])))
+      result.supportPair = { matrixWorldMaxDelta: matrixDelta, projectionMaxDelta: projectionDelta, sameCamera: matrixDelta < 1e-9 && projectionDelta < 1e-9 }
+      if (!result.supportPair.sameCamera) throw new Error(`Support before/after cameras differ: ${JSON.stringify(result.supportPair)}`)
