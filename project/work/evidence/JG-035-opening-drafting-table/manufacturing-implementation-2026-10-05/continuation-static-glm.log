+    'Camera anchors (src/scene/inspection/shaft/camera.ts) are identical for t=35.8..38.2 desktop and narrow; the support pair is compared under one camera in one session.',
+    'The runtime probe exposes witnesses/endpointHeld booleans, not the schedule blend; blend values above are quoted from src/scene/inspection/shaft/schedule.ts.',
+    'DOM overlays hidden via visibility only; canvas ancestry preserved. No camera/CAD/runtime source was modified.',
+  ],
+}
+
+const browser = await chromium.launch({ channel: 'chrome', headless: true, args: ['--use-angle=swiftshader', '--enable-unsafe-swiftshader'] })
+try {
+  for (const config of [
+    { name: 'desktop', width: 1440, height: 900 },
+    { name: 'narrow', width: 390, height: 844, isMobile: true, hasTouch: true },
+  ]) {
+    const result = { name: config.name, shots: [], requests: [], errors: [] }
+    report.cases.push(result)
