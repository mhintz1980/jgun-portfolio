   38: export function narrativeModelToStudy(out: Matrix4): Matrix4 {
   39:   out.set(
   40:     0.9868485331535339, 0.16164754331111908, 2.7993343057879116e-16, -0.07780782878398895,
   41:     -0.16164754331111908, 0.9868485331535339, -4.663211247979686e-16, 0.0000010723084642449976,
   42:     -3.516315667205359e-16, 4.149377504071382e-16, 1, 0.023340754210948944,
   43:     0, 0, 0, 1,
   44:   ).invert()
   45:   // Right-multiply T(-hero_rest_center) without allocating a matrix.
   46:   const e = out.elements, x = -0.07780783086387061, y = 0.000001072308505746522, z = 0.09254183464277439
   47:   e[12] += e[0] * x + e[4] * y + e[8] * z
   48:   e[13] += e[1] * x + e[5] * y + e[9] * z
   49:   e[14] += e[2] * x + e[6] * y + e[10] * z
   50:   return out
