  417: 
  418: /** Write the frame's progression-compatible fields into a caller-owned ProgressionState. */
  419: export function writeShaftProgression(frame: ShaftKinematicsFrame, state: ProgressionState): ProgressionState {
  420:   state.mode = frame.mode
  421:   state.engagedSpace = frame.engagedSpace
  422:   // The engaged space is selected by the nearest crossing, which can still be
  423:   // ahead of machining time. Count only cuts before that crossing, not before t.
  424:   if (frame.engagedSpace >= 0) {
  425:     const first = CROSSING_M[frame.engagedSpace]
  426:     const previous = first + (Math.round((frame.machining - first) / WORK_REV_M) - 0.5) * WORK_REV_M
  427:     state.engagedPreviousDepth = Math.min(1, countedPasses(previous, frame.engagedSpace) / SPACE_PASSES_REQUIRED)
  428:   } else state.engagedPreviousDepth = 0
  429:   state.edgeY = frame.edgeY
  430:   // Tool withdrawal must not restore machined stock. Hold the swept envelope
  431:   // once the certified feed reaches its stop; tool pose stays in the frame.
  432:   state.hobYc = frame.time >= T_HOB_FEED_END ? HOB_STOP_YC_MM : frame.hobYc
  433:   state.hobA = frame.time >= T_HOB_FEED_END ? HOB_VISUAL_A_MM : frame.hobA
  434:   state.hobR = frame.hobR
  435:   const depth = state.spaceDepth
  436:   for (let i = 0; i < SHAFT_SPACES; i++) depth[i] = frame.spaceDepth[i]
  437:   return state
  438: }
  439: 
  440: /** Closed-form sample of the full machining state. Writes only into out and returns it. */
  441: export function sampleShaftKinematics(time: number, out: ShaftKinematicsFrame): ShaftKinematicsFrame {
  442:   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time
  443:   const m = machiningTimeAt(t)
  444:   const rate = machiningRateAt(t)
  445:   const shaping = t >= T_SHAPING_START && t < T_SHAPING_END
  446:   const hobbing = t >= 25 && t < T_HOB_END
  447: 
  448:   out.time = t
  449:   out.machining = m
  450:   out.machiningRate = rate
  451:   out.mode = shaping ? 'shaping' : hobbing ? 'hobbing' : 'none'
  452:   out.followAzimuth = FOLLOW_GAIN * followMfAt(t)
  453:   out.followWeight = followWeightAt(t)
  454: 
  455:   // shaper
  456:   const mShaping = shaping || t < T_SHAPING_START ? m : t >= T_SHAPING_END ? MACHINING_AT_SHAPING_END : m
  457:   const cutterPhi = CUTTER_RATE * mShaping
  458:   const workPhi = SHAPER_SIGNED_RATIO * cutterPhi
  459:   const phase = strokePhaseAt(mShaping)
  460:   const cuttingStroke = phase < 0.5
  461:   const yc = strokeCentreYAt(mShaping)
  462:   const edgeY = yc + SHAPER_THICKNESS_MM * 0.5
  463:   const backoff = backoffAt(mShaping)
  464:   const infeedRho = infeedRhoAt(mShaping)
  465:   out.cutterPhi = cutterPhi
  466:   out.workPhi = workPhi
  467:   out.strokeCentreY = yc
  468:   out.edgeY = edgeY
  469:   out.strokePhase = phase
  470:   out.cutting = cuttingStroke
  471:   out.returning = !cuttingStroke
  472:   out.backoff = backoff
  473:   out.cutterRho = infeedRho + backoff
  474: 
  475:   for (let i = 0; i < SHAFT_SPACES; i++) {
  476:     const depth = countedPasses(mShaping, i) / SPACE_PASSES_REQUIRED
  477:     out.spaceDepth[i] = depth > 1 ? 1 : depth
  478:   }
  479:   const inStock = shaping && cuttingStroke && edgeY >= FACE_START_MM && edgeY <= SHAPING_FACE_END_MM + SHAPER_OVERTRAVEL_MM
  480:   if (inStock) {
  481:     const raw = (MESH_AZ_RAD - SPACE_CLOCK_RAD - workPhi) / SPACE_PITCH_RAD
  482:     const index = ((Math.round(raw) % SHAFT_SPACES) + SHAFT_SPACES) % SHAFT_SPACES
  483:     out.engagedSpace = index
  484:   } else {
  485:     out.engagedSpace = -1
  486:   }
  487: 
  488:   // chip: only while stock is removed at the rake face; curls toward -X (surface motion at mesh)
  489:   const chipActive = inStock && infeedRho < SHAFT_OD_MM - 1e-3 && mShaping > 0.02
  490:   if (chipActive) {
  491:     const u = phase * 2
  492:     out.chipOpacity = 0.9 * Math.sin(Math.PI * u)
  493:     out.chipX = -(CHIP_SEED * 0.4 + 0.55 * u)
  494:     out.chipY = edgeY
  495:     out.chipZ = infeedRho + 0.2 + 0.6 * u
  496:     out.chipCurl = 0.8 + 2.4 * u
  497:   } else {
  498:     out.chipOpacity = 0
  499:     out.chipX = 0
  500:     out.chipY = edgeY
  501:     out.chipZ = out.cutterRho
  502:     out.chipCurl = 0
  503:   }
  504: 
  505:   // hob
  506:   const hobYc = hobYcAt(t)
  507:   const offA = hobRadialOffsetAt(t)
  508:   const hobPhi = hobPhiAt(t)
  509:   out.hobPhi = hobPhi
  510:   out.hobWorkPhi = -hobPhi * (HOB_STARTS / SHAFT_SPACES)
  511:   out.hobRevRate = hobRevRateAt(t)
  512:   out.hobYc = hobYc
  513:   out.hobA = HOB_VISUAL_A_MM + offA
  514:   out.hobToolA = HOB_CENTRE_DISTANCE_AT_DEPTH_MM + offA
  515:   out.hobR = HOB_VISUAL_R_MM
  516: 
  517:   // display-rate guard
  518:   const strokeHz = shaping ? rate / STROKE_PERIOD_M : 0
  519:   const gashHz = shaping
  520:     ? (SHAPER_TEETH * CUTTER_RATE / (2 * Math.PI)) * rate
  521:     : hobbing
  522:       ? HOB_FLUTES * out.hobRevRate
  523:       : 0
  524:   out.strokeHz = strokeHz
  525:   out.gashHz = gashHz
  526:   out.softened = strokeHz > SHAFT_MAX_FEATURE_HZ || gashHz > SHAFT_MAX_FEATURE_HZ
  527:   return out
  528: }
