  530: /** Hob envelope top y (mm) at full length along its tilted axis; used for clearance checks. */
  531: export function hobEnvelopeTopY(hobYc: number): number {
  532:   const gamma = (HOB_LEAD_ANGLE_DEG * Math.PI) / 180
  533:   return hobYc + (HOB_LENGTH_MM / 2) * Math.cos(gamma) + HOB_RADIUS_MM * Math.sin(gamma)
  534: }

