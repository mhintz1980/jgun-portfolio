src/scene/inspection/shaft/camera.ts
1: /**
2:  * JG-035 shaft inspection camera (leaf spec: shaft-kinematics-camera-spec, 2026-10-05).
3:  *
4:  * Authored camera curves sampled from the master playhead plus the kinematics frame-follow
5:  * azimuth. Output is position/target/up/fov in shaft-local METRES (CAD datum: +Y shaft axis;
6:  * the runtime loader performs exactly one conversion to glTF -Z, never two).
7:  *
8:  * Composition law: camera machine azimuth = anchorAzimuth(t) + followAzimuth(t). During
9:  * shaping the follow rotates the camera a quarter turn (2..6 s), eases its rate to zero
10:  * before the cutter edge reaches the face end (by 7.2 s), and the fixed machine-frame macro
11:  * holds through the slow exit. The recap re-engages the same law (comparatively slow
12:  * apparent orbit). After 15 s the follow is frozen, so anchors are authored as machine
13:  * azimuths minus FOLLOW_AZIMUTH_MOD (the frozen follow, wrapped once).
14:  *
15:  * Up vector: +Y (shaft vertical) through the machining era - matching the blockout exit
16:  * macro whose critical ROI is taller than wide - then eases to +Z (shaft horizontal, side
17:  * view) for the material attempts and every later beat. Both stay non-parallel to the view
18:  * direction everywhere on the timeline.
19:  *
20:  * Anchors start from camera/blockout.json (desktop and 390x844) and are re-centred on the
21:  * certified tool positions (cutter-exit macro target balances face end 9.875, groove floor
22:  * 3.97 at y 10.41, groove wall 10.94 and the backed-off cutter edge). All curves are
23:  * closed-form smoothstep blends; no damping, no state.
24:  */
25: import { FOLLOW_MF_TOTAL, SHAFT_KINEMATICS_DURATION, FOLLOW_GAIN, followMfAt, hobYcAt } from './kinematics'
26: import type { ShaftKinematicsFrame } from './kinematics'
27: 
28: const DEG = Math.PI / 180
29: const MM = 1e-3
30: const clamp01 = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x)
31: const ease = (x: number) => { const t = clamp01(x); return t * t * (3 - 2 * t) }
32: 
33: /** Frozen follow azimuth wrapped once, so post-15 s anchors can be authored as machine azimuths. */
34: export const FOLLOW_AZIMUTH_MOD = (FOLLOW_GAIN * FOLLOW_MF_TOTAL) % (2 * Math.PI)
35: 
36: interface CameraAnchor {
37:   readonly t: number
38:   /** Machine azimuth (deg) while the follow is live (t <= 15), otherwise already compensated. */
39:   readonly az: number
40:   readonly el: number
41:   readonly dist: number
42:   readonly fovDesktop: number
43:   readonly fovNarrow: number
44:   readonly tgt: readonly [number, number, number]
45:   /** Narrow-layout target override (mm); falls back to tgt. */
46:   readonly tgtNarrow?: readonly [number, number, number]
47: }
48: 
49: /**
50:  * Anchored camera states. az for t >= 15 is machineAzimuth - FOLLOW_AZIMUTH_MOD in degrees.
51:  * Targets are shaft-local mm. Blockout starting values: overview/cutter-exit/hobbing/
52:  * runout-withdrawn/support (camera/blockout.json renders), re-centred as documented above.
53:  */
54: const ANCHORS: readonly CameraAnchor[] = [
55:   { t: 0,    az: 24,                          el: 6.3, dist: 0.24,   fovDesktop: 17,   fovNarrow: 27,   tgt: [0, 9, 0] },
56:   { t: 2,    az: 24,                          el: 6.2, dist: 0.205,  fovDesktop: 16.5, fovNarrow: 24,   tgt: [0, 7.5, 2] },
57:   { t: 6,    az: 24,                          el: 4.6, dist: 0.17,   fovDesktop: 12.5, fovNarrow: 19,   tgt: [0, 6.8, 3] },
58:   { t: 7.2,  az: 24,                          el: 3.2, dist: 0.2,    fovDesktop: 5.4,  fovNarrow: 9.5,  tgt: [0, 9.8, 4.6] },
59:   { t: 9.7,  az: 24,                          el: 3.2, dist: 0.2035, fovDesktop: 5.5,  fovNarrow: 9.6,  tgt: [0, 9.85, 4.65] },
60:   { t: 11,   az: 24,                          el: 4.2, dist: 0.225,  fovDesktop: 9.5,  fovNarrow: 15.5, tgt: [0, 7.2, 3] },
61:   // Recap pull-back completes at 14 s; 14..15 s is the C1 handoff into the settled materials
