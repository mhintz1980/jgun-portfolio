330: // ---- sampler -----------------------------------------------------------------------------
331: 
332: export type ShaftKinematicsMode = 'none' | 'shaping' | 'hobbing'
333: 
334: export interface ShaftKinematicsFrame {
335:   /** Clamped master playhead (s). */
336:   time: number
337:   /** Machining time m(t) and rate dm/dt. */
338:   machining: number
339:   machiningRate: number
340:   mode: ShaftKinematicsMode
341:   /** Rotating-frame follow azimuth (rad) and weight; lighting follows the same weight. */
342:   followAzimuth: number
343:   followWeight: number
344:   // shaper (machine frame, shaft-local mm)
345:   cutterPhi: number
346:   workPhi: number
347:   strokeCentreY: number
348:   /** Cutter leading-face y (mm); progression.ts reveal edge. */
349:   edgeY: number
350:   strokePhase: number
351:   cutting: boolean
352:   returning: boolean
353:   backoff: number
354:   /** Cutter near-edge radius (mm), including infeed and backoff. */
355:   cutterRho: number
356:   engagedSpace: number
357:   /** Caller-owned per-space depth in [0,1]; 1 only behind counted cutting engagement. */
358:   spaceDepth: Float32Array
359:   // chip (one restrained chip at the rake face; none during return)
360:   chipOpacity: number
361:   chipX: number
362:   chipY: number
363:   chipZ: number
364:   chipCurl: number
365:   // hob (machine frame, shaft-local mm)
366:   hobPhi: number
367:   hobWorkPhi: number
368:   hobRevRate: number
369:   hobYc: number
370:   /** Visual floor centre distance for progression.ts (equivalent meridian circle). */
371:   hobA: number
372:   /** Certified tool centre distance (10.1618 mm at full depth) plus radial offset. */
373:   hobToolA: number
374:   hobR: number
375:   // display-rate guard (30 fps lite floor)
376:   strokeHz: number
377:   gashHz: number
378:   softened: boolean
379: }
380: 
381: export function createShaftKinematicsFrame(): ShaftKinematicsFrame {
382:   return {
383:     time: 0,
384:     machining: 0,
385:     machiningRate: 0,
386:     mode: 'none',
387:     followAzimuth: 0,
388:     followWeight: 0,
389:     cutterPhi: 0,
390:     workPhi: 0,
391:     strokeCentreY: 0,
392:     edgeY: 0,
393:     strokePhase: 0,
394:     cutting: false,
395:     returning: false,
396:     backoff: 0,
397:     cutterRho: SHAFT_OD_MM,
398:     engagedSpace: -1,
399:     spaceDepth: new Float32Array(SHAFT_SPACES),
400:     chipOpacity: 0,
401:     chipX: 0,
402:     chipY: 0,
403:     chipZ: 0,
404:     chipCurl: 0,
405:     hobPhi: 0,
