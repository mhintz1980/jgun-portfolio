311:     for (let i = 0; i < 600; i++) times.push(((i * 7919) % 10320) / 240)
312:     for (const t of times) sampleShaftKinematics(t, a)
313:     for (let i = times.length - 1; i >= 0; i--) sampleShaftKinematics(times[i], b)
314:     for (const t of times) {
315:       const fa = sampleShaftKinematics(t, a)
316:       const fb = sampleShaftKinematics(t, b)
317:       expect(fa).toBe(a)
318:       expect(fb).toBe(b)
319:       for (const key of Object.keys(fa) as (keyof typeof fa)[]) {
320:         if (key === 'spaceDepth' || key === 'mode' || key === 'cutting' || key === 'returning' || key === 'softened') continue
321:         expect(fa[key]).toBe(fb[key])
322:       }
323:       for (let i = 0; i < SHAFT_SPACES; i++) expect(fa.spaceDepth[i]).toBe(fb.spaceDepth[i])
324:     }
325:   })
