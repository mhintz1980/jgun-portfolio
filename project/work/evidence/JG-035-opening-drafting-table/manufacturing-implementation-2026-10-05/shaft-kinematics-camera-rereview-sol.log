55: // ---- master playhead -> machining time map -----------------------------------------------
56: 
57: export const SHAFT_KINEMATICS_DURATION = 43
58: /** 30 fps lite floor; repeated features above a quarter of it must be softened. */
59: export const SHAFT_LITE_FPS = 30
60: export const SHAFT_MAX_FEATURE_HZ = SHAFT_LITE_FPS / 4
61: 
62: const T_SHAPING_START = 2
63: /** End of the eased startup ramp; the full normal rate resumes here (C1 at 2.0 s and 3.0 s). */
64: const T_STARTUP_EASE_END = 3
65: const T_EASE_DOWN = 6
66: const T_SLOW_START = 7.2
67: const T_SLOW_END = 9.6
68: const T_EASE_UP_END = 11
69: const T_RECAP_END = 14
70: const T_SHAPING_END = 15
71: const T_HOB_RATE_IN = 24.6
72: const T_HOB_RATE_FULL = 25.6
73: const T_HOB_RATE_DOWN = 31.4
74: const T_HOB_END = 32
75: const RATE_NORMAL = 1
76: const RATE_SLOW = 0.22
77: const RATE_RECAP = 4
78: 
79: const clamp01 = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x)
80: const ease = (x: number) => { const t = clamp01(x); return t * t * (3 - 2 * t) }
81: /** Integral of ease over [0, u]. */
82: const easeIntegral = (u: number) => { const t = clamp01(u); return t * t * t - t * t * t * t / 2 }
83: const mod1 = (x: number) => x - Math.floor(x)
84: 
85: interface RateSegment { readonly t0: number; readonly t1: number; readonly r0: number; readonly r1: number; readonly m0: number }
86: 
87: /**
88:  * Rate segments dm/dt: frozen before 2 s, eased onset 2..3 s (C1 out of the frozen pre-roll
89:  * and into the normal rate; the review's 2.0 s 0 -> 1 step is gone), normal 3..6 s, eased
90:  * slow window, compressed recap easing to 0 at 15 s, frozen until the hob window.
91:  */
92: const RATE_SPEC: ReadonlyArray<readonly [number, number, number, number]> = [
93:   [0, T_SHAPING_START, 0, 0],
94:   [T_SHAPING_START, T_STARTUP_EASE_END, 0, RATE_NORMAL],
95:   [T_STARTUP_EASE_END, T_EASE_DOWN, RATE_NORMAL, RATE_NORMAL],
96:   [T_EASE_DOWN, T_SLOW_START, RATE_NORMAL, RATE_SLOW],
97:   [T_SLOW_START, T_SLOW_END, RATE_SLOW, RATE_SLOW],
98:   [T_SLOW_END, T_EASE_UP_END, RATE_SLOW, RATE_RECAP],
99:   [T_EASE_UP_END, T_RECAP_END, RATE_RECAP, RATE_RECAP],
100:   [T_RECAP_END, T_SHAPING_END, RATE_RECAP, 0],
101:   [T_SHAPING_END, T_HOB_RATE_IN, 0, 0],
102:   [T_HOB_RATE_IN, T_HOB_RATE_FULL, 0, 1],
103:   [T_HOB_RATE_FULL, T_HOB_RATE_DOWN, 1, 1],
104:   [T_HOB_RATE_DOWN, T_HOB_END, 1, 0],
105:   [T_HOB_END, SHAFT_KINEMATICS_DURATION, 0, 0],
106: ]
107: 
108: const RATE_SEGMENTS: readonly RateSegment[] = (() => {
109:   const segments: RateSegment[] = []
110:   let m = 0
111:   for (const [t0, t1, r0, r1] of RATE_SPEC) {
112:     segments.push({ t0, t1, r0, r1, m0: m })
113:     m += (t1 - t0) * (r0 + r1) * 0.5
114:   }
115:   return segments
116: })()
117: 
118: /** Interior rate-segment boundary times (s); m(t) is tested for C1 across each of these. */
119: export const MACHINING_RATE_BOUNDARIES: readonly number[] = RATE_SPEC.slice(1, -1).map((segment) => segment[0])
120: 
121: function rateSegmentAt(t: number): RateSegment {
122:   for (let i = RATE_SEGMENTS.length - 1; i >= 0; i--) {
123:     const segment = RATE_SEGMENTS[i]
124:     if (t >= segment.t0) return segment
125:   }
126:   return RATE_SEGMENTS[0]
127: }
128: 
129: /** Machining time m(t): continuous, monotonic, C1 (rate is C0, piecewise smooth). */
130: export function machiningTimeAt(time: number): number {
131:   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time
132:   const s = rateSegmentAt(t)
133:   const u = (t - s.t0) / (s.t1 - s.t0)
134:   return s.m0 + (t - s.t0) * s.r0 + (s.r1 - s.r0) * (s.t1 - s.t0) * easeIntegral(u)
135: }
136: 
137: /** dm/dt at the master playhead. */
138: export function machiningRateAt(time: number): number {
139:   const t = time < 0 ? 0 : time > SHAFT_KINEMATICS_DURATION ? SHAFT_KINEMATICS_DURATION : time
140:   const s = rateSegmentAt(t)
141:   if (s.r0 === s.r1) return s.r0
142:   return s.r0 + (s.r1 - s.r0) * ease((t - s.t0) / (s.t1 - s.t0))
143: }
144: 
145: /** Midpoint of the stable slow window; the exit stroke peaks here (t = 8.4 s). */
146: export const T_SLOW_MID = (T_SLOW_START + T_SLOW_END) / 2
147: export const MACHINING_AT_SLOW_MID = machiningTimeAt(T_SLOW_MID)
148: export const MACHINING_AT_SHAPING_END = machiningTimeAt(T_SHAPING_END)
149: 
150: // ---- shaper ------------------------------------------------------------------------------
151: 
152: /** Work revolution period in machining seconds (ratio -2 with the cutter below). */
153: export const WORK_REV_M = 2
154: export const CUTTER_RATE = Math.PI / 2
155: export const WORK_RATE = SHAPER_SIGNED_RATIO * CUTTER_RATE
156: /** Mesh (pitch) point azimuth in the machine frame: cutter centre sits on +Z. */
157: export const MESH_AZ_RAD = Math.PI / 2
158: /** Stroke period in machining seconds; 2.5 strokes per work revolution. */
159: export const STROKE_PERIOD_M = 0.8
160: /**
161:  * Stroke phase offset, chosen so phase 0.5 (peak, yc = stroke max) lands exactly at
162:  * MACHINING_AT_SLOW_MID: the readable cutter exit sits at the centre of the slow window.
163:  */
164: export const STROKE_PHASE_OFFSET = mod1(0.5 - MACHINING_AT_SLOW_MID / STROKE_PERIOD_M)
165: /** Cutter orbit period; radial infeed completes within the first quarter orbit. */
166: export const CUTTER_ORBIT_M = (2 * Math.PI) / CUTTER_RATE
167: export const INFEED_END_M = CUTTER_ORBIT_M / 4
168: /** Cutter tip runs at work root + 5 um stock (clearance-v4 shaper fit). */
169: export const ROOT_TIP_STOCK_MM = 0.005
170: export const CUTTER_TIP_RHO_MM = SHAFT_ROOT_MM + ROOT_TIP_STOCK_MM
171: /**
172:  * Counted cutting engagements each tooth space needs to reach depth 1. Crossings that land
173:  * in the cutting half alternate with return-half crossings (WORK_REV_M / STROKE_PERIOD_M
174:  * = 2.5), so counted passes sit 2 * WORK_REV_M apart in machining time; four passes put
175:  * every space's completion inside the 11..15 s recap.
176:  */
177: export const SPACE_PASSES_REQUIRED = 4
178: /** Deterministic chip seed (golden-ratio conjugate); fixes the baked chip offsets. */
179: export const CHIP_SEED = 0.6180339887498949
180: 
181: export function strokePhaseAt(m: number): number {
182:   return mod1(m / STROKE_PERIOD_M + STROKE_PHASE_OFFSET)
183: }
184: 
185: export function strokeCentreYAt(m: number): number {
186:   const phase = strokePhaseAt(m)
187:   const bump = 0.5 * (1 - Math.cos(2 * Math.PI * phase))
188:   return SHAPER_STROKE_CENTRE_Y_MIN_MM + (SHAPER_STROKE_CENTRE_Y_MAX_MM - SHAPER_STROKE_CENTRE_Y_MIN_MM) * bump
189: }
190: 
191: /** Relieved-return radial backoff (mm): eased in/out around a full 2.0 mm plateau. */
192: export function backoffAt(m: number): number {
193:   const phase = strokePhaseAt(m)
194:   if (phase < 0.5) return 0
195:   const u = (phase - 0.5) * 2
196:   const bump = u < 0.2 ? ease(u / 0.2) : u <= 0.84 ? 1 : 1 - ease((u - 0.84) / 0.16)
197:   return SHAPER_BACKOFF_MM * bump
198: }
199: 
200: /** Radial infeed position of the cutter near edge (mm): OD -> root + 5 um in the first quarter orbit. */
201: export function infeedRhoAt(m: number): number {
202:   if (m <= 0) return SHAFT_OD_MM
203:   if (m >= INFEED_END_M) return CUTTER_TIP_RHO_MM
204:   return SHAFT_OD_MM + (CUTTER_TIP_RHO_MM - SHAFT_OD_MM) * ease(m / INFEED_END_M)
205: }
206: 
207: /**
208:  * Tooth-space crossing schedule. Space i centre crosses the mesh azimuth when
209:  * SPACE_CLOCK + i*pitch + WORK_RATE*m === MESH_AZ (mod 2*pi); crossings recur every
210:  * WORK_REV_M. Because WORK_REV_M / STROKE_PERIOD_M = 2.5, the stroke phase at a space's
211:  * crossings advances by exactly +0.5 per revolution, so crossings alternate cutting/return.
212:  */
213: const CROSSING_M: number[] = []
214: const CROSSING_FIRST_CUTS: boolean[] = []
215: for (let i = 0; i < SHAFT_SPACES; i++) {
216:   const alpha = SPACE_CLOCK_RAD + i * SPACE_PITCH_RAD
217:   let c = (alpha - MESH_AZ_RAD) / -WORK_RATE
218:   c -= Math.floor(c / WORK_REV_M) * WORK_REV_M
219:   CROSSING_M.push(c)
220:   CROSSING_FIRST_CUTS.push(strokePhaseAt(c) < 0.5)
221: }
222: 
223: /** Counted cutting engagements of space i by machining time m (closed form; see above). */
224: export function countedPasses(m: number, space: number): number {
225:   const c = CROSSING_M[space]
226:   if (m < c) return 0
227:   const crossings = Math.floor((m - c) / WORK_REV_M) + 1
228:   return CROSSING_FIRST_CUTS[space] ? Math.ceil(crossings / 2) : Math.floor(crossings / 2)
229: }
230: 
231: // ---- hob ---------------------------------------------------------------------------------
232: 
233: const T_HOB_INFEED_END = 25.7
234: const T_HOB_FEED_END = 30.2
235: const T_HOB_RETRACT_END = 31
236: const T_HOB_WITHDRAW_END = 31.8
237: const HOB_WITHDRAW_YC_MM = -8
238: const HOB_REV_RATE = 0.5
239: const HOB_FLUTES = 10
240: const HOB_FEED_SPAN_MM = HOB_STOP_YC_MM - HOB_INFEED_YC_MM
241: 
242: /** Hob centre y (mm) along the certified path: infeed yc, feed +Y, hold, withdraw below the face. */
243: export function hobYcAt(t: number): number {
244:   if (t < T_HOB_INFEED_END) return HOB_INFEED_YC_MM
245:   if (t < T_HOB_FEED_END) return HOB_INFEED_YC_MM + HOB_FEED_SPAN_MM * ease((t - T_HOB_INFEED_END) / (T_HOB_FEED_END - T_HOB_INFEED_END))
246:   if (t < T_HOB_RETRACT_END) return HOB_STOP_YC_MM
247:   if (t < T_HOB_WITHDRAW_END) return HOB_STOP_YC_MM + (HOB_WITHDRAW_YC_MM - HOB_STOP_YC_MM) * ease((t - T_HOB_RETRACT_END) / (T_HOB_WITHDRAW_END - T_HOB_RETRACT_END))
248:   return HOB_WITHDRAW_YC_MM
249: }
250: 
251: /** Radial offset from full depth (mm): 2.5 out before infeed and after retract. */
252: export function hobRadialOffsetAt(t: number): number {
253:   if (t < T_HOB_INFEED_END) return HOB_RETRACT_MM * (1 - ease((t - 25) / (T_HOB_INFEED_END - 25)))
254:   if (t < T_HOB_FEED_END) return 0
255:   if (t < T_HOB_RETRACT_END) return HOB_RETRACT_MM * ease((t - T_HOB_FEED_END) / (T_HOB_RETRACT_END - T_HOB_FEED_END))
256:   return HOB_RETRACT_MM
257: }
258: 
259: /** Hob rotation rate (rev/s at the master playhead), eased up 25.2..26 and down 31..31.8. */
260: export function hobRevRateAt(t: number): number {
261:   if (t <= 25.2 || t >= 31.8) return 0
262:   if (t < 26) return HOB_REV_RATE * ease((t - 25.2) / 0.8)
263:   if (t < 31) return HOB_REV_RATE
264:   return HOB_REV_RATE * (1 - ease((t - 31) / 0.8))
265: }
266: 
267: export function hobPhiAt(t: number): number {
268:   // Closed form: integral of hobRevRateAt with the same smoothstep segments.
269:   let revs = 0
270:   if (t > 25.2) {
271:     if (t < 26) revs = HOB_REV_RATE * 0.8 * easeIntegral((t - 25.2) / 0.8)
272:     else {
273:       revs = HOB_REV_RATE * 0.8 * 0.5
274:       if (t < 31) revs += HOB_REV_RATE * (t - 26)
275:       else {
276:         revs += HOB_REV_RATE * 5
277:         if (t < 31.8) {
278:           const u = (t - 31) / 0.8
279:           revs += HOB_REV_RATE * 0.8 * (u - easeIntegral(u))
280:         }
281:         else revs += HOB_REV_RATE * 0.8 * 0.5
282:       }
283:     }
284:   }
285:   return 2 * Math.PI * revs
286: }
287: 
288: // ---- frame-follow azimuth ----------------------------------------------------------------
289: 
290: /**
291:  * Frame-follow azimuth psi(t) = FOLLOW_GAIN * mf(t), mf = integral of followWeight * rate.
292:  * Follow weight: 1 on [2,6] (quarter orbit: psi spans -pi/2 in magnitude terms below),
293:  * eased to 0 by 7.2 (before the cutter edge reaches the face end), re-engaged 11..12 for
294:  * the recap, frozen after 15 s because the rate is zero there.
295:  */
296: export const FOLLOW_GAIN = Math.PI / 8
297: 
298: export function followWeightAt(t: number): number {
299:   if (t < T_SHAPING_START) return 0
300:   if (t < T_EASE_DOWN) return 1
301:   if (t < T_SLOW_START) return 1 - ease((t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN))
302:   if (t < T_EASE_UP_END) return 0
303:   if (t < 12) return ease((t - T_EASE_UP_END) / 1)
304:   if (t < T_SHAPING_END) return 1
305:   return 0
306: }
307: 
308: const ease2Integral = (u: number) => (9 / 5) * u ** 5 - 2 * u ** 6 + (4 / 7) * u ** 7
309: const MF_AT_SLOW_START = 4 + 1.2 * (1 - 1.78 * 0.5 + 0.78 * (9 / 5 - 2 + 4 / 7))
310: const MF_AT_RECAP_START = MF_AT_SLOW_START
311: const MF_AT_12 = MF_AT_SLOW_START + 4 * 0.5
312: const MF_AT_RECAP_END = MF_AT_12 + 8
313: export const FOLLOW_MF_TOTAL = MF_AT_RECAP_END + 4 * 0.5
314: 
315: export function followMfAt(t: number): number {
316:   if (t < T_SHAPING_START) return 0
317:   if (t < T_EASE_DOWN) return t - T_SHAPING_START
318:   if (t < T_SLOW_START) {
319:     const u = (t - T_EASE_DOWN) / (T_SLOW_START - T_EASE_DOWN)
320:     // integral of (1 - S(u)) * (1 - 0.78 S(u)) over the shared ease window
321:     return 4 + 1.2 * (u - 1.78 * easeIntegral(u) + 0.78 * ease2Integral(u))
322:   }
323:   if (t < T_EASE_UP_END) return MF_AT_SLOW_START
324:   if (t < 12) return MF_AT_RECAP_START + 4 * easeIntegral(t - T_EASE_UP_END)
325:   if (t < T_RECAP_END) return MF_AT_12 + 4 * (t - 12)
326:   if (t < T_SHAPING_END) return MF_AT_RECAP_END + 4 * ((t - T_RECAP_END) - easeIntegral(t - T_RECAP_END))
327:   return FOLLOW_MF_TOTAL
328: }
