407:     hobRevRate: 0,
408:     hobYc: HOB_INFEED_YC_MM,
409:     hobA: HOB_VISUAL_A_MM + HOB_RETRACT_MM,
410:     hobToolA: HOB_CENTRE_DISTANCE_AT_DEPTH_MM + HOB_RETRACT_MM,
411:     hobR: HOB_VISUAL_R_MM,
412:     strokeHz: 0,
413:     gashHz: 0,
414:     softened: false,
415:   }
416: }
