22: /** Layouts pinned by the leaf spec and the blockout layout rects. */
23: const DESKTOP_ASPECT = 1440 / 900
24: const NARROW_ASPECT = 390 / 844
25: const SAFE = 0.84 // 8% safe frame on each side, in NDC
26: /** Shaft axis y spans (mm) framed per story era; blockout accepts cropping noncritical geometry. */
27: const MM = 1e-3
28: const TIP_R = 6.0835
29: 
30: function axisPoints(y0: number, y1: number): Vector3[] {
31:   const points = [new Vector3(0, y0 * MM, 0), new Vector3(0, y1 * MM, 0), new Vector3(0, ((y0 + y1) / 2) * MM, 0)]
32:   const ym = (y0 + y1) / 2
33:   points.push(new Vector3(0, ym * MM, TIP_R * MM), new Vector3(0, ym * MM, -TIP_R * MM))
34:   return points
35: }
36: 
37: /** Cutter exit region (mm): face end, relief groove floor/wall, exit overtravel corner, chip origin. */
38: function exitRegionPoints(): Vector3[] {
39:   return [
40:     new Vector3(0, 9.875 * MM, TIP_R * MM),
41:     new Vector3(0, 10.41 * MM, 3.97 * MM),
42:     new Vector3(0, 10.94 * MM, TIP_R * MM),
43:     new Vector3(0, 10.3749 * MM, 4.2968 * MM),
44:     new Vector3(0, kinematics.edgeY * MM, kinematics.cutterRho * MM),
45:   ]
46: }
47: 
48: /** Revised-section envelope (mm): approved journal r 6.325 sampled over y 9..20. */
49: const JOURNAL_R_MM = 6.325
50: function revisedSectionPoints(): Vector3[] {
51:   const points: Vector3[] = []
52:   for (let y = 9; y <= 20.0001; y += 0.5) {
53:     for (let k = 0; k < 8; k++) {
54:       const a = (k * Math.PI) / 4
55:       points.push(new Vector3(JOURNAL_R_MM * Math.cos(a) * MM, y * MM, JOURNAL_R_MM * Math.sin(a) * MM))
56:     }
57:   }
58:   return points
59: }
60: 
61: function project(sample: ReturnType<typeof sampleAt>, aspect: number, points: Vector3[]): Vector3[] {
62:   const camera = new PerspectiveCamera(sample.fov, aspect, 0.01, 1)
63:   camera.position.set(sample.px, sample.py, sample.pz)
64:   camera.up.set(sample.ux, sample.uy, sample.uz)
65:   camera.lookAt(sample.tx, sample.ty, sample.tz)
66:   camera.updateMatrixWorld(true)
67:   return points.map((p) => p.clone().project(camera))
68: }
