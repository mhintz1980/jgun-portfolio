54: describe('K1 machining-time map m(t)', () => {
55:   it('is monotonic and C1 across a dense 1/240 sweep', () => {
56:     const step = 1 / 240
57:     let prevM = machiningTimeAt(0)
58:     let maxJump = 0
59:     let maxSecondDiff = 0
60:     for (let t = step; t <= SHAFT_KINEMATICS_DURATION + step; t += step) {
61:       const m = machiningTimeAt(t)
62:       expect(m).toBeGreaterThanOrEqual(prevM - 1e-12)
63:       const d1 = m - prevM
64:       const rate = machiningRateAt(t - step / 2)
65:       maxSecondDiff = Math.max(maxSecondDiff, Math.abs(d1 - rate * step))
66:       maxJump = Math.max(maxJump, d1)
67:       prevM = m
68:     }
69:     expect(maxJump).toBeLessThanOrEqual(4 * step + 1e-12)
70:     // Rate is C0: the forward difference matches dm/dt to O(h^2).
71:     expect(maxSecondDiff).toBeLessThan(2e-4)
72:   })
73:   it('holds the authored speed structure: normal, slow, compressed recap, frozen gaps', () => {
74:     expect(machiningTimeAt(2)).toBe(0)
75:     // Eased startup 2..3 s (rate 0 -> 1, C1 at both ends): half a machining second is banked.
76:     expect(machiningTimeAt(3)).toBeCloseTo(0.5, 12)
77:     expect(machiningTimeAt(6)).toBeCloseTo(3.5, 12)
78:     expect(machiningRateAt(2)).toBe(0)
79:     expect(machiningRateAt(3)).toBe(1)
80:     expect(machiningRateAt(5)).toBe(1)
81:     expect(machiningRateAt(8.4)).toBeCloseTo(0.22, 12)
82:     expect(machiningRateAt(12)).toBe(4)
83:     // Stable slow action inside 6..11: the whole 7.2..9.6 window runs at the slow rate.
84:     for (let t = 7.2; t <= 9.6; t += 1 / 240) expect(machiningRateAt(t)).toBeCloseTo(0.22, 10)
85:     expect(9.6 - 7.2).toBeGreaterThanOrEqual(1.2)
86:     // Machining freezes outside its beats.
87:     expect(machiningTimeAt(20)).toBe(MACHINING_AT_SHAPING_END)
88:     expect(machiningTimeAt(24.6)).toBe(MACHINING_AT_SHAPING_END)
89:   })
90:   it('is C1 at every rate-segment boundary (one-sided straddling finite differences)', () => {
91:     // Catches the Sol review's 2.0 s kink: with a 0 -> 1 rate step there, the offset
92:     // one-sided derivatives differ by ~1.0 and the straddling central difference misses
93:     // dm/dt by ~0.5. Intervals sit a half-step off each side (never aligned to the boundary)
94:     // plus one interval straddling it. Tolerance 0.02; observed worst case 5.6e-3 at h = 1/48.
95:     expect(MACHINING_RATE_BOUNDARIES).toContain(2)
96:     for (const boundary of MACHINING_RATE_BOUNDARIES) {
97:       for (const h of [1 / 48, 1 / 96, 1 / 161]) {
98:         const left = (machiningTimeAt(boundary - 0.5 * h) - machiningTimeAt(boundary - 1.5 * h)) / h
99:         const right = (machiningTimeAt(boundary + 1.5 * h) - machiningTimeAt(boundary + 0.5 * h)) / h
100:         expect(Math.abs(right - left)).toBeLessThanOrEqual(0.02)
101:         const central = (machiningTimeAt(boundary + 0.5 * h) - machiningTimeAt(boundary - 0.5 * h)) / h
102:         expect(Math.abs(central - machiningRateAt(boundary))).toBeLessThanOrEqual(0.02)
103:       }
