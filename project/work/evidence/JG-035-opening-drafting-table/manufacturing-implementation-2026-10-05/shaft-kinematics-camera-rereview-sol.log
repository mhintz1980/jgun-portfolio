327:     for (let t = 0; t <= SHAFT_KINEMATICS_DURATION; t += 1 / 24) {
328:       const f = sample(t)
329:       expect(Number.isFinite(f.machining)).toBe(true)
330:       expect(Number.isFinite(f.followAzimuth)).toBe(true)
331:       expect(Number.isFinite(f.cutterPhi)).toBe(true)
332:       expect(Number.isFinite(f.hobYc)).toBe(true)
333:       expect(Number.isFinite(f.chipX)).toBe(true)
334:       expect(Number.isFinite(f.strokeHz)).toBe(true)
335:       for (let i = 0; i < SHAFT_SPACES; i++) expect(Number.isFinite(f.spaceDepth[i])).toBe(true)
