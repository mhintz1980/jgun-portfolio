// ================= camera =================
const DESKTOP = 1440 / 900, NARROW = 390 / 844, SAFE = 0.84
const TIP_R = 6.0835
function axisPoints(y0, y1) {
  const pts = [new Vector3(0, y0 * MM, 0), new Vector3(0, y1 * MM, 0), new Vector3(0, ((y0 + y1) / 2) * MM, 0)]
  const ym = (y0 + y1) / 2
  pts.push(new Vector3(0, ym * MM, TIP_R * MM), new Vector3(0, ym * MM, -TIP_R * MM))
  return pts
}
function revisedSectionPoints() {
  const pts = [], r = 6.325
  for (let y = 9; y <= 20.0001; y += 0.5) for (let k = 0; k < 8; k++) { const a = k * Math.PI / 4; pts.push(new Vector3(r * Math.cos(a) * MM, y * MM, r * Math.sin(a) * MM)) }
  return pts
}
function exitRegionPoints(t) {
  const m = t < 15 ? machiningTimeAt(t) : M_END
  const edgeY = strokeCentreYAt(m) + 0.6
  const rho = infeedRhoAt(m) + backoffAt(m)
  return [new Vector3(0, 9.875 * MM, TIP_R * MM), new Vector3(0, 10.41 * MM, 3.97 * MM), new Vector3(0, 10.94 * MM, TIP_R * MM), new Vector3(0, 10.3749 * MM, 4.2968 * MM), new Vector3(0, edgeY * MM, rho * MM)]
}
function makeSampler(ANCHORS, upStart, upEnd) {
  return (time, aspect) => {
    const t = clamp(time, 0, 43)
    let i = 0
    while (i < ANCHORS.length - 2 && t >= ANCHORS[i + 1].t) i++
    const a = ANCHORS[i], b = ANCHORS[i + 1]
    const u = ease((t - a.t) / (b.t - a.t))
    const layout = clamp01((aspect - 0.62) / 0.4)
    const ta = a.tgtN ?? a.tgt, tb = b.tgtN ?? b.tgt
    const txMM = lerp(lerp(ta[0], a.tgt[0], layout), lerp(tb[0], b.tgt[0], layout), u)
    const tyMM = lerp(lerp(ta[1], a.tgt[1], layout), lerp(tb[1], b.tgt[1], layout), u)
    const tzMM = lerp(lerp(ta[2], a.tgt[2], layout), lerp(tb[2], b.tgt[2], layout), u)
    let hobFollow = 0
    if (t > 25.4 && t < 30.8) { const w = ease((t - 25.4) / 0.5) * (1 - ease((t - 30.2) / 0.6)); hobFollow = 0.35 * (hobYcAt(t) - 2.66495) * w }
    const az = lerp(a.az, b.az, u) * DEG + FOLLOW_GAIN * followMfAt(t)
    const el = lerp(a.el, b.el, u) * DEG
    const dist = lerp(a.dist, b.dist, u)
    const fov = lerp(lerp(a.fN, a.fD, layout), lerp(b.fN, b.fD, layout), u)
    const tx = txMM * MM, ty = (tyMM + hobFollow) * MM, tz = tzMM * MM
    const ce = Math.cos(el)
    const upY = t < upStart ? 1 : t >= upEnd ? 0 : 1 - ease((t - upStart) / (upEnd - upStart))
    const upAngle = upY * (Math.PI / 2)
    return { t, px: tx + dist * ce * Math.cos(az), py: ty + dist * Math.sin(el), pz: tz + dist * ce * Math.sin(az), tx, ty, tz, ux: 0, uy: Math.sin(upAngle), uz: Math.cos(upAngle), fov, followAzimuth: FOLLOW_GAIN * followMfAt(t) }
  }
}
function project(s, aspect, points) {
  const cam = new PerspectiveCamera(s.fov, aspect, 0.01, 1)
  cam.position.set(s.px, s.py, s.pz)
  cam.up.set(s.ux, s.uy, s.uz)
  cam.lookAt(s.tx, s.ty, s.tz)
  cam.updateMatrixWorld(true)
  return points.map((p) => p.clone().project(cam))
}

