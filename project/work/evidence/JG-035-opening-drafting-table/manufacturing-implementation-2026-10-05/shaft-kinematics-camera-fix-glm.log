  if (t < 30.2) return -4.195 + 13.7199 * ease((t - 25.7) / 4.5)
  if (t < 31) return 9.5249
  if (t < 31.8) return 9.5249 + (-17.5249) * ease((t - 31) / 0.8)
  return -8
}

