      c -= Math.floor(c / 2) * 2
      const list: number[] = []
      for (let k = 0; k < 16; k++) {
        const m = c + 2 * k
        if (strokePhaseAt(m) < 0.5) list.push(m)
      }
      crossings.push(list)
