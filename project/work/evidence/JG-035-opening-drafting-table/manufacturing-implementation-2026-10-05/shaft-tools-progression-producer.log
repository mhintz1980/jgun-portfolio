import fs from 'node:fs';
const p='project/work/evidence/JG-035-opening-drafting-table/manufacturing-implementation-2026-10-05/camera/profile-study.json';
const j=JSON.parse(fs.readFileSync(p,'utf8'));
const L=j.profiles.legacy['6.0'];
const step=360/L.length; const P=36;
let centerMins=[], centerTops=[];
for(let k=0;k<10;k++){ let bi=-1,bv=Infinity, ti=-1,tv=-Infinity;
  const start=Math.round(k*P/step);
  for(let o=0;o<Math.round(P/step);o++){ const i=(start+o)%L.length; const v=L[i];
    if(v<bv){bv=v;bi=i;} if(v>tv){tv=v;ti=i;} }
  centerMins.push(bi*step); centerTops.push(ti*step);
}
const mean=a=>{let s=0,c=0;for(const x of a){const r=x*Math.PI/180;s+=Math.sin(r);c+=Math.cos(r);}let m=Math.atan2(s,c)*180/Math.PI;if(m<0)m+=360;return m;};
// circular mean mod 36
const cm=a=>{let s=0,c=0;for(const x of a){const r=(x%36)*Math.PI/180;s+=Math.sin(r);c+=Math.cos(r);}let m=Math.atan2(s,c)*180/Math.PI;if(m<0)m+=360;return m;};
console.log('space min centers (deg):', centerMins.map(v=>v.toFixed(2)).join(' '));
console.log('tooth tip centers (deg):', centerTops.map(v=>v.toFixed(2)).join(' '));
console.log('mean space center mod36 deg:', cm(centerMins).toFixed(4), 'rad', (cm(centerMins)*Math.PI/180).toFixed(6));
console.log('mean tip center mod36 deg:', cm(centerTops).toFixed(4));
console.log('mean space centers circular (abs):', mean(centerMins).toFixed(4));

