const a = j.profiles.approved['6.0'];
const N=7200, step=360/N;
function minima(arr){
  const out=[];
  for(let i=0;i<N;i++){ const prev=arr[(i-1+N)%N], cur=arr[i], nxt=arr[(i+1)%N];
    if(cur<=prev && cur<nxt) out.push([i*step, cur]); }
  return out;
}
function maxima(arr){
  const out=[];
  for(let i=0;i<N;i++){ const prev=arr[(i-1+N)%N], cur=arr[i], nxt=arr[(i+1)%N];
    if(cur>=prev && cur>nxt) out.push([i*step, cur]); }
  return out;
}
