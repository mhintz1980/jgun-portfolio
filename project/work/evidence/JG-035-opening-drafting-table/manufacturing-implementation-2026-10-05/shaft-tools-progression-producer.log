    gl.shaderSource(sh, src); gl.compileShader(sh)
    const ok = gl.getShaderParameter(sh, gl.COMPILE_STATUS)
    return { ok, log: ok ? '"'' : gl.getShaderInfoLog(sh) || 'unknown' }
  }
  const program = (va: string, f: string) => {
    const p = gl.createProgram()"'!
    const a = gl.createShader(gl.VERTEX_SHADER)!; gl.shaderSource(a, va); gl.compileShader(a)
    const b = gl.createShader(gl.FRAGMENT_SHADER)!; gl.shaderSource(b, f); gl.compileShader(b)
    gl.attachShader(p, a); gl.attachShader(p, b); gl.linkProgram(p)
    return { linked: gl.getProgramParameter(p, gl.LINK_STATUS), log: gl.getProgramInfoLog(p) || '"'' }
  }
  const baseFragment = '#version 300 es\\nprecision highp float;\\nout vec4 fragColor;\\nvoid main(){ fragColor = vec4(0.0); }'
  return {
    context: gl.getParameter(gl.VERSION),
    vertexProgression: compile(gl.VERTEX_SHADER, va),
    vertexNormal: compile(gl.VERTEX_SHADER, vb),
    fragmentStress: compile(gl.FRAGMENT_SHADER, f),
    programProgression: program(va, baseFragment),
    programStress: program(vb, f),
  }
}, [vertexA, vertexB, fragment])
console.log(JSON.stringify(result, null, 1))
