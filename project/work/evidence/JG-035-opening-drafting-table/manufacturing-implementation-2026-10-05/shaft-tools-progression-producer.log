    gl.shaderSource(sh, src)
    gl.compileShader(sh)
    const ok = gl.getShaderParameter(sh, gl.COMPILE_STATUS)
    return { ok, log: ok ? '"'' : gl.getShaderInfoLog(sh) || 'unknown' }
  }
  return { version: gl.getParameter(gl.VERSION), vertexChunk: compile(gl.VERTEX_SHADER, va), normalChunk: compile(gl.VERTEX_SHADER, vb), fragmentStress: compile(gl.FRAGMENT_SHADER, f) }
}, [vertexA, vertexB, fragment])
